<div class="visit-grid">
  <div class="visit-copy">
    <p class="eyebrow">Visit the studio</p>
    <h2>{{ business.street }}<br><em>{{ business.city }}, {{ business.region }} {{ business.postalCode }}</em></h2>
    <dl class="visit-details">
      <div><dt>Hours</dt><dd>{{ hours.description or 'Call to confirm opening hours.' }}</dd></div>
      <div><dt>Phone</dt><dd><a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></dd></div>
      <div><dt>Before you come</dt><dd>Call to confirm your appointment and directions.</dd></div>
    </dl>
    <div class="button-row">
      <a class="button" href="{{ directions }}" target="_blank" rel="noopener noreferrer">Get directions</a>
      <a class="button outline" href="tel:{{ business.phone }}">Call the studio</a>
    </div>
  </div>
  <div class="map-panel" data-map="{{ mapEmbed }}">
    <span class="map-pin" aria-hidden="true"></span>
    <p class="map-label">{{ business.city }}, Maryland</p>
    <button class="button outline" type="button" data-load-map>Load interactive map</button>
    <p class="small">Loads Google Maps only when you choose.</p>
  </div>
</div>
