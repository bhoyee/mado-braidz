{# Social icons: simple single-colour line marks. #}
{% macro socialIcon(key) %}
{% if key == 'instagram' %}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" class="fill"/></svg>
{% elif key == 'tiktok' %}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.3 4.5 5 4.8"/></svg>
{% elif key == 'facebook' %}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M14 21v-7.5h2.6l.4-3H14V8.7c0-.9.3-1.5 1.6-1.5H17V4.5c-.3 0-1.2-.1-2.3-.1-2.3 0-3.7 1.4-3.7 3.9v2.2H8.5v3H11V21"/></svg>
{% elif key == 'google' %}<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 12.2c0-.6-.1-1.2-.2-1.7H12v3.3h4.5a4 4 0 0 1-1.7 2.5"/><path d="M14.8 16.3A5 5 0 0 1 7.3 13.6"/><path d="M7.3 10.4A5 5 0 0 1 15.3 8"/><circle cx="12" cy="12" r="8.5"/></svg>
{% endif %}
{% endmacro %}

{# Accepted payment methods as small badges. Card payments run through
   Stripe Checkout; Cash App, Zelle and cash are taken at the appointment. #}
{% macro payments() %}
<ul class="payment-badges" aria-label="Payment methods we accept">
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="Visa"><rect width="48" height="30" rx="5" fill="#fff"/><text x="24" y="20" text-anchor="middle" font-family="Arial, sans-serif" font-size="13" font-weight="900" font-style="italic" fill="#1a1f71">VISA</text></svg></li>
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="Mastercard"><rect width="48" height="30" rx="5" fill="#fff"/><circle cx="19.5" cy="15" r="8" fill="#eb001b"/><circle cx="28.5" cy="15" r="8" fill="#f79e1b"/><path d="M24 8.4a8 8 0 0 1 0 13.2 8 8 0 0 1 0-13.2Z" fill="#ff5f00"/></svg></li>
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="American Express"><rect width="48" height="30" rx="5" fill="#2e77bc"/><text x="24" y="19.5" text-anchor="middle" font-family="Arial, sans-serif" font-size="10.5" font-weight="900" fill="#fff" letter-spacing=".5">AMEX</text></svg></li>
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="Discover"><rect width="48" height="30" rx="5" fill="#fff"/><text x="22" y="17.6" text-anchor="end" font-family="Arial, sans-serif" font-size="7" font-weight="800" fill="#231f20">DISC</text><circle cx="25.6" cy="15.2" r="3.2" fill="#f58220"/><text x="29.2" y="17.6" font-family="Arial, sans-serif" font-size="7" font-weight="800" fill="#231f20">VER</text></svg></li>
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="Cash App"><rect width="48" height="30" rx="5" fill="#00d632"/><text x="24" y="21" text-anchor="middle" font-family="Arial, sans-serif" font-size="16" font-weight="900" fill="#fff">$</text></svg></li>
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="Zelle"><rect width="48" height="30" rx="5" fill="#6d1ed4"/><text x="24" y="19.5" text-anchor="middle" font-family="Arial, sans-serif" font-size="11" font-weight="800" fill="#fff">Zelle</text></svg></li>
  <li><svg viewBox="0 0 48 30" width="48" height="30" role="img" aria-label="Cash"><rect width="48" height="30" rx="5" fill="#e8f3e8"/><rect x="11" y="9" width="26" height="12" rx="2" fill="none" stroke="#2f7d4f" stroke-width="1.6"/><circle cx="24" cy="15" r="3" fill="none" stroke="#2f7d4f" stroke-width="1.6"/></svg></li>
</ul>
{% endmacro %}
