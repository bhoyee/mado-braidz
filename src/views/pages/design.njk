{% extends "layouts/base.njk" %}{% from "partials/components.njk" import card,menu %}{% block content %}<div class="wrap"><section class="page-head"><p class="eyebrow">Owner’s design library · Preview only</p><h1>The studio,<br><em>in every detail.</em></h1><p class="intro">Components for the public website and the future booking experience. All dates, totals and statuses below are examples; these controls never create a booking.</p></section><section class="design-section"><h2>Colour &amp; type.</h2><div class="swatches"><div class="swatch night">Night<br>#1C0F26</div><div class="swatch plum">Plum<br>#2E1640</div><div class="swatch violet">Violet<br>#7B3FC4</div><div class="swatch violet-deep">Violet deep<br>#5F2D9E</div><div class="swatch lilac">Lilac<br>#CDB6F2</div><div class="swatch mist">Mist<br>#F4EEFB</div><div class="swatch cream">Cream<br>#FBF7F2</div><div class="swatch linen">Linen<br>#F2EBE2</div><div class="swatch gold">Gold<br>#E0B26A</div><div class="swatch success">Success<br>#2F7D4F</div><div class="swatch danger">Danger<br>#B3261E</div></div><p class="intro">Figtree for reading and buttons. <span class="large-serif">Fraunces for headings and prices.</span></p><p class="demo-description">Violet leads: buttons, links, selected states. Gold is only for prices and hairlines on dark plum. Lilac is the accent text on dark sections. No gradients.</p><div class="button-row"><span class="badge">Confirmed</span><span class="badge danger">Cancelled</span></div></section>
<section class="design-section"><h2>Buttons &amp; choices.</h2><div class="button-row"><button type="button" class="button" data-open-dialog="demo-dialog">Open preview modal</button><button type="button" class="button outline" data-summary-toggle aria-controls="demo-summary" aria-expanded="false">Open summary</button><a href="#example-form" class="button ghost">Jump to form</a><button type="button" class="button" disabled>Unavailable</button></div><h3 class="mt-8 mb-4">Length selector</h3><div class="button-row" data-toggle-group role="group" aria-label="Example length selector">{% for name in ['Shoulder','Mid back','Waist','Top butt','Under butt'] %}<button type="button" class="chip" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ name }}</button>{% endfor %}</div><label class="addon-toggle mt-6"><input type="checkbox" name="example-addon"><span><strong>{{ addons[0].name }}</strong><br><span class="small">A little extra care · +{{ addons[0].priceCents | money }}</span></span></label></section>
<section class="design-section"><h2>The style &amp; price menu.</h2><div class="demo-grid"><div>{{ card(styles[0]) }}</div><div>{{ menu(styles[0]) }}</div></div></section>
<section class="design-section"><h2>A date with your chair.</h2><p class="demo-description">An example month and example slots. Availability is implemented in Milestone 3.</p><div class="demo-grid"><div><table class="calendar"><caption>December 2026 · Example</caption><thead><tr>{% for day in ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] %}<th scope="col">{{ day }}</th>{% endfor %}</tr></thead><tbody data-toggle-group>{% for row in [0,1,2,3,4] %}<tr>{% for col in [0,1,2,3,4,5,6] %}{% set day=row*7+col-1 %}<td>{% if day>0 and day<32 %}<button type="button" aria-label="December {{ day }}, 2026, example" aria-pressed="{{ 'true' if day==8 else 'false' }}" {% if col==0 or col==1 %}disabled{% endif %}>{{ day }}</button>{% endif %}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div><div><h3 class="mb-6">Example start times</h3><div class="button-row" data-toggle-group role="group" aria-label="Example appointment times"><button type="button" class="slot" aria-pressed="true">8:00 AM – 12:00 PM</button><button type="button" class="slot" aria-pressed="false">12:30 PM – 4:30 PM</button><button type="button" class="slot" disabled>4:30 PM · Unavailable</button></div><aside class="summary-panel mt-8"><h3>Your example visit</h3><dl><div><dt>Style</dt><dd>{{ styles[0].name }}</dd></div><div><dt>Style price</dt><dd>{{ styles[0].from | money }}</dd></div><div><dt>Head wash</dt><dd>{{ addons[0].priceCents | money }}</dd></div><div class="total"><dt>Total</dt><dd>{{ (styles[0].from + addons[0].priceCents) | money }}</dd></div><div><dt>Deposit today</dt><dd>{{ booking.depositCents | money }}</dd></div><div><dt>At your visit</dt><dd>{{ (styles[0].from + addons[0].priceCents - booking.depositCents) | money }}</dd></div></dl><p class="small">Static example. No payment is collected.</p></aside></div></div></section>
<section class="design-section" id="example-form"><h2>Forms &amp; feedback.</h2><form class="prose" data-demo-form><label for="demo-name">Your name</label><input id="demo-name" name="name" autocomplete="name" placeholder="Full name"><label for="demo-email">Email</label><input id="demo-email" type="email" name="email" autocomplete="email" aria-invalid="true" aria-describedby="email-error" value="example"><p class="field-error" id="email-error">Enter a full email address, like name@example.com.</p><label for="demo-phone">Phone</label><input id="demo-phone" type="tel" name="phone" autocomplete="tel" placeholder="(555) 555-0123"><label for="demo-notes">Anything you’d like us to know?</label><textarea id="demo-notes" rows="3" placeholder="A note for your stylist"></textarea><button class="button" type="button" data-open-dialog="demo-dialog">Preview message</button></form><div class="toast" data-toast role="status"><p>Your example changes are ready to review.</p><button type="button" data-dismiss aria-label="Dismiss example message">×</button></div></section>
<section class="design-section"><h2>Tables &amp; empty states.</h2><div class="table-scroll" tabindex="0" role="region" aria-label="Example appointments table"><table class="admin-table"><caption>Example appointments — no client records</caption><thead><tr><th scope="col">Reference</th><th scope="col">Style</th><th scope="col">Status</th><th scope="col">Balance</th></tr></thead><tbody><tr><td>EXAMPLE-01</td><td>{{ styles[0].name }}</td><td><span class="badge">Confirmed</span></td><td>{{ (styles[0].from-booking.depositCents) | money }}</td></tr></tbody></table></div><div class="empty-editorial mt-8"><h3>A quiet moment.</h3><p>No appointments to show in this example. Confirmed bookings will appear here when booking opens.</p></div></section></div>
<dialog id="demo-dialog" aria-labelledby="demo-dialog-title" aria-describedby="demo-dialog-description"><h2 id="demo-dialog-title">A little preview.</h2><p id="demo-dialog-description">This is a design example. No appointment has been created and no information has been saved.</p><div class="button-row"><button type="button" class="button" data-close-dialog autofocus>Got it</button></div></dialog>
<aside id="demo-summary" class="summary-panel demo-summary" hidden aria-label="Example booking summary"><h3>Your example visit</h3><p>{{ styles[0].name }} · From {{ styles[0].from | money }}</p><p class="small">Static example — not an appointment.</p><button type="button" class="button outline mt-4" data-summary-close>Close summary</button></aside>{% endblock %}
