{% extends "layouts/base.njk" %}
{% from "legal/sections.njk" import policies, privacy, terms with context %}
{% block content %}
{% if legalPage == 'policies' %}{% set heading = 'Appointment policies' %}{% set intro = 'What to know about your deposit, making changes and preparing for your visit.' %}
{% set contents = [['booking','Booking and confirmation'],['deposit','Deposit'],['happy','If you are not happy'],['payment','Payment and balance'],['changes','Rescheduling'],['cancellations','Cancellations and no-shows'],['late','Arriving late'],['guests','Children, guests and pets'],['preparation','Preparing your hair'],['hair','Hair and extras'],['studio','If we need to make a change']] %}
{% if policy.text %}{% set contents = contents.concat([['more','More from the studio']]) %}{% endif %}
{% elif legalPage == 'privacy' %}{% set heading = 'Privacy policy' %}{% set intro = 'The information we collect, why we need it and the choices you have.' %}
{% set contents = [['collect','Information we collect'],['use','How we use it'],['share','Who we share it with'],['payments','Payment information'],['cookies','Cookies and browser storage'],['marketing','Marketing emails'],['keep','Keeping information'],['choices','Your choices'],['updates','Updates to this policy']] %}
{% else %}{% set heading = 'Terms of service' %}{% set intro = 'The terms that apply when you use this website and book an appointment.' %}
{% set contents = [['agreement','Using this website'],['services','Services and prices'],['appointments','Appointments'],['payments','Payments'],['changes','Changes and cancellations'],['responsibilities','Your responsibilities'],['content','Website content'],['links','Other websites'],['updates','Updates to these terms']] %}{% endif %}
<section class="page-head legal-head">
  <div class="wrap">
    <h1>{{ heading }}</h1>
    <p class="intro">{{ intro }}</p>
    <p class="legal-updated">Last updated November 25, 2026</p>
  </div>
</section>
<div class="wrap section legal-layout">
  <nav class="legal-contents" aria-label="On this page">
    <h2>On this page</h2>
    <ul>{% for id, label in contents %}<li><a href="#{{ id }}">{{ label }}</a></li>{% endfor %}<li><a href="#contact">Contact us</a></li></ul>
  </nav>
  <article class="legal prose">
    {% if legalPage == 'policies' %}{{ policies() }}{% elif legalPage == 'privacy' %}{{ privacy() }}{% else %}{{ terms() }}{% endif %}
    <section id="contact" class="legal-contact">
      <h2>Contact us</h2>
      <p>If you have a question, call us or visit our <a href="/contact">contact page</a>.</p>
      <address>{{ business.name }}<br>{{ business.street }}<br>{{ business.city }}, {{ business.region }} {{ business.postalCode }}<br><a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></address>
      <p class="legal-related">{% if legalPage != 'policies' %}<a href="/policies">Appointment policies</a>{% endif %}{% if legalPage != 'privacy' %}<a href="/privacy">Privacy policy</a>{% endif %}{% if legalPage != 'terms' %}<a href="/terms">Terms of service</a>{% endif %}</p>
    </section>
  </article>
</div>
{% endblock %}
