{% extends "layouts/base.njk" %}{% from "partials/components.njk" import photo,menu %}{% block content %}<section class="wrap style-detail"><div><nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/styles">Styles</a><span aria-hidden="true">/</span><span>{{ style.name }}</span></nav><p class="eyebrow">{{ style.category }} · {{ style.durationMin / 60 }} hours</p><h1>{{ style.name }}</h1><p class="intro">{{ style.shortDesc or 'Made for your chosen length and your everyday life. Talk to Mado about the finish you have in mind.' }}</p><p class="style-price">{% if style.from %}From {{ style.from | money }}{% else %}Price on consultation{% endif %}</p><p>{{ booking.depositCents | money }} deposit, applied toward your total.</p><a href="/book?style={{ style.slug }}" class="button">Book this style <span aria-hidden="true">↗</span></a></div><figure class="detail-photo">{% if style.photo %}{{ photo(style.photo,style.name,true) }}{% else %}<img src="/media/braid-detail.webp" width="478" height="500" alt="A closer look at braiding technique in the studio" fetchpriority="high"><figcaption>Inside the studio / a look at the craft</figcaption>{% endif %}</figure></section><section class="wrap section">{{ menu(style) }}<div class="detail-notes"><div><h2>A little preparation.</h2><p>Bring your braiding hair and arrive washed and detangled, unless you’ve arranged a head wash. Call to confirm which hair and how much to bring.</p></div><div><h2>Time for the details.</h2><p>We reserve {{ style.durationMin / 60 }} hours for this style. Your size and length may change the time needed. Let’s discuss your look before the appointment.</p></div></div>{% if style.longHtml %}<div class="prose">{{ style.longHtml | safe }}</div>{% endif %}{% if style.photos.length > 1 %}<div class="gallery-grid">{% for item in style.photos %}{% if not loop.first %}<figure>{{ photo(item,item.alt) }}</figure>{% endif %}{% endfor %}</div>{% endif %}</section>{% include "partials/faq.njk" %}{% endblock %}
