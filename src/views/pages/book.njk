{% extends "layouts/base.njk" %}
{% block content %}
<section class="booking-intro"><div class="wrap"><h1>Book <em>your chair.</em></h1><p>Choose your style and time. <mark class="booking-hair-badge">50% human hair is included.</mark></p></div><div class="booking-policy-banner"><div class="wrap">Policy: A strict{% if not policy.depositRefundable %}, non-refundable{% endif %} deposit of {{ booking.depositCents | money }} USD is required upfront to secure and reserve your chair. The deposit is applied to your total.</div></div></section>
<div class="wrap booking-layout" data-booking-wizard>
  <noscript><p class="notice">Please enable JavaScript to check live availability, or <a href="tel:{{ business.phone }}">call the studio</a> to book.</p></noscript>
  <form id="booking-form" class="booking-form" novalidate data-csrf="{{ csrfToken }}" data-payments-enabled="{{ 'true' if paymentsEnabled else 'false' }}">
    <ol class="booking-progress" aria-label="Booking steps"><li aria-current="step">1 · Style</li><li>2 · Extras</li><li>3 · Time</li><li>4 · Details</li></ol>
    <p id="booking-error" class="field-error" role="alert" tabindex="-1" hidden></p>
    <section data-booking-step="1" aria-labelledby="booking-style-heading">
      <h2 id="booking-style-heading" tabindex="-1">Choose your look.</h2>
      <label for="booking-style">Style</label><select id="booking-style" name="styleId" required><option value="">Choose a style</option>{% for style in styles %}<option value="{{ style.id }}" data-slug="{{ style.slug }}" data-consultation="{{ 'true' if style.priceOnConsultation else 'false' }}">{{ style.name }}{% if style.priceOnConsultation %} · consultation{% endif %}</option>{% endfor %}</select>
      <div id="booking-variant-fields"><label for="booking-size">Braid size</label><select id="booking-size"><option value="">Choose a size</option></select>
      <label for="booking-variant">Length</label><select id="booking-variant" name="styleVariantId"><option value="">Choose a length</option>{% for style in styles %}{% for group in style.groups %}{% for variant in group.variants %}<option value="{{ variant.id }}" data-style="{{ style.id }}" data-size="{{ group.key }}" data-size-label="{{ group.name }}" data-length="{{ variant.length or '' }}">{{ variant.lengthLabel }} · {{ variant.priceCents | money }}</option>{% endfor %}{% endfor %}{% endfor %}</select></div>
      <p id="booking-consultation" class="notice" hidden>We will agree your final service price at consultation. Only the deposit option is available.</p>
      <button type="button" class="button" data-book-next>Choose extras</button>
    </section>
    <section data-booking-step="2" aria-labelledby="booking-extras-heading" hidden>
      <h2 id="booking-extras-heading" tabindex="-1">A little extra care.</h2><p>Your style price already includes hair with 50% human hair.</p>
      <fieldset><legend class="sr-only">Optional extras</legend>{% for addon in addons %}<label class="booking-addon"><input type="checkbox" name="addonIds" value="{{ addon.id }}" data-addon-all="{{ addon.appliesToAll }}" data-addon-styles="{{ (addon.styleIds or []) | join(',') }}"><span><strong>{{ addon.name }}</strong><br>{{ addon.priceCents | money }} extra{% if addon.description %} · {{ addon.description }}{% endif %}</span></label>{% endfor %}</fieldset>
      <div class="button-row"><button type="button" class="button outline" data-book-back>Back</button><button type="button" class="button" data-book-next>Find a time</button></div>
    </section>
    <section data-booking-step="3" aria-labelledby="booking-time-heading" hidden>
      <h2 id="booking-time-heading" tabindex="-1">Find your time.</h2><p>All times are Eastern. Starts are every 30 minutes.</p>
      <div class="booking-month-nav"><button type="button" class="button outline" data-month-prev aria-label="Previous month">←</button><h3 id="booking-month-title"></h3><button type="button" class="button outline" data-month-next aria-label="Next month">→</button></div>
      <div id="booking-calendar" aria-labelledby="booking-month-title"></div>
      <p id="booking-time-status" role="status"></p><div id="booking-slots" class="booking-slots" role="group" aria-label="Appointment start times"></div>
      <div class="button-row"><button type="button" class="button outline" data-book-back>Back</button><button type="button" class="button" data-book-next>Your details</button></div>
    </section>
    <section data-booking-step="4" aria-labelledby="booking-details-heading" hidden>
      <h2 id="booking-details-heading" tabindex="-1">A few details.</h2>
      <label for="booking-name">Full name</label><input id="booking-name" name="name" autocomplete="name" required minlength="2" maxlength="120">
      <label for="booking-email">Email</label><input id="booking-email" name="email" type="email" autocomplete="email" required maxlength="255">
      <label for="booking-phone">Phone</label><input id="booking-phone" name="phone" type="tel" autocomplete="tel" required placeholder="(443) 743-4979" aria-describedby="booking-phone-hint"><p class="small" id="booking-phone-hint">US numbers only.</p>
      <label for="booking-notes">Anything you would like us to know? (optional)</label><textarea id="booking-notes" name="notes" rows="3" maxlength="2000"></textarea>
      <label for="booking-inspiration">Inspiration photo (optional)</label><input id="booking-inspiration" name="inspiration" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="booking-image-hint"><p class="small" id="booking-image-hint">JPEG, PNG or WebP, up to 8 MB. Stored privately for your appointment.</p>
      <div class="booking-honeypot" aria-hidden="true"><label for="booking-website">Leave this field empty</label><input id="booking-website" name="website" tabindex="-1" autocomplete="off"></div>
      <fieldset class="booking-payment-options"><legend>{% if paymentsEnabled %}Choose your payment{% else %}Payment preference{% endif %}</legend><label class="booking-check"><input type="radio" name="paymentChoice" value="deposit" checked>Pay the deposit</label><label class="booking-check"><input type="radio" name="paymentChoice" value="full" id="booking-full">Pay in full</label></fieldset>
      {% if manualMethods.length %}<fieldset class="booking-payment-options"><legend>How would you like to pay?</legend><label class="booking-check"><input type="radio" name="paymentMethod" value="card" checked>Card · Stripe Checkout</label>{% for method in manualMethods %}<label class="booking-check"><input type="radio" name="paymentMethod" value="{{ method.id }}">{{ method.name }} · Upload payment proof</label>{% endfor %}</fieldset>
      <div id="booking-manual-payment" class="manual-review-notice" hidden><p>Recipient: <strong>{{ paymentName }}</strong></p>{% for method in manualMethods %}<p data-manual-recipient="{{ method.id }}" hidden>{{ method.name }}: <strong>{{ method.recipient }}</strong></p>{% endfor %}<p>Amount to send: <strong id="booking-manual-amount"></strong></p><p>Send the selected payment amount, then upload your screenshot. The owner must verify receipt before confirming your appointment.</p><label for="booking-payment-proof">Payment screenshot</label><input id="booking-payment-proof" type="file" accept="image/jpeg,image/png,image/webp"><p class="small">JPEG, PNG or WebP, up to 8 MB.</p></div>{% endif %}
      <label class="booking-check"><input type="checkbox" id="booking-policy" required><span>I accept the <a href="/policies" target="_blank" rel="noopener">appointment policies</a>, including the deposit policy and {{ policy.rescheduleHours }}-hour rescheduling notice.</span></label>
      <label class="booking-check"><input type="checkbox" id="booking-marketing"><span>Email me salon news and offers (optional).</span></label>
      {% if turnstileSiteKey %}<div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}" data-action="booking" data-size="flexible"></div>{% endif %}
      <div class="button-row"><button type="button" class="button outline" data-book-back>Back</button><button type="submit" class="button" id="booking-submit">{% if paymentsEnabled %}Continue to secure payment{% else %}Hold this time for 30 minutes{% endif %}</button></div><p class="booking-payment-note">{% if paymentsEnabled %}Your {{ booking.depositCents | money }} deposit is applied to your total. Your chair is confirmed after successful payment.{% else %}No payment is taken. Your appointment is not confirmed until payment is completed.{% endif %}</p>
    </section>
    <section id="booking-result" role="status" hidden><h2>Your time is temporarily held.</h2><p id="booking-result-message"></p><p id="booking-reference"></p><p id="booking-expiry"></p><a class="button" href="tel:{{ business.phone }}">Call {{ phoneDisplay }}</a></section>
  </form>
  <aside class="summary-panel booking-summary" aria-label="Your appointment summary"><button type="button" id="booking-summary-toggle" class="booking-summary-toggle" aria-expanded="false" aria-controls="booking-summary-content">View your visit summary <span id="summary-toggle-total"></span></button><div id="booking-summary-content"><p class="eyebrow">Your visit</p><h2 id="summary-style">Choose your style</h2><p id="summary-time">Choose a date and time</p><dl><div><dt>Style</dt><dd id="summary-price">—</dd></div><div><dt>Extras</dt><dd id="summary-extras">—</dd></div><div class="total"><dt>Total</dt><dd id="summary-total">—</dd></div><div class="summary-payment-row"><dt id="summary-payment-label">Deposit payment</dt><dd id="summary-today">—</dd></div><div class="summary-payment-row"><dt id="summary-balance-label">Balance after deposit</dt><dd id="summary-balance">—</dd></div></dl><p class="small booking-summary-note">50% human hair included. All prices in USD. {% if paymentsEnabled %}Pay securely through Stripe.{% else %}No payment is collected at this stage.{% endif %}</p></div></aside>
</div>
<script defer src="/build/booking.js"></script>
{% if turnstileSiteKey %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}
{% endblock %}
