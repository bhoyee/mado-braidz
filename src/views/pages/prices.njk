{% extends "layouts/base.njk" %}{% from "partials/components.njk" import menu %}{% block content %}<section class="wrap page-head"><p class="eyebrow">The full price menu</p><h1>The price<br><em>list.</em></h1><p class="intro">Choose your style, size and length. Your {{ booking.depositCents | money }} deposit is applied to the total. Hair with 50% human hair is included.</p></section><section class="wrap section price-page"><nav class="filter-bar" aria-label="Jump to a style">{% for style in styles %}<a class="chip" href="#{{ style.slug }}">{{ style.name }}</a>{% endfor %}</nav><aside class="price-note"><p><strong>A little extra care.</strong>{% for addon in addons %} {{ addon.name }} +{{ addon.priceCents | money }}.{% endfor %}</p><p>Consultation styles have a final price agreed with Mado. Please call before your visit.</p></aside>{% for style in styles %}{{ menu(style) }}{% else %}<div class="empty-editorial"><h2>Let’s talk about your look.</h2><p>Our price menu is being updated. Call {{ phoneDisplay }} for help planning your appointment.</p></div>{% endfor %}</section>{% endblock %}
