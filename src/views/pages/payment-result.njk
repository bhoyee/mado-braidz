{% extends "layouts/base.njk" %}
{% block content %}<section class="wrap section prose" data-payment-result data-session="{{ sessionId }}"><p class="eyebrow">Your appointment</p><h1 id="payment-heading">Confirming your booking…</h1><p id="payment-message" role="status">Please wait while we check your payment.</p><div id="payment-details" hidden><h2 id="payment-style"></h2><p id="payment-time"></p><p id="payment-reference"></p><p id="payment-totals"></p><a id="payment-manage" class="button" href="/">View your visit</a><a class="button outline" href="{{ directions }}" target="_blank" rel="noopener">Get directions</a><a id="payment-calendar" class="text-link" download="mado-appointment.ics">Add to calendar</a></div><p>Need help? <a href="tel:{{ business.phone }}">Call {{ phoneDisplay }}</a>.</p></section><script defer src="/build/payment.js"></script>{% endblock %}
