{% extends "layouts/base.njk" %}
{% block content %}
<section class="wrap appointment-result" data-payment-result data-session="{{ sessionId }}">
  <header class="appointment-result-heading">
    <p class="eyebrow">Your appointment</p>
    <h1 id="payment-heading">Confirming your booking…</h1>
    <p id="payment-message" role="status">Please wait while we check your payment.</p>
  </header>
  <div id="payment-details" class="appointment-receipt" hidden>
    <div class="appointment-visit">
      <div class="appointment-reference"><span>Booking reference</span><strong id="payment-reference"></strong></div>
      <p class="eyebrow">Your look</p>
      <h2 id="payment-style"></h2>
      <div class="appointment-date"><span class="appointment-detail-label">Date &amp; time</span><p id="payment-time"></p><span class="appointment-timezone">Eastern time · America/New_York</span></div>
    </div>
    <aside class="appointment-payment" aria-label="Your payment summary">
      <p class="eyebrow">Payment summary</p>
      <dl id="payment-totals"><div class="appointment-paid"><dt>Amount paid</dt><dd id="payment-paid"></dd></div><div class="appointment-balance"><dt>Remaining balance</dt><dd id="payment-balance"></dd></div></dl>
      <p class="appointment-payment-caption">All amounts in USD. Your payment is applied to your appointment total.</p>
      <div class="appointment-actions"><a id="payment-manage" class="button" href="/">View your visit</a><a id="payment-calendar" class="appointment-calendar" download="mado-appointment.ics">Add to calendar <span aria-hidden="true">↗</span></a></div>
    </aside>
    <div class="appointment-location"><span class="appointment-detail-label">Meet us at the studio</span><p>{{ business.street }}<br>{{ business.city }}, {{ business.region }} {{ business.postalCode }}</p><a class="text-link" href="{{ directions }}" target="_blank" rel="noopener">Get directions</a></div>
  </div>
  <p class="appointment-help">Need a hand with your visit? <a href="tel:{{ business.phone }}">Call {{ phoneDisplay }}</a></p>
</section>
<script defer src="/build/payment.js"></script>
{% endblock %}
