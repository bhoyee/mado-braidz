{% extends "layouts/base.njk" %}
{% block content %}<section class="wrap appointment-result"><header class="appointment-result-heading"><p class="eyebrow">Owner · Payments</p><h1>Review <em>transfers.</em></h1><p>Verify each transfer in your Zelle or Cash App account before approving. A screenshot alone does not prove receipt.</p></header>
{% for row in rows %}<article class="payment-review"><div class="appointment-reference"><span>Booking reference</span><strong>{{ row.booking.ref }}</strong></div><h2>{{ row.method | title }} · {{ row.amountCents | money }}</h2><p>{{ row.paymentType | title }} payment · booking {{ row.booking.status | replace('_',' ') }}</p><a class="text-link" href="/admin/payment-reviews/{{ row.id }}/image" target="_blank" rel="noopener">View private payment proof</a><form action="/admin/payment-reviews/{{ row.id }}" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label for="review-note-{{ row.id }}">Review note</label><textarea id="review-note-{{ row.id }}" name="note" maxlength="1000" rows="2"></textarea><div class="button-row"><button class="button" name="decision" value="approve">Approve verified receipt</button><button class="button outline" name="decision" value="reject">Reject proof</button></div></form></article>{% else %}<p class="notice">No payments awaiting review.</p>{% endfor %}</section>{% endblock %}
