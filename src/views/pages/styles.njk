{% extends "layouts/base.njk" %}{% from "partials/components.njk" import card %}{% block content %}<section class="wrap page-head"><p class="eyebrow">The collection</p><h1>Your hair.<br><em>Your kind of beautiful.</em></h1><p class="intro">From a shoulder-length bob to waist-length braids. Find the shape, texture and finish that feels like you.</p></section><section class="wrap section collection"><nav class="filter-bar" aria-label="Filter styles"><a href="/styles" class="chip" {% if not selected %}aria-current="page"{% endif %}>All styles</a>{% for category in categories %}<a class="chip" href="/styles?category={{ category.slug }}" {% if selected==category.slug %}aria-current="page"{% endif %}>{{ category.name }}</a>{% endfor %}</nav><p class="small result-count" role="status">{{ filtered.length }} styles to explore</p>{% if not filtered.length %}<div class="empty-editorial"><h2>A new collection is taking shape.</h2><p>Call the studio to talk about the style you have in mind.</p><a href="tel:{{ business.phone }}" class="button outline">Call {{ phoneDisplay }}</a></div>{% endif %}<div class="style-grid">{% for style in filtered %}{{ card(style) }}{% endfor %}</div></section>{% endblock %}
