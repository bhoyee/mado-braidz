{% extends "layouts/base.njk" %}
{% from "partials/components.njk" import card %}
{% block content %}
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">From {{ area.name }} to Lanham</p>
    <h1>A new look. <em>A little closer.</em></h1>
    <p class="intro">{{ area.copy }}</p>
    <div class="button-row"><a href="/styles" class="button">See styles &amp; prices</a><a href="/contact" class="button outline">Plan your visit</a></div>
  </div>
</section>
<section class="wrap section">
  <div class="section-head"><div><p class="eyebrow">Signature styles</p><h2>Start with <em>a style.</em></h2></div></div>
  <div class="style-grid">{% for style in styles %}{% if loop.index <= 3 %}{{ card(style) }}{% endif %}{% endfor %}</div>
</section>
{% endblock %}
