{% extends "layouts/base.njk" %}
{% block content %}
<section class="wrap appointment-result pay-page">
  <header class="appointment-result-heading"><p class="eyebrow">Payments</p><h1>Take care of <em>your balance.</em></h1><p>Find your appointment and make a secure payment.</p></header>
  <div class="pay-layout"><div class="pay-search">
    <form action="/pay/search" method="post"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label for="payment-search">Phone, email or booking confirmation code</label><input id="payment-search" name="query" value="{{ query }}" required maxlength="255" autocomplete="off" placeholder="MADO-… or your phone / email"><p class="small">Enter the phone number or email used for your booking, or your confirmation code.</p><button class="button" type="submit">Find my payment</button></form>
    {% if lookupMessage %}<p class="pay-lookup-message" role="status">{{ lookupMessage }}</p>{% endif %}
    {% for payment in found %}<article class="pay-found"><div class="appointment-reference"><span>Booking reference</span><strong>{{ payment.ref }}</strong></div><h2>{{ payment.styleName }}</h2><p>{{ payment.time }} Eastern</p><dl><dt>Payment due</dt><dd>{{ payment.amountCents | money }}</dd></dl><a class="button" href="{{ payment.url }}">Pay now</a></article>{% endfor %}
  </div><aside class="pay-alternatives"><p class="eyebrow">Other ways to pay</p><h2>Zelle &amp; Cash App</h2><p class="pay-recipient">Recipient: <strong>{{ paymentName }}</strong></p>{% for method in manualMethods %}<dl><dt>{{ method.name }}</dt><dd>{{ method.recipient }}</dd></dl>{% endfor %}{% if not manualMethods.length %}<p>Call the studio to confirm the payment details before sending money.</p>{% endif %}<p>Find your appointment first, then submit your payment screenshot from your visit page. Transfers need owner approval.</p><a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></aside></div>
</section>
{% endblock %}
