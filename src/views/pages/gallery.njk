{% extends "layouts/base.njk" %}
{% from "partials/components.njk" import photo, studioVideo with context %}
{% block content %}
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Our work</p>
    <h1>Fresh from <em>the chair.</em></h1>
    <p class="intro">Photos and short films from the studio. Hover or tap any piece to see the style; press play on a film to watch it.</p>
  </div>
</section>

<section class="wrap section">
  {# One portfolio: films (taller tiles) mixed in with photos. Labels sit on
     the picture and appear on hover; on touch screens they always show. #}
  <ul class="work-grid">
    {% for item in items %}
    {% if item.type == 'film' %}
    <li class="work-tile work-film">
      {{ studioVideo(item.name, item.description, false, item.src, item.poster) }}
      <div class="work-caption" aria-hidden="true"><span class="work-kind">Film</span><strong>{{ item.title }}</strong><span class="work-sub">{{ item.label }}</span></div>
    </li>
    {% elif item.href %}
    <li class="work-tile">
      <a href="{{ item.href }}" class="work-link">
        {{ photo(item.photo, item.label) }}
        <span class="work-caption"><span class="work-kind">Photo</span><strong>{{ item.label }}</strong><span class="work-sub">View style <span aria-hidden="true">→</span></span></span>
      </a>
    </li>
    {% else %}
    <li class="work-tile">
      {{ photo(item.photo, item.label) }}
      <div class="work-caption" aria-hidden="true"><span class="work-kind">Photo</span><strong>{{ item.label }}</strong></div>
    </li>
    {% endif %}
    {% endfor %}
  </ul>

  <div class="work-cta">
    <p>Love a look?</p>
    <a href="/styles" class="button">See styles &amp; prices</a>
  </div>
</section>
{% endblock %}
