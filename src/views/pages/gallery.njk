{% extends "layouts/base.njk" %}{% from "partials/components.njk" import photo %}{% block content %}<section class="wrap page-head"><p class="eyebrow">Fresh from the chair</p><h1>It’s all<br><em>in the details.</em></h1><p class="intro">A place for our studio’s work. Clean parts, individual finishes, and a style that is yours.</p></section><section class="wrap section">{% if gallery.length %}<div class="gallery-grid">{% for item in gallery %}<figure>{{ photo(item,item.alt) }}<figcaption>{{ item.alt }}</figcaption></figure>{% endfor %}</div>{% else %}<div class="empty-editorial"><img src="/img/braid-ring.svg" alt="" width="80" height="80"><h2>The next chapter is coming.</h2><p>Real photographs from the studio will appear here soon. Have a look in mind? Call Mado to talk it through.</p><a class="button outline" href="/styles">Explore the styles</a></div>{% endif %}</section>{% endblock %}
