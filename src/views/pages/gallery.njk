{% extends "layouts/base.njk" %}{% from "partials/components.njk" import photo,studioVideo %}
{% block content %}<section class="wrap page-head"><p class="eyebrow">Studio journal / Film &amp; detail</p><h1>The work.<br><em>In motion.</em></h1><p class="intro">A closer look at the craft, from the first part to the finished style. Filmed in the studio.</p></section>
<section class="wrap section"><div class="film-gallery"><figure>{{ studioVideo('finished-look','A finished braided style from several angles') }}<figcaption><span>01 / THE FINISHED LOOK</span><h2>That final turn.</h2><p>A fresh finish, seen from every side.</p></figcaption></figure><figure>{{ studioVideo('braid-detail','A close view of braided sections and textured lengths') }}<figcaption><span>02 / UP CLOSE</span><h2>Every part matters.</h2><p>A closer look at the sections and lengths.</p></figcaption></figure><figure>{{ studioVideo('at-the-chair','Hands finishing a client’s braids') }}<figcaption><span>03 / THE PROCESS</span><h2>Made by hand.</h2><p>A moment behind the chair.</p></figcaption></figure></div>{% if gallery.length %}<div class="gallery-grid section">{% for item in gallery %}<figure>{{ photo(item,item.alt) }}<figcaption>{{ item.alt }}</figcaption></figure>{% endfor %}</div>{% endif %}</section>{% endblock %}
