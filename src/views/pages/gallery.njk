{% extends "layouts/base.njk" %}{% from "partials/components.njk" import photo,studioVideo %}
{% block content %}<section class="wrap page-head"><p class="eyebrow">Studio journal / Film &amp; detail</p><h1>The<br><em>lookbook.</em></h1><p class="intro">A closer look at the craft, from the first part to the finished style. Filmed in the studio.</p></section>
<section class="wrap section"><div class="gallery-grid supplied-gallery">{% for style in suppliedStyles %}<figure><a href="/styles/{{ style.slug }}">{{ photo(style.photo,style.name) }}</a><figcaption class="photo-note">{{ style.name }}</figcaption></figure>{% endfor %}{% for item in gallery %}<figure>{{ photo(item,item.alt) }}<figcaption class="photo-note">{{ item.alt }}</figcaption></figure>{% endfor %}</div><h2 class="gallery-films-heading">Behind the chair.</h2><div class="film-gallery"><figure>{{ studioVideo('finished-look','A finished braided style from several angles') }}<figcaption><span>01 / THE FINISHED LOOK</span><h2>That final turn.</h2><p>A fresh finish, seen from every side.</p></figcaption></figure><figure>{{ studioVideo('braid-detail','A close view of braided sections and textured lengths') }}<figcaption><span>02 / UP CLOSE</span><h2>Every part matters.</h2><p>A closer look at the sections and lengths.</p></figcaption></figure><figure>{{ studioVideo('at-the-chair','Hands finishing a client’s braids') }}<figcaption><span>03 / THE PROCESS</span><h2>Made by hand.</h2><p>A moment behind the chair.</p></figcaption></figure></div></section>{% endblock %}
