{% extends "layouts/base.njk" %}
{% from "partials/components.njk" import studioVideo %}
{% block content %}
<section class="campaign">
 <div class="wrap campaign-grid">
  <div class="campaign-copy">
   <p class="eyebrow">African hair braiding / {{ business.city }}, {{ business.region }}</p>
   <h1>{{ pages.home.heading }}<br><em>{{ pages.home.accent }}</em></h1>
   <p class="campaign-intro">{{ pages.home.intro }}</p>
   <div class="button-row"><a class="button" href="/book">Book your chair <span aria-hidden="true">↗</span></a><a class="campaign-link" href="/styles">Find your style <span aria-hidden="true">→</span></a></div>
   <div class="campaign-bottom"><span class="editorial-index">01 / IN THE STUDIO</span><p>Real hair. Real hands.<br>See the finished look in motion.</p><a class="round-link" href="#the-edit" aria-label="Explore the style edit">↓</a></div>
  </div>
  <figure class="campaign-film">
   {{ studioVideo('finished-look','A finished braided style, shown from several angles',true) }}
   <figcaption><span>THE FINISHED LOOK</span><span>Filmed at the studio ↗</span></figcaption>
  </figure>
 </div>
</section>
<div class="studio-line"><div class="wrap"><span>BRAIDS. TWISTS. LOCS.</span><span>Made with care in {{ business.city }}, Maryland.</span><a href="/contact">Visit the studio <span aria-hidden="true">↗</span></a></div></div>
<section class="wrap section style-edit" id="the-edit">
 <div class="section-heading"><div><p class="eyebrow">The style edit</p><h2>Find your<br><em>next favourite.</em></h2></div><p>Keep it classic. Add a little texture.<br>Go a little longer. Make it yours.</p><a class="text-link" href="/styles">Explore every style <span aria-hidden="true">↗</span></a></div>
 <div class="edit-grid"><figure class="edit-image"><img src="/media/braid-detail.webp" alt="Close-up of neat braid sections and textured lengths from the supplied studio footage" width="478" height="500" loading="lazy"><figcaption>Up close / a look at the detail</figcaption></figure><div class="edit-list">{% for style in styles %}{% if loop.index <= 6 %}<a class="edit-row" href="/styles/{{ style.slug }}"><span class="edit-number">0{{ loop.index }}</span><span><span class="edit-name">{{ style.name }}</span><span class="edit-category">{{ style.category }}</span></span><span class="edit-price">{% if style.from %}from {{ style.from | money }}{% else %}Let’s consult{% endif %}</span><span class="edit-arrow" aria-hidden="true">↗</span></a>{% endif %}{% else %}<p>Our collection is being updated. Call Mado to plan your next style.</p>{% endfor %}</div></div>
</section>
<section class="studio-story"><div class="wrap story-grid"><div class="story-copy"><p class="eyebrow">Behind the chair</p><h2>It starts with<br><em>the details.</em></h2><p>{{ pages.about.intro }}</p><p>A conversation about your hair. A style chosen together. Time for every part and every finish.</p><a class="text-link" href="/about">Get to know the studio <span aria-hidden="true">↗</span></a></div><div class="story-film">{{ studioVideo('at-the-chair','Braiding and finishing a client’s hair at the studio') }}<p class="film-note">A moment in Mado’s chair.</p></div></div></section>
<section class="wrap section price-editorial"><div><p class="eyebrow">No guesswork</p><h2>Your look.<br>Your length.<br><em>Your price.</em></h2><p>Every size and length, clearly listed.<br>Your {{ booking.depositCents | money }} deposit goes toward the total.</p><a class="button outline" href="/prices">The full price menu <span aria-hidden="true">↗</span></a></div><div class="price-preview">{% for style in styles %}{% if loop.index <= 5 %}<a href="/styles/{{ style.slug }}"><span>{{ style.name }}</span><span>{% if style.from %}from {{ style.from | money }}{% else %}Consultation{% endif %}</span></a>{% endif %}{% endfor %}<div class="price-extra"><span>{% if addons[0] %}{{ addons[0].name }}{% else %}Ask about add-ons{% endif %}</span><strong>{% if addons[0] %}+{{ addons[0].priceCents | money }}{% endif %}</strong></div><p class="small">Bring your braiding hair. Call ahead to confirm the type and amount for your chosen look.</p></div></section>
<section class="studio-journal"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">The studio, unfiltered</p><h2>From the first part<br><em>to the final turn.</em></h2></div><a href="/gallery" class="text-link">Watch the studio films <span aria-hidden="true">↗</span></a></div><div class="journal-grid"><figure><img src="/media/braid-detail.webp" width="478" height="500" alt="Braided sections and textured lengths, up close" loading="lazy"><figcaption><span>01</span> The detail</figcaption></figure><figure><img src="/media/at-the-chair.webp" width="478" height="610" alt="Hands finishing braids at the salon chair" loading="lazy"><figcaption><span>02</span> The process</figcaption></figure><figure><img src="/media/finished-look.webp" width="464" height="640" alt="A client’s finished braided look" loading="lazy"><figcaption><span>03</span> The feeling</figcaption></figure></div></div></section>
<section class="wrap section">{% include "partials/visit.njk" %}</section>
{% include "partials/faq.njk" %}
{% endblock %}
