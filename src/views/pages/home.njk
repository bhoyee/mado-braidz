{% extends "layouts/base.njk" %}
{% from "partials/components.njk" import photo,card,studioVideo %}
{% block content %}
<section class="atelier-hero wrap">
 <div class="atelier-copy"><p class="eyebrow">African hair braiding · {{ business.city }}, {{ business.region }}</p><h1>{{ pages.home.heading }}</h1><p class="atelier-deck">Knotless braids, twists &amp; locs.<br>Thoughtfully braided. Completely you.</p><div class="atelier-actions"><a href="/book" class="button">Book your appointment <span aria-hidden="true">↗</span></a><a href="/styles" class="text-link">Explore the styles <span aria-hidden="true">→</span></a></div><div class="atelier-meta"><span>ONE STYLIST.<br>YOUR TIME.</span><p>{{ booking.depositCents | money }} deposit, applied to your total.<br>Find your style. We’ll take it from there.</p></div></div>
 <figure class="atelier-portrait atelier-hero-film">{{ studioVideo('finished-look','A finished braided style, shown from several angles',true) }}<figcaption><span>In the studio / the finished look</span><a href="/our-work">See our work <span aria-hidden="true">↗</span></a></figcaption></figure>
</section>
<div class="atelier-ribbon"><div class="wrap"><span>KNOTLESS</span><span aria-hidden="true">/</span><span>BOHO</span><span aria-hidden="true">/</span><span>TWISTS</span><span aria-hidden="true">/</span><span>LOCS</span><span aria-hidden="true">/</span><span>FULANI</span></div></div>
<section class="wrap atelier-collection section" id="the-edit"><div class="atelier-heading"><div><p class="eyebrow">01 / The lookbook</p><h2>A style for<br><em>every version of you.</em></h2></div><div><p>A little length. A little texture.<br>A look that feels entirely your own.</p><a href="/styles" class="text-link">View the full collection <span aria-hidden="true">↗</span></a></div></div><div class="atelier-style-grid">{% for style in styles %}{% if loop.index <= 6 %}{{ card(style) }}{% endif %}{% else %}<p>Call the studio to talk through the look you have in mind.</p>{% endfor %}</div><p class="atelier-image-note">AI-generated images are labelled as style references. They illustrate the hairstyle and are not client photographs.</p></section>
<section class="atelier-studio"><div class="wrap atelier-studio-grid"><div class="atelier-studio-film">{{ studioVideo('at-the-chair','Hands finishing a client’s braids at the studio') }}<p class="film-note">In Mado’s chair / filmed in the studio</p></div><div class="atelier-studio-copy"><p class="eyebrow">02 / The person behind the part</p><h2>{{ pages.about.heading }}</h2><p>{{ pages.about.intro }}</p><p>{{ pages.about.story }}</p><ul class="studio-values">{% for value in pages.about.values %}<li>{{ value }}</li>{% endfor %}</ul><a class="text-link" href="/about">Meet the studio <span aria-hidden="true">↗</span></a></div></div></section>

<section class="atelier-visual"><div class="wrap"><div class="atelier-heading"><div><p class="eyebrow">04 / In the details</p><h2>Turn heads.<br><em>Stay yourself.</em></h2></div><a class="text-link" href="/our-work">Explore our work <span aria-hidden="true">↗</span></a></div><div class="atelier-photo-strip">{% for style in suppliedStyles %}{% if loop.index<=3 %}<a href="/styles/{{ style.slug }}">{{ photo(style.photo,style.name) }}<span>{{ style.name }} <span aria-hidden="true">↗</span></span></a>{% endif %}{% endfor %}</div></div></section>
<section class="wrap section atelier-visit">{% include "partials/visit.njk" %}</section>
{% include "partials/faq.njk" %}
{% endblock %}
