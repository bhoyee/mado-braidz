{% extends "layouts/base.njk" %}{% from "partials/components.njk" import photo,card,menu %}
{% block content %}<section class="wrap hero"><div class="hero-copy"><p class="eyebrow">{{ pages.home.eyebrow }}</p><h1>{{ pages.home.heading }}<br><em>{{ pages.home.accent }}</em></h1><p class="intro">{{ pages.home.intro }}</p><div class="button-row"><a href="/book" class="button">Book your chair <span aria-hidden="true">↗</span></a><a href="/styles" class="button outline">See styles &amp; prices</a></div><dl class="hero-facts"><div><dt>{{ booking.depositCents | money }}</dt><dd>deposit, applied to your total</dd></div><div><dt>{{ booking.defaultDurationMin / 60 }} hrs</dt><dd>time set aside for you</dd></div><div><dt>{% if addons[0] %}+{{ addons[0].priceCents | money }}{% else %}Let’s talk{% endif %}</dt><dd>{% if addons[0] %}{{ addons[0].name | lower }}, if you’d like{% else %}about your look{% endif %}</dd></div></dl></div><figure class="hero-art"><div class="hero-photo">{{ photo(styles[0].photo,'Your next look',true) }}</div><figcaption>One stylist. Time for every detail.</figcaption><a href="/styles" class="braid-stamp"><img src="/img/braid-ring.svg" width="140" height="140" alt=""><span>Your next<br><em>chapter.</em></span></a></figure></section>
<section class="booking-strip"><div class="wrap booking-inner"><div><p class="eyebrow">Booking, start to finish</p><h2>A little planning.<br> A beautiful finish.</h2></div><ol><li><span>01</span><h3>Find your style</h3><p>Explore sizes and lengths. See your price before you book.</p></li><li><span>02</span><h3>Make some time</h3><p>Call the studio to arrange your appointment and hair preparation.</p></li><li><span>03</span><h3>Settle into your chair</h3><p>Your deposit goes toward your total. The rest is due at your appointment.</p></li></ol></div></section>
{% if styles.length %}<section class="signature section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">01 — The collection</p><h2>Find a look that feels like you.</h2></div><a class="text-link" href="/styles">All styles &amp; prices <span aria-hidden="true">→</span></a></div><div class="signature-grid">{% for style in styles %}{% if loop.index <= 6 %}{{ card(style,loop.first) }}{% endif %}{% endfor %}</div></div></section>
<section class="wrap section"><div class="section-heading"><div><p class="eyebrow">02 — The menu</p><h2>Prices, plainly.</h2><p>Bring your own braiding hair. Your deposit comes off the total.</p></div><img class="section-ring" src="/img/braid-ring.svg" width="80" height="80" alt="" loading="lazy"></div>{{ menu(styles[0]) }}<a href="/prices" class="text-link menu-all">Explore the complete price menu <span aria-hidden="true">→</span></a></section>
{% endif %}<section class="wrap section gallery-preview"><div class="section-heading"><div><p class="eyebrow">03 — Fresh from the chair</p><h2>The details make the style.</h2></div><a href="/gallery" class="text-link">Visit the gallery <span aria-hidden="true">→</span></a></div>{% if gallery.length %}<div class="gallery-grid">{% for item in gallery %}{% if loop.index <= 4 %}<figure>{{ photo(item,item.alt) }}</figure>{% endif %}{% endfor %}</div>{% else %}<div class="empty-editorial"><p class="large-serif">A space for our real work.</p><p>Studio photographs are coming soon. In the meantime, explore the styles and talk to Mado about the look you have in mind.</p><a href="/styles" class="text-link">Find your inspiration <span aria-hidden="true">→</span></a></div>{% endif %}</section>
<section class="about-band section"><div class="wrap about-grid"><div class="portrait-space">{{ photo(null,'Meet Mado') }}</div><div><p class="eyebrow">04 — Meet Mado</p><h2>{{ pages.about.heading }}</h2><p class="intro">{{ pages.about.intro }}</p><a class="text-link" href="/about">A little about the studio <span aria-hidden="true">→</span></a></div></div></section>
<section class="wrap section">{% include "partials/visit.njk" %}</section>{% include "partials/faq.njk" %}{% endblock %}
