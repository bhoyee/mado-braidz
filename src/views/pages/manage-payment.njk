{% extends "layouts/base.njk" %}
{% block content %}
{% from "partials/manual-payment.njk" import proofForm %}
<section class="wrap appointment-result visit-page">
  <header class="appointment-result-heading visit-heading"><div><p class="eyebrow">Your appointment</p><h1>Your <em>visit.</em></h1><p>All the details for your time in our chair.</p></div><span class="visit-status" data-status="{{ appointment.status }}">{% if pendingProof %}Payment awaiting review{% else %}{{ appointment.status | replace('_', ' ') }}{% endif %}</span></header>
  {% if pendingProof %}<p class="manual-review-notice" role="status">Payment proof received. The owner will verify your {{ pendingProof.method | title }} transfer. {% if initialPayment %}Your appointment is not confirmed yet.{% endif %} Please do not pay again.</p>{% endif %}
  <div class="appointment-receipt">
    <div class="appointment-visit">
      <div class="appointment-reference"><span>Booking reference</span><strong>{{ appointment.ref }}</strong></div>
      <p class="eyebrow">Your look</p><h2>{{ price.styleName }}</h2>
      {% if price.size or price.length %}<p class="visit-style-options">{% if price.size %}{{ price.size | replace('_', ' ') | title }}{% endif %}{% if price.size and price.length %} · {% endif %}{% if price.length %}{{ price.length | replace('_', ' ') | title }}{% endif %}</p>{% endif %}
      <div class="appointment-date"><span class="appointment-detail-label">Date &amp; time</span><p>{{ appointmentTime }} Eastern</p><span class="appointment-timezone">America/New_York</span></div>
      {% if price.addons.length %}<div class="visit-extras"><span class="appointment-detail-label">Your extras</span><ul>{% for addon in price.addons %}<li>{{ addon.name }} <span>{{ addon.priceCents | money }}</span></li>{% endfor %}</ul></div>{% endif %}
    </div>
    <aside class="appointment-payment" aria-label="Your payment summary">
      <p class="eyebrow">Payment summary</p>
      <dl><div class="appointment-paid"><dt>Amount paid</dt><dd>{{ appointment.paidCents | money }}</dd></div><div class="appointment-balance"><dt>Remaining balance</dt><dd>{% if price.consultation %}Agreed at consultation{% else %}{{ appointment.balanceCents | money }}{% endif %}</dd></div></dl>
      <p class="appointment-payment-caption">All amounts in USD. Your payment is applied to your appointment total.</p>
      {% if canPayBalance %}<form class="appointment-actions" data-balance-form data-ref="{{ appointment.ref }}" data-csrf="{{ csrfToken }}"><button type="submit" class="button">Pay {{ appointment.balanceCents | money }} balance securely</button><p class="visit-payment-hint">Secure checkout with Stripe.</p><p class="field-error" role="alert" hidden></p></form>{% elif appointment.paymentStatus == 'paid_in_full' %}<p class="visit-paid-note">Paid in full · No remaining balance</p>{% elif price.consultation %}<p class="visit-paid-note">Your final price will be agreed at consultation.</p>{% endif %}
    </aside>
    <div class="appointment-location"><span class="appointment-detail-label">Meet us at the studio</span><p>{{ business.street }}<br>{{ business.city }}, {{ business.region }} {{ business.postalCode }}</p><a class="text-link" href="{{ directions }}" target="_blank" rel="noopener">Get directions</a></div>
  </div>
{% if initialPayment and not pendingProof and paymentsEnabled %}<form class="visit-card-payment" data-initial-checkout data-ref="{{ appointment.ref }}" data-csrf="{{ csrfToken }}"><button class="button" type="submit">Pay {{ price.dueTodayCents | money }} securely by card</button><p class="field-error" role="alert" hidden></p></form>{% endif %}
{% if canSubmitProof and manualMethods.length %}<div>{{ proofForm(appointment.ref, csrfToken, manualMethods, paymentName, price.dueTodayCents if initialPayment else appointment.balanceCents) }}</div>{% endif %}
  {% if appointment.balanceCents > 0 %}<section class="owner-panel"><h2>Pay at the studio</h2><p>{% if balanceOptions.cash != false %}Cash{% endif %}{% if balanceOptions.terminal != false %}{% if balanceOptions.cash != false %} or {% endif %}card at the studio{% endif %}{% if balanceOptions.cash == false and balanceOptions.terminal == false %}Please use one of the online methods above or contact the studio.{% else %} accepted for your remaining balance.{% endif %}</p></section>{% endif %}<div class="visit-support"><div><h2>A change of plans?</h2><p>Call the studio for appointment changes. Please give at least {{ policy.rescheduleHours }} hours of notice for rescheduling.</p><a class="text-link" href="/policies">Appointment policies</a></div><a class="button outline" href="tel:{{ business.phone }}">Call {{ phoneDisplay }}</a></div>
</section>


<script defer src="/build/payment.js"></script>
{% endblock %}
