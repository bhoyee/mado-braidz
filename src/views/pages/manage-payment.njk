{% extends "layouts/base.njk" %}
{% block content %}<section class="wrap section prose"><p class="eyebrow">{{ appointment.ref }}</p><h1>Your <em>visit.</em></h1><h2>{{ price.styleName }}</h2><p>{{ appointmentTime }} Eastern</p><p>Status: {{ appointment.status | replace('_',' ') }}</p><dl><div><dt>Paid</dt><dd>{{ appointment.paidCents | money }}</dd></div><div><dt>Balance</dt><dd>{% if price.consultation %}Agreed at consultation{% else %}{{ appointment.balanceCents | money }}{% endif %}</dd></div></dl>{% if canPayBalance %}<form data-balance-form data-ref="{{ appointment.ref }}" data-csrf="{{ csrfToken }}"><button type="submit" class="button">Pay {{ appointment.balanceCents | money }} balance securely</button><p class="field-error" role="alert" hidden></p></form>{% endif %}<p>For appointment changes, call <a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a>.</p></section><script defer src="/build/payment.js"></script>{% endblock %}
