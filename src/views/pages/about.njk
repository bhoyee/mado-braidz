{% extends "layouts/base.njk" %}
{% from "partials/components.njk" import studioVideo, ring with context %}
{% block content %}
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Our story</p>
    <h1>{{ pages.about.heading }}</h1>
  </div>
</section>
<section class="wrap section about-grid">
  <figure class="about-film"><div class="arch-frame">{{ studioVideo('studio-tour','Inside the Lanham studio: the wood-slat wall with the Mado sign, arched mirrors and styling chairs') }}</div><figcaption>The Lanham studio</figcaption>{{ ring('MADO · AFRICAN BRAIDS · LANHAM MD · ', 'about') }}</figure>
  <div class="prose">
    <p class="lead">{{ pages.about.intro }}</p>
    <p>{{ pages.about.story }}</p>
    <ul class="values-grid">{% for value in pages.about.values %}<li>{{ value }}</li>{% endfor %}</ul>
    <p>You’ll find us at {{ business.street }} in {{ business.city }}, {{ business.region }}.</p>
    <div class="button-row"><a href="/book" class="button">Book your chair</a><a href="/contact" class="button outline">Plan your visit</a></div>
  </div>
</section>
<section class="wrap section-tight entrance-grid" aria-labelledby="entrance-heading">
  <div><p class="eyebrow">Find the studio</p><h2 id="entrance-heading">Your next look <em>starts here.</em></h2><p>Visit us at {{ business.street }}, {{ business.city }}, {{ business.region }} {{ business.postalCode }}. Look for the building number above the glass entrance.</p><a class="text-link" href="/contact">Hours &amp; directions</a></div>
  {% include "partials/entrance.njk" %}
</section>
{% endblock %}
