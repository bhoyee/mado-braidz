{% extends "layouts/base.njk" %}
{% block content %}
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Visit us</p>
    <h1>Come in. <em>Settle down.</em></h1>
    <p class="intro">A new style starts with a conversation. Call us to talk about your look and arrange your appointment.</p>
  </div>
</section>
<section class="wrap section">{% include "partials/visit.njk" %}</section>
<section class="wrap section contact-layout">
  <div>
    <p class="eyebrow">Let’s talk hair</p>
    <h2>Have a <em>question?</em></h2>
    <p>For now, call <a class="text-link" href="tel:{{ business.phone }}">{{ phoneDisplay }}</a>. Our online enquiry form is being prepared.</p>
  </div>
  <form action="/contact" method="post" aria-describedby="contact-status" class="form-card">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    {% if contactError %}<p class="field-error" role="alert">{{ contactError }}</p>{% endif %}
    <p id="contact-status" class="notice" {% if contactUnavailable %}role="alert"{% endif %}>Online messages are not being sent yet. Please call the studio; nothing entered here is saved.</p>
    {% if turnstileSiteKey %}<div class="cf-turnstile" data-sitekey="{{ turnstileSiteKey }}" data-action="contact" data-size="flexible"></div>{% endif %}
    <div class="booking-honeypot" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" tabindex="-1" autocomplete="off"></div>
    <fieldset disabled>
      <legend class="sr-only">Enquiry form preview</legend>
      <label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" placeholder="Your name">
      <label for="contact-email">Email</label><input id="contact-email" type="email" name="email" autocomplete="email" placeholder="you@example.com">
      <label for="contact-message">Your question</label><textarea id="contact-message" name="message" rows="4" placeholder="Tell us what you have in mind"></textarea>
      <button class="button" type="submit">Online messages coming soon</button>
    </fieldset>
  </form>
</section>
{% if turnstileSiteKey %}<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>{% endif %}
{% endblock %}
