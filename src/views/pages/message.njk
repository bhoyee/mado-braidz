{% extends "layouts/base.njk" %}
{% from "partials/components.njk" import ring %}
{% block content %}
<section class="wrap message-page">
  {{ ring('MADO · AFRICAN BRAIDS · LANHAM MD · ', 'message') }}
  <p class="eyebrow">{{ business.name }}</p>
  <h1>{{ heading }}</h1>
  <p class="intro">{{ message }}</p>
  {% if call %}
  <div class="button-row"><a class="button large" href="tel:{{ business.phone }}">Call {{ phoneDisplay }}</a><a class="button outline large" href="/styles">Browse styles &amp; prices</a></div>
  {% else %}
  <a class="button outline" href="{{ backUrl }}">{{ backLabel }}</a>
  {% endif %}
</section>
{% endblock %}
