<mjml>
  <mj-head
    ><mj-title>{{ subject }}</mj-title
    ><mj-preview>{{ intro }}</mj-preview
    ><mj-attributes
      ><mj-all font-family="Arial, sans-serif" color="#1c0f26" /><mj-text
        font-size="16px"
        line-height="1.6" /><mj-button
        background-color="#7b3fc4"
        color="#ffffff"
        border-radius="6px"
        font-weight="bold" /></mj-attributes
  ></mj-head>
  <mj-body background-color="#fbf7f2" width="600px">
    <mj-section padding="24px 24px 20px"
      ><mj-group vertical-align="middle"
        ><mj-column width="20%" vertical-align="middle"
          ><mj-image
            src="{{ appUrl }}/img/email-logo.png"
            width="64px"
            padding="0"
            align="left"
            alt="Mado African Braids"
            href="{{ appUrl }}" /></mj-column
        ><mj-column width="80%" vertical-align="middle"
          ><mj-text
            font-family="Georgia, serif"
            font-size="24px"
            font-weight="bold"
            line-height="1.2"
            padding="8px 0 8px 12px"
            >{{ businessName }}</mj-text
          ></mj-column
        ></mj-group
      ></mj-section
    >
    <mj-section
      background-color="#ffffff"
      border-top="2px solid #7b3fc4"
      padding="24px 16px"
      ><mj-column
        ><mj-text
          font-family="Georgia, serif"
          font-size="30px"
          font-weight="bold"
          line-height="1.2"
          padding-bottom="12px"
          >{{ subject }}</mj-text
        ><mj-text>{{ intro }}</mj-text
        ><mj-text>{{ content | safe }}</mj-text
        ><mj-button href="{{ actionUrl }}">{{ actionLabel }}</mj-button
        ><mj-text font-size="13px" color="#62596b">{{
          footer
        }}</mj-text></mj-column
      ></mj-section
    >
    <mj-section padding="18px 20px 28px"
      ><mj-column
        ><mj-text align="center" font-size="13px" line-height="1.6" padding="0"
          >{{ address }}<br /><a
            href="tel:{{ phoneHref }}"
            style="color: #1c0f26; text-decoration: none"
            >Tel: {{ phone }}</a
          >{% if marketing %}<br /><a
            href="{{ preferencesUrl }}"
            style="color: #62596b"
            >Unsubscribe</a
          >{% endif %}</mj-text
        ></mj-column
      ></mj-section
    >
  </mj-body></mjml
>
