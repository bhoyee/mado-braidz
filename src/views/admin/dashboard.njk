{% extends "layouts/admin.njk" %}{% from "admin/macros.njk" import appointmentTable %}{% block content %}
<header class="owner-heading"><div><p class="eyebrow">Your studio at a glance</p><h1>Overview.</h1><p>The appointments ahead. The money coming in.</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header>
<div class="overview-metrics">
<a class="overview-metric" href="/admin/payments?period=week"><span class="overview-metric-label">Received this week</span><strong>{{ metrics.week | money }}</strong><span class="overview-metric-foot">After recorded refunds <span aria-hidden="true">↗</span></span></a>
<a class="overview-metric" href="/admin/payments?period=month"><span class="overview-metric-label">Received this month</span><strong>{{ metrics.month | money }}</strong><span class="overview-metric-foot">View payment history <span aria-hidden="true">↗</span></span></a>
<a class="overview-metric overview-metric-balance" href="/admin/balances"><span class="overview-metric-label">Balances outstanding</span><strong>{{ metrics.owed | money }}</strong><span class="overview-metric-foot">View clients with a balance <span aria-hidden="true">↗</span></span></a>
<a class="overview-metric" href="/admin/bookings?from={{ today }}&amp;upcoming=true&amp;order=nearest"><span class="overview-metric-label">Upcoming appointments</span><strong>{{ metrics.pending }}</strong><span class="overview-metric-foot">Confirmed &amp; pending <span aria-hidden="true">↗</span></span></a>
</div>
<section class="owner-panel overview-panel"><div class="owner-section-heading"><div><p class="eyebrow">Your appointment book</p><h2>Today &amp; future appointments</h2><p class="owner-muted">Confirmed and pending · nearest appointment first</p></div><a href="/admin/bookings?from={{ today }}&amp;upcoming=true&amp;order=nearest">Open appointment book ↗</a></div>{{ appointmentTable(appointments,"Today and future appointments") }}</section>
{% endblock %}