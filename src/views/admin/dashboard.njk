{% extends "layouts/admin.njk" %}{% from "admin/macros.njk" import appointmentTable %}{% block content %}
<header class="owner-heading"><div><p class="eyebrow">The owner studio</p><h1>A good day <em>starts here.</em></h1><p>Your appointments, your clients, your chair.</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header>
<div class="owner-metrics"><article><p>Received this week</p><strong>{{ metrics.week | money }}</strong><span>After recorded refunds</span></article><article><p>Received this month</p><strong>{{ metrics.month | money }}</strong><span>Card & recorded transfers</span></article><article><p>Balances outstanding</p><strong>{{ metrics.owed | money }}</strong><span>Confirmed & completed visits</span></article><article><p>New since last sign-in</p><strong>{{ metrics.fresh }}</strong><span>Appointments created</span></article></div>
<section class="owner-panel"><div class="owner-section-heading"><h2>Today & tomorrow</h2><a href="/admin/calendar">Open calendar ↗</a></div>{{ appointmentTable(appointments) }}</section>
<section class="owner-panel"><div class="owner-section-heading"><h2>Chairs on hold</h2><a href="/admin/payment-reviews">Review transfers ↗</a></div>{% for row in holds %}<div class="owner-list-line"><div><strong>{{ row.client.name }}</strong><p>{{ row.booking.startAt | et }} · Hold ends {{ row.booking.holdExpiresAt | et }}</p></div><a href="/admin/bookings/{{ row.booking.id }}">View hold</a></div>{% else %}<p class="owner-muted">No active payment holds.</p>{% endfor %}</section>{% endblock %}
