{% extends "layouts/admin.njk" %}{% from "admin/macros.njk" import appointmentTable %}{% block content %}
<header class="owner-heading"><div><p class="eyebrow">Your studio at a glance</p><h1>Overview.</h1><p>The appointments ahead. The money coming in.</p><p class="owner-live" data-live-status>Live</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header>
<div class="overview-metrics" data-live="metrics">
<a class="overview-metric" href="/admin/payments?period=week"><span class="overview-metric-label">Received this week</span><strong>{{ metrics.week | money }}</strong><span class="overview-metric-foot">After recorded refunds <span aria-hidden="true">↗</span></span></a>
<a class="overview-metric" href="/admin/payments?period=month"><span class="overview-metric-label">Received this month</span><strong>{{ metrics.month | money }}</strong><span class="overview-metric-foot">View payment history <span aria-hidden="true">↗</span></span></a>
<a class="overview-metric{% if metrics.owed > 0 %} overview-metric-balance{% endif %}" href="/admin/balances"><span class="overview-metric-label">Balances outstanding</span><strong>{{ metrics.owed | money }}</strong><span class="overview-metric-foot">View clients with a balance <span aria-hidden="true">↗</span></span></a>
<a class="overview-metric overview-metric-upcoming" href="/admin/bookings?from={{ today }}&amp;upcoming=true&amp;order=nearest"><span class="overview-metric-label">Upcoming appointments</span><strong>{{ metrics.pending }}</strong><span class="overview-metric-foot">Confirmed &amp; pending <span aria-hidden="true">↗</span></span></a>
</div>
<section class="owner-panel overview-panel"><div class="owner-section-heading"><div><p class="eyebrow">Your appointment book</p><h2>Today &amp; future appointments</h2><p class="owner-muted"><span data-live="count">{{ appointments.length }}</span> confirmed and pending · nearest appointment first</p></div><a href="/admin/bookings?from={{ today }}&amp;upcoming=true&amp;order=nearest">Open appointment book ↗</a></div><div class="overview-filter"><label class="sr-only" for="overview-filter">Search upcoming appointments</label><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="overview-filter" type="search" data-live-filter autocomplete="off" spellcheck="false" maxlength="80" placeholder="Search by name, phone, style or payment"></div><p class="owner-muted" data-live-filter-status role="status"></p><div data-live="appointments">{{ appointmentTable(appointments,"Today and future appointments") }}</div></section>
<script defer src="/build/admin-live.js"></script>{% endblock %}