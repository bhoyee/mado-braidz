{% extends "layouts/admin.njk" %}{% macro actionDialog(name, title, text, action, label, booking, csrf, key, danger=false, noteLabel="") %}<dialog id="action-{{ name }}" class="owner-dialog action-dialog" aria-labelledby="action-{{ name }}-title"><header class="owner-extra-heading"><h2 id="action-{{ name }}-title">{{ title }}</h2><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close">&times;</button></header><p>{{ text }}</p><form method="post" action="/admin/bookings/{{ booking.id }}/action" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrf }}"><input type="hidden" name="requestKey" value="{{ key }}"><input type="hidden" name="action" value="{{ action }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p>{{ caller() }}{% if noteLabel %}<label>{{ noteLabel }}<textarea name="note" maxlength="2000" rows="2"></textarea></label>{% endif %}<div class="owner-actions"><button class="button{% if danger %} owner-danger-button{% endif %}" type="submit">{{ label }}</button><button type="button" class="button outline" data-owner-modal-close>Go back</button></div></form></dialog>{% endmacro %}
{% macro historyItem(item) %}<li class="history-item history-{{ item.kind }}"><strong>{{ item.title }}</strong><span class="owner-muted">{{ item.at | et }} ET{% if item.by %} · {{ item.by }}{% endif %}</span>{% for change in item.changes %}<span class="history-change">{{ change.label }}: {% if change.before != '—' %}{{ change.before }} → {% endif %}{{ change.after }}</span>{% endfor %}</li>{% endmacro %}
{% block content %}{% set first = client.name.split(' ')[0] %}<span hidden data-live="appointment-version" data-live-reload>{{ version }}</span><header class="owner-heading appointment-heading"><div><p class="eyebrow">Appointment · {{ booking.ref }}</p><h1>{{ client.name }}’s <em>visit.</em></h1><p>{{ booking.startAt | et('cccc, LLLL d, yyyy') }} · {{ booking.startAt | et('h:mm a') }}–{{ booking.endAt | et('h:mm a') }} Eastern</p><div class="appointment-badges"><span class="owner-badge status-{{ 'review' if pendingProof and booking.status == 'pending_payment' else booking.status }}">{{ statusLabel }}</span>{% if pendingProof and booking.status != 'pending_payment' %}<span class="owner-badge status-review">Balance payment to review</span>{% endif %}{% if booking.paymentChoice == 'none' and booking.paidCents == 0 and booking.status == 'confirmed' %}<span class="owner-badge">Owner override · unpaid</span>{% endif %}{% if actions.holdLive %}<span class="appointment-hold">Chair held until {{ booking.holdExpiresAt | et('ccc, LLL d · h:mm a') }} ET</span>{% elif booking.status == 'pending_payment' %}<span class="appointment-hold is-ended">The hold has ended</span>{% endif %}</div><p class="owner-live" data-live-status>Live</p></div>{% if actions.edit %}<a class="button" href="/admin/bookings/{{ booking.id }}/edit">Edit appointment</a>{% endif %}</header>
{% if not visits.removed %}<div class="appointment-quick" role="group" aria-label="Contact {{ client.name }}">{% if client.phoneE164 %}<a class="button outline" href="tel:{{ client.phoneE164 }}">Call</a><a class="button outline" href="https://wa.me/{{ client.phoneE164 | replace('+','') }}?text={{ ('Hi ' + first + ', this is Mado African Braids about your appointment on ' + (booking.startAt | et('cccc, LLLL d')) + ' at ' + (booking.startAt | et('h:mm a')) + '.') | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}<a class="button outline" href="mailto:{{ client.email }}?subject={{ 'Your appointment at Mado African Braids' | urlencode }}">Email</a><button type="button" class="button outline" data-copy-text="{{ directions }}">Copy directions link</button><button type="button" class="button outline" data-copy-text="{{ manageUrl }}">Copy visit link</button></div>{% endif %}
{% if pendingProof %}{% include "admin/proof-review.njk" %}{% endif %}<div class="owner-receipt"><div><span>Appointment total</span><strong>{{ booking.subtotalCents | money }}</strong>{% if price.consultation %}<small>Provisional · final price to agree</small>{% endif %}</div><div><span>Amount paid</span><strong{% if booking.paidCents %} class="is-good"{% endif %}>{{ booking.paidCents | money }}</strong>{% if pendingProof %}<small>{{ pendingProof.amountCents | money }} {{ pendingProof.method | payMethod }} awaiting verification</small>{% endif %}</div><div><span>Balance remaining</span>{% if openBooking %}<strong class="{% if booking.balanceCents > 0 %}is-due{% else %}is-good{% endif %}">{{ booking.balanceCents | money }}</strong>{% if booking.balanceCents <= 0 %}<small>Paid in full</small>{% endif %}{% else %}<strong>{{ 0 | money }}</strong><small>Nothing to collect</small>{% endif %}</div></div>
<section class="owner-panel appointment-actions" aria-labelledby="actions-heading"><h2 id="actions-heading">What would you like to do?</h2>{% if actions.blocked %}<p class="appointment-blocked">{{ actions.blocked }}</p>{% endif %}<div class="owner-actions">{% if actions.payment %}<button type="button" class="button" data-owner-modal-open="action-payment">Record a payment</button>{% endif %}{% if actions.complete %}<button type="button" class="button outline" data-owner-modal-open="action-complete">Mark completed</button>{% endif %}{% if actions.noShow %}<button type="button" class="button outline" data-owner-modal-open="action-no-show">Mark no-show</button>{% endif %}{% if actions.balanceLink %}<button type="button" class="button outline" data-owner-modal-open="action-balance-link">Email balance link</button>{% endif %}{% if actions.resend %}<button type="button" class="button outline" data-owner-modal-open="action-resend">Resend confirmation</button>{% endif %}{% if actions.confirm %}<button type="button" class="button outline" data-owner-modal-open="action-confirm">Confirm without payment</button>{% endif %}{% if actions.refundable.length %}<button type="button" class="button outline" data-owner-modal-open="action-refund">Refund</button>{% endif %}{% if actions.cancel %}<button type="button" class="button outline appointment-cancel" data-owner-modal-open="action-cancel">Cancel appointment</button>{% endif %}</div>{% if booking.status == 'confirmed' and not actions.complete and not actions.blocked %}<p class="owner-muted">Mark completed and Mark no-show appear once the visit has started.</p>{% elif not (actions.payment or actions.refundable.length or actions.cancel or actions.balanceLink or actions.blocked) %}<p class="owner-muted">There is nothing left to do for this appointment.</p>{% endif %}</section>
<div class="owner-columns"><div><section class="owner-panel"><h2>The appointment</h2><dl class="owner-facts"><div><dt>Style</dt><dd>{{ price.styleName }}</dd></div><div><dt>Size & length</dt><dd>{{ [price.size, price.length] | optionLabel }}</dd></div><div><dt>Extras</dt><dd>{% for addon in price.addons %}{{ addon.name }}{% if not loop.last %}, {% endif %}{% else %}None{% endfor %}</dd></div><div><dt>Duration</dt><dd>{{ price.durationMin / 60 }} {% if price.durationMin == 60 %}hr{% else %}hrs{% endif %}</dd></div><div><dt>Payment</dt><dd>{% if pendingProof %}Awaiting verification{% else %}{{ booking.paymentStatus | replace('_',' ') | title }}{% endif %}</dd></div><div><dt>Payment source</dt><dd>{{ paymentSource }}</dd></div><div><dt>Booked through</dt><dd>{% if booking.source == 'admin' %}Studio{% else %}Website{% endif %}</dd></div>{% if booking.cancelReason %}<div><dt>Cancel reason</dt><dd>{{ booking.cancelReason }}</dd></div>{% endif %}</dl><h3>Client notes</h3><p class="owner-preline">{{ booking.clientNotes or 'No notes.' }}</p>{% if inspiration %}<a class="owner-text-link" href="/admin/bookings/{{ booking.id }}/inspiration" target="_blank" rel="noopener">View private inspiration photo ↗</a>{% endif %}</section>
<section class="owner-panel"><h2>Payments</h2>{% for payment in payments %}<div class="owner-list-line"><div><strong>{% if payment.type == 'refund' %}Refund{% else %}{{ payment.type | title }} payment{% endif %} · <span class="{% if payment.type == 'refund' %}pay-due{% else %}pay-good{% endif %}">{% if payment.type == 'refund' %}−{% endif %}{{ payment.amountCents | money }}</span></strong><p>{{ payment.method | payMethod }} · {{ payment.createdAt | et }} ET</p>{% if payment.note and payment.note.indexOf('Verified payment proof') != 0 %}<p>{{ payment.note }}</p>{% endif %}</div></div>{% else %}<p class="owner-muted">No payments recorded.</p>{% endfor %}{% for job in refundJobs %}{% if job.status != 'done' %}<p class="owner-muted">Card refund {{ job.status }} · waiting for Stripe</p>{% endif %}{% endfor %}{% for proof in proofs %}<p class="appointment-proof"><span class="owner-badge{% if proof.status == 'pending' %} status-review{% elif proof.status == 'approved' %} status-confirmed{% else %} status-cancelled{% endif %}">{{ proof.method | payMethod }} · {{ 'awaiting verification' if proof.status == 'pending' else proof.status }}</span> {{ proof.amountCents | money }} {% if proof.path != 'removed' %}<a class="owner-text-link" href="/admin/payment-reviews/{{ proof.id }}/image" target="_blank" rel="noopener">View screenshot ↗</a>{% endif %}</p>{% endfor %}</section>
<section class="owner-panel"><h2>History</h2><ul class="history-list">{% for item in history.slice(0,6) %}{{ historyItem(item) }}{% endfor %}</ul>{% if history.length > 6 %}<details class="history-more"><summary>Show {{ history.length - 6 }} earlier</summary><ul class="history-list">{% for item in history.slice(6) %}{{ historyItem(item) }}{% endfor %}</ul></details>{% endif %}</section></div>
<div><section class="owner-panel"><h2>The client</h2><p class="appointment-client"><strong>{{ client.name }}</strong>{% if not visits.removed %}<a href="tel:{{ client.phoneE164 }}">{{ client.phoneE164 | phone }}</a><a href="mailto:{{ client.email }}">{{ client.email }}</a>{% endif %}</p><p>{% if visits.completed %}{{ visits.completed }} completed visit{% if visits.completed != 1 %}s{% endif %}{% else %}No completed visits yet{% endif %}{% if visits.noShows %} · <span class="pay-due">{{ visits.noShows }} no-show{% if visits.noShows != 1 %}s{% endif %}</span>{% endif %}</p>{% if visits.rows.length %}<ul class="visit-list">{% for visit in visits.rows %}<li><a href="/admin/bookings/{{ visit.id }}"><span>{{ visit.startAt | et('LLL d, yyyy') }} · {{ visit.styleName }}</span><span class="owner-badge status-{{ visit.status }}">{{ visit.status | replace('_',' ') }}</span></a></li>{% endfor %}</ul>{% endif %}{% if visits.tags and visits.tags.length %}<p class="client-tags">{% for tag in visits.tags %}<span class="photo-tag is-warn">{{ tag }}</span>{% endfor %}</p>{% endif %}{% if visits.notes %}<h3>Client notes for every visit</h3><p class="owner-preline">{{ visits.notes }}</p>{% endif %}<p><a class="owner-text-link" href="/admin/clients/{{ client.id }}">Open client profile →</a></p></section>
<section class="owner-panel"><h2>Private notes</h2><form method="post" action="/admin/bookings/{{ booking.id }}/action" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}"><input type="hidden" name="action" value="note"><label>Only visible to the owner<textarea name="note" maxlength="2000" rows="4" data-live-guard>{{ booking.adminNotes }}</textarea></label><button class="button outline" type="submit">Save note</button></form></section>
<section class="owner-panel"><h2>Private visit &amp; payment link</h2><p class="owner-muted">The client can see, reschedule and pay for this visit here. Share it only with them.</p><label class="sr-only" for="private-link">Private visit link</label><input id="private-link" class="owner-copy-link" value="{{ manageUrl }}" readonly><button type="button" class="button outline" data-copy-link="private-link">Copy private link</button></section></div></div>
{% if actions.payment %}{% call actionDialog('payment','Record a payment','Record money you have already received. This does not charge a card. The client is emailed a receipt.','payment','Record received payment',booking,csrfToken,requestKey,false,'Payment note') %}<label>Amount received (USD)<input type="number" inputmode="decimal" data-money="amountCents" min="0.01" max="{{ booking.balanceCents / 100 }}" step="0.01" value="{{ (booking.balanceCents / 100).toFixed(2) }}" required></label><p class="owner-muted">{{ booking.balanceCents | money }} is outstanding. Change the amount for a part payment{% if booking.status == 'pending_payment' %}; at least the {{ booking.depositCents | money }} deposit confirms the appointment{% endif %}.</p><label>Method<select name="method"><option value="cash">Cash</option><option value="zelle">Zelle</option><option value="cashapp">Cash App</option><option value="card">Card taken in person</option><option value="other">Other</option></select></label>{% endcall %}{% endif %}
{% if actions.complete %}{% call actionDialog('complete','Mark this visit completed?','The appointment moves to your past visits.' + (' The balance stays outstanding until you record it.' if booking.balanceCents > 0 else ''),'complete','Mark completed',booking,csrfToken,requestKey,false,'Note (optional)') %}{% endcall %}{% endif %}
{% if actions.noShow %}{% call actionDialog('no-show','Mark as a no-show?','Use this when the client did not come. Payments already made stay recorded.','no-show','Mark no-show',booking,csrfToken,requestKey,true,'Note (optional)') %}{% endcall %}{% endif %}
{% if actions.confirm %}{% call actionDialog('confirm','Confirm without payment?','The chair is reserved without a deposit and the client is emailed a confirmation. Choose this only if you agreed it with them.','confirm','Confirm without payment',booking,csrfToken,requestKey,false,'Reason (optional)') %}{% endcall %}{% endif %}
{% if actions.cancel %}{% call actionDialog('cancel','Cancel this appointment?','The chair is released and ' + client.name + ' is emailed. Any refund is a separate step.','cancel','Cancel appointment',booking,csrfToken,requestKey,true,'Reason (optional)') %}{% endcall %}{% endif %}
{% if actions.balanceLink %}{% call actionDialog('balance-link','Email the balance link?',client.name + ' will be emailed a private link to pay the balance.','balance-link','Send balance link',booking,csrfToken,requestKey) %}{% endcall %}{% endif %}
{% if actions.resend %}{% call actionDialog('resend','Resend the confirmation?','The confirmation is emailed again to ' + client.email + '.','resend','Resend confirmation',booking,csrfToken,requestKey) %}{% endcall %}{% endif %}
{% if actions.refundable.length %}{% call actionDialog('refund','Refund a payment','Card refunds return to the original card. For cash or transfers, return the money yourself first, then record it here.','refund','Submit refund',booking,csrfToken,requestKey,true) %}<label>Original payment<select name="paymentId" required>{% for payment in actions.refundable %}<option value="{{ payment.id }}">{{ payment.remainingCents | money }} left of {{ payment.amountCents | money }} · {{ payment.method | payMethod }} · {{ payment.createdAt | et('LLL d') }}</option>{% endfor %}</select></label><label>Refund amount (USD)<input type="number" inputmode="decimal" data-money="amountCents" min="0.01" step="0.01" required></label><label>Reason<input name="note" required maxlength="2000"></label>{% endcall %}{% endif %}<script defer src="/build/admin-live.js"></script>{% endblock %}
