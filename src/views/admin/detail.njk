{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Appointment · {{ booking.ref }}</p><h1>{{ client.name }}’s <em>visit.</em></h1><p>{{ booking.startAt | et('cccc, LLLL d, yyyy') }} · {{ booking.startAt | et('h:mm a') }}–{{ booking.endAt | et('h:mm a') }} Eastern</p><span class="owner-badge status-{{ booking.status }}">{{ booking.status | replace('_',' ') }}</span>{% if booking.paymentChoice == 'none' and booking.paidCents == 0 and booking.status == 'confirmed' %}<span class="owner-badge">Owner override · unpaid</span>{% endif %}</div>{% if booking.status == 'confirmed' or booking.status == 'pending_payment' %}<a class="button" href="/admin/bookings/{{ booking.id }}/edit">Edit appointment</a>{% endif %}</header>
<div class="owner-receipt"><div><span>Appointment total</span><strong>{{ booking.subtotalCents | money }}</strong>{% if price.consultation %}<small>Provisional · final price to agree</small>{% endif %}</div><div><span>Amount paid</span><strong>{{ booking.paidCents | money }}</strong></div><div><span>Balance remaining</span><strong>{{ booking.balanceCents | money }}</strong></div></div>
<div class="owner-columns"><div><section class="owner-panel"><h2>The appointment</h2><dl class="owner-facts"><div><dt>Style</dt><dd>{{ price.styleName }}</dd></div><div><dt>Size & length</dt><dd>{{ price.size | replace('_',' ') | title }} {{ price.length | replace('_',' ') | title }}</dd></div><div><dt>Extras</dt><dd>{% for addon in price.addons %}{{ addon.name }}{% if not loop.last %}, {% endif %}{% else %}None{% endfor %}</dd></div><div><dt>Duration</dt><dd>{{ price.durationMin / 60 }} {% if price.durationMin == 60 %}hr{% else %}hrs{% endif %}</dd></div><div><dt>Payment</dt><dd>{{ booking.paymentStatus | replace('_',' ') | title }}</dd></div><div><dt>Source</dt><dd>{{ booking.source | title }}</dd></div></dl><h3>Client</h3><p><a href="mailto:{{ client.email }}">{{ client.email }}</a><br><a href="tel:{{ client.phoneE164 }}">{{ client.phoneE164 }}</a></p><h3>Client notes</h3><p class="owner-preline">{{ booking.clientNotes or 'No notes.' }}</p>{% if inspiration %}<a class="owner-text-link" href="/admin/bookings/{{ booking.id }}/inspiration" target="_blank" rel="noopener">View private inspiration photo ↗</a>{% endif %}<h3>Private visit & payment link</h3><label class="sr-only" for="private-link">Private visit link</label><input id="private-link" class="owner-copy-link" value="{{ manageUrl }}" readonly><button type="button" class="button outline" data-copy-link="private-link">Copy private link</button></section>
<section class="owner-panel"><h2>Payment timeline</h2>{% for payment in payments %}<div class="owner-list-line"><div><strong>{% if payment.type == 'refund' %}Refund{% else %}{{ payment.type | title }} payment{% endif %} · {{ payment.amountCents | money }}</strong><p>{{ payment.method | title }} · {{ payment.createdAt | et }}</p>{% if payment.note %}<p>{{ payment.note }}</p>{% endif %}</div><span class="owner-muted">{{ payment.provider | title }}</span></div>{% else %}<p class="owner-muted">No payments recorded.</p>{% endfor %}{% for job in refundJobs %}<p class="owner-muted">Refund request: {{ job.status }}{% if job.status != 'done' %} · reconciliation pending{% endif %}</p>{% endfor %}{% for proof in proofs %}<p><span class="owner-badge">{{ proof.method | title }} proof · {{ proof.status }}</span> {{ proof.amountCents | money }}</p>{% endfor %}</section>
<section class="owner-panel"><h2>History & email</h2>{% for audit in audits %}<div class="owner-list-line"><p><strong>{{ audit.action | replace('_',' ') | title }}</strong><br><span class="owner-muted">{{ audit.createdAt | et }} · Owner {{ audit.adminId }}</span></p></div>{% else %}<p class="owner-muted">No owner changes yet.</p>{% endfor %}{% for email in emails %}<p>{{ email.template }} · {{ email.status }} · {{ email.createdAt | et }}</p>{% else %}<p class="owner-muted">No delivered emails logged. Email delivery arrives in Milestone 7.</p>{% endfor %}</section></div>
<div><section class="owner-panel"><h2>Booking actions</h2><form method="post" action="/admin/bookings/{{ booking.id }}/action" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}"><label>Action<select name="action" required>{% if booking.status == 'pending_payment' %}<option value="confirm">Confirm without payment · owner override</option>{% endif %}{% if booking.status == 'confirmed' %}<option value="complete">Mark completed</option><option value="no-show">Mark no-show</option>{% endif %}{% if booking.status == 'confirmed' or booking.status == 'pending_payment' %}<option value="cancel">Cancel appointment</option>{% endif %}<option value="balance-link">Queue balance payment link</option><option value="resend">Queue confirmation email</option></select></label><label>Reason / note<textarea name="note" maxlength="2000" rows="2"></textarea></label><p class="owner-muted">Cancelling releases the chair. Refunds are recorded separately.</p><button class="button outline">Apply action</button></form></section>
<section class="owner-panel"><h2>Record a payment</h2><p class="owner-muted">Record money you have already received. This does not charge a card.</p><form method="post" action="/admin/bookings/{{ booking.id }}/action" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}"><input type="hidden" name="action" value="payment"><label>Amount received (USD)<input type="number" data-money="amountCents" min="0.01" step="0.01" required></label><label>Method<select name="method"><option value="cash">Cash</option><option value="zelle">Zelle</option><option value="cashapp">Cash App</option><option value="card">Card taken in person</option><option value="other">Other</option></select></label><label>Payment note<input name="note" maxlength="2000"></label><button class="button">Record received payment</button></form></section>
{% if payments.length %}<section class="owner-panel"><h2>Refund a payment</h2><p class="owner-muted">Stripe refunds return to the original card. For cash or transfers, return the money yourself first, then record it here.</p><form method="post" action="/admin/bookings/{{ booking.id }}/action" class="owner-form" data-owner-form data-confirm="Issue this Stripe refund, or record a manual refund you have already returned?"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}"><input type="hidden" name="action" value="refund"><label>Original payment<select name="paymentId" required>{% for payment in payments %}{% if payment.type != 'refund' %}<option value="{{ payment.id }}">{{ payment.amountCents | money }} · {{ payment.provider | title }} · {{ payment.method | title }} · #{{ payment.id }}</option>{% endif %}{% endfor %}</select></label><label>Refund amount (USD)<input type="number" data-money="amountCents" min="0.01" step="0.01" required></label><label>Reason<input name="note" required maxlength="2000"></label><button class="button outline">Submit refund</button></form></section>{% endif %}
<section class="owner-panel"><h2>Private notes</h2><form method="post" action="/admin/bookings/{{ booking.id }}/action" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}"><input type="hidden" name="action" value="note"><label>Only visible to the owner<textarea name="note" maxlength="2000" rows="4">{{ booking.adminNotes }}</textarea></label><button class="button outline">Save note</button></form></section></div></div>{% endblock %}
