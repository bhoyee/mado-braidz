{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Room for the next look</p><h1>Your studio <em>calendar.</em></h1><p>All times Eastern. Select an appointment for details, drag it to move it, or select an empty time to book or block it.</p><p class="owner-live" data-calendar-status>Live</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header><section class="owner-panel owner-calendar-panel"><div class="owner-calendar-key"><span class="owner-badge status-confirmed">Confirmed</span><span class="owner-badge status-pending_payment">Awaiting payment</span><span class="owner-badge status-review">Payment to review</span><span class="owner-badge status-completed">Completed</span><span class="owner-badge status-no_show">No-show or conflict</span><span class="owner-badge calendar-closed-key">Closed or blocked</span><label class="owner-calendar-switch"><input type="checkbox" data-show-cancelled>Show cancelled</label></div><div id="owner-calendar" aria-label="Appointment calendar" data-hours="{{ hours | dump | escape }}" data-special="{{ special | dump | escape }}"></div><noscript><p>Enable JavaScript to use the calendar, or <a href="/admin/bookings">open the appointment list</a>.</p></noscript></section><dialog id="calendar-details" class="owner-dialog calendar-details" aria-labelledby="calendar-details-name"><header class="owner-extra-heading"><div><span data-detail="status" class="owner-badge"></span><h2 id="calendar-details-name" data-detail="name"></h2></div><button type="button" class="owner-extra-close" data-detail-close aria-label="Close details">&times;</button></header><p data-detail="when"></p><dl class="owner-facts"><div><dt>Style</dt><dd data-detail="style"></dd></div><div><dt>Phone</dt><dd data-detail="phone"></dd></div><div><dt>Paid</dt><dd data-detail="paid"></dd></div><div><dt>Balance</dt><dd><strong data-detail="balance"></strong></dd></div><div><dt>Payment source</dt><dd data-detail="source"></dd></div></dl><div class="owner-actions"><a class="button" data-detail-view href="/admin/bookings">View appointment</a><a class="button outline" data-detail-call href="/admin/calendar" hidden>Call client</a></div></dialog><dialog id="calendar-slot" class="owner-dialog action-dialog" aria-labelledby="calendar-slot-title"><header class="owner-extra-heading"><h2 id="calendar-slot-title" data-slot-title></h2><button type="button" class="owner-extra-close" data-slot-close aria-label="Close">&times;</button></header><p><a class="button" data-slot-book href="/admin/bookings/new">New appointment</a></p><form class="owner-form settings-inline" data-slot-form><h3>Or block this time</h3><p class="owner-error" role="alert" data-slot-error hidden></p><label class="owner-check"><input type="checkbox" name="allDay" data-slot-all><span>All day</span></label><div class="owner-fields" data-slot-times><label>From<input type="time" name="start" required></label><label>Until<input type="time" name="end" required></label></div><label>Reason (private)<input name="reason" maxlength="500"></label><button class="button outline" type="submit">Block this time</button></form></dialog><dialog id="calendar-blocked" class="owner-dialog action-dialog" aria-labelledby="calendar-blocked-title"><header class="owner-extra-heading"><h2 id="calendar-blocked-title" data-blocked-title></h2><button type="button" class="owner-extra-close" data-slot-close aria-label="Close">&times;</button></header><p data-blocked-when></p><p class="owner-error" role="alert" data-blocked-error hidden></p><div class="owner-actions"><button type="button" class="button outline" data-blocked-remove>Remove block</button><a class="button outline" href="/admin/time-off">Open Time off</a></div></dialog><script defer src="/build/admin-calendar.js"></script>{% endblock %}
