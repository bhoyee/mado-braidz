{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Room for the next look</p><h1>Your studio <em>calendar.</em></h1><p>All times Eastern. Select an appointment for details, or drag it to move it.</p><p class="owner-live" data-calendar-status>Live</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header><section class="owner-panel owner-calendar-panel"><div class="owner-calendar-key"><span class="owner-badge status-confirmed">Confirmed</span><span class="owner-badge status-pending_payment">Awaiting payment</span><span class="owner-badge status-review">Payment to review</span><span class="owner-badge status-completed">Completed</span><span class="owner-badge status-no_show">No-show or conflict</span><span class="owner-badge calendar-closed-key">Closed or blocked</span><label class="owner-calendar-switch"><input type="checkbox" data-show-cancelled>Show cancelled</label></div><div id="owner-calendar" aria-label="Appointment calendar" data-hours="{{ hours | dump | escape }}"></div><noscript><p>Enable JavaScript to use the calendar, or <a href="/admin/bookings">open the appointment list</a>.</p></noscript></section><dialog id="calendar-details" class="owner-dialog calendar-details" aria-labelledby="calendar-details-name"><header class="owner-extra-heading"><div><span data-detail="status" class="owner-badge"></span><h2 id="calendar-details-name" data-detail="name"></h2></div><button type="button" class="owner-extra-close" data-detail-close aria-label="Close details">&times;</button></header><p data-detail="when"></p><dl class="owner-facts"><div><dt>Style</dt><dd data-detail="style"></dd></div><div><dt>Phone</dt><dd data-detail="phone"></dd></div><div><dt>Paid</dt><dd data-detail="paid"></dd></div><div><dt>Balance</dt><dd><strong data-detail="balance"></strong></dd></div><div><dt>Payment source</dt><dd data-detail="source"></dd></div></dl><div class="owner-actions"><a class="button" data-detail-view href="/admin/bookings">View appointment</a><a class="button outline" data-detail-call href="/admin/calendar" hidden>Call client</a></div></dialog><script defer src="/build/admin-calendar.js"></script>{% endblock %}
