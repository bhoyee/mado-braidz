{% extends "layouts/admin.njk" %}
{% macro toggle(name, label, on, locked) %}<label class="mini-switch alert-switch"><input type="checkbox" role="switch" {% if not locked %}name="{{ name }}"{% endif %} aria-label="{{ label }}" {% if on %}checked{% endif %} {% if locked %}disabled{% endif %}></label>{% endmacro %}
{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">Your studio updates</p><h1>Notifications.</h1><p>What needs you, and what has happened.</p><p class="owner-live" data-live-status>Live</p></div></header>
<div data-live="needs">{% if needs.reviews.length or needs.failures.length %}<section class="owner-panel alert-needs" id="needs" aria-labelledby="needs-title"><h2 id="needs-title">Needs you <span class="alert-count">{{ needs.reviews.length + needs.failures.length }}</span></h2><ul class="alert-list">
{% for item in needs.reviews %}<li class="alert-need"><div><strong>{{ item.name }} sent {{ item.amountCents | money }} by {{ 'Zelle' if item.method == 'zelle' else 'Cash App' }}</strong><span class="owner-muted">{{ item.style }}, {{ item.startAt | et }} ET</span>{% if item.deadline %}<span class="alert-deadline">Review by {{ item.deadline | et }} ET or the chair may be released</span>{% else %}<span class="owner-muted">Sent {{ item.submittedAt | et }} ET</span>{% endif %}</div><a class="button" href="/admin/bookings/{{ item.bookingId }}">Review payment</a></li>{% endfor %}
{% for item in needs.failures %}<li class="alert-need"><div><strong>{% if item.refund %}A refund to {{ item.name }} has not gone through{% elif item.whatsapp %}A WhatsApp alert may not have reached you{% else %}“{{ item.template | emailName }}” to {{ item.name }} was not delivered{% endif %}</strong><span class="owner-muted">{{ item.reason }}</span><span class="owner-muted">{{ item.at | et }} ET</span></div><div class="alert-buttons">{% if item.canRetry %}<button type="button" class="button" data-alert-post="/admin/notifications/failures/{{ item.id }}/retry">Try again</button>{% endif %}{% if item.bookingId %}<a class="button outline" href="/admin/bookings/{{ item.bookingId }}">Open appointment</a>{% endif %}{% if item.canDismiss %}<button type="button" class="button outline" data-alert-post="/admin/notifications/failures/{{ item.id }}/dismiss">Dismiss</button>{% endif %}</div></li>{% endfor %}
</ul></section>{% else %}<p class="alert-clear" id="needs">Nothing needs you right now.</p>{% endif %}</div>
<details class="owner-panel alert-fold" data-device-panel><summary><span><strong>Alerts on this device</strong><span class="owner-muted" data-device-summary>{% if pushAvailable %}Checking…{% else %}Waiting for website support to set up{% endif %}</span></span></summary>{% if pushAvailable %}<ol class="alert-steps" data-push-help><li>Turn on the switch below.</li><li>Choose Allow when asked.</li></ol><div class="owner-actions"><label class="owner-push-control"><span>Push notifications on this device</span><input type="checkbox" role="switch" aria-label="Push notifications on this device" data-push-switch data-vapid-key="{{ vapidKey }}"><span class="owner-push-track" aria-hidden="true"></span></label><button type="button" class="button outline" data-test-push>Send test alert</button></div>{% endif %}<p role="status" data-push-status></p>{% if devices.length %}<h3>Your devices</h3><ul class="away-list">{% for device in devices %}<li><div><strong>{{ device.label }}</strong><span class="owner-muted">Added {{ device.createdAt | et }} ET</span></div><button type="button" class="button outline" data-alert-post="/admin/notifications/devices/{{ device.id }}/remove">Remove<span class="sr-only"> {{ device.label }}</span></button></li>{% endfor %}</ul>{% endif %}</details>
<section class="owner-panel" data-live="feed" aria-labelledby="feed-title"><div class="owner-section-heading"><h2 id="feed-title">Updates</h2><div class="alert-buttons">{% if unread %}<button type="button" class="button outline" data-mark-all>Mark all as read</button>{% endif %}</div></div>
<nav class="appointment-views" aria-label="Notification views">{% for key, item in views %}<a href="/admin/notifications?view={{ key }}" {% if view == key %}aria-current="page"{% endif %}>{{ item.name }}{% if key == 'unread' and unread %} <span>{{ unread }}</span>{% endif %}</a>{% endfor %}</nav>
{% for day in days %}<h3 class="alert-day">{{ day.label }}</h3><ul class="alert-list">{% for item in day.items %}<li><a class="alert-row {% if not item.readAt %}is-unread{% endif %} {% if item.urgent %}is-urgent{% endif %}" href="{{ item.href }}" data-alert-id="{{ item.id }}" {% if not item.readAt %}data-unread{% endif %}><span class="alert-dot" aria-hidden="true"></span><span class="alert-text"><strong>{% if not item.readAt %}<span class="sr-only">Unread: </span>{% endif %}{{ item.title }}</strong><span class="owner-muted">{{ item.body }}</span></span><span class="alert-meta"><span class="photo-tag {% if item.urgent %}is-warn{% endif %}">{{ item.group }}</span><time datetime="{{ item.createdAt.toISOString() }}">{{ item.time }}</time></span></a></li>{% endfor %}</ul>{% else %}<p class="owner-muted">{% if view == 'unread' %}You have read everything.{% else %}Nothing here yet.{% endif %}</p>{% endfor %}
<nav class="owner-pagination" aria-label="Notification pages">{% if page > 1 %}<a href="/admin/notifications?view={{ view }}&amp;page={{ page - 1 }}">← Previous</a>{% endif %}{% if total %}<span>{{ first }}–{{ first + items.length - 1 }} of {{ total }}</span>{% endif %}{% if page < last %}<a href="/admin/notifications?view={{ view }}&amp;page={{ page + 1 }}">Next →</a>{% endif %}</nav></section>
<details class="owner-panel alert-fold"><summary><span><strong>Choose your alerts</strong><span class="owner-muted">What is sent to your devices and email, and quiet hours</span></span></summary><form class="settings-inline" action="/admin/notifications/preferences" method="post" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><div class="alert-choices"><div class="alert-choice alert-choice-head" aria-hidden="true"><span></span><span>Device</span><span>Email</span></div>{% for group in groups %}<div class="alert-choice"><span><strong>{{ group.name }}</strong><span class="owner-muted">{{ group.text }}{% if group.locked %} Always on.{% endif %}</span></span>{{ toggle('push_' + group.key, group.name + ' on your devices', prefs.push[group.key], group.locked) }}{{ toggle('email_' + group.key, group.name + ' by email', prefs.email[group.key], group.locked) }}</div>{% endfor %}</div><p class="owner-muted">Email choices apply to every address in <a class="owner-text-link" href="/admin/settings/emails">Settings, Emails</a>. Device choices are only yours.</p><label class="owner-check"><input type="checkbox" name="names" {% if prefs.names %}checked{% endif %}><span>Show client names in device alerts. They can appear on a locked screen.</span></label><label class="owner-check"><input type="checkbox" name="quiet" {% if prefs.quiet %}checked{% endif %}><span>Quiet hours: hold device alerts until morning. Payments to review still come through.</span></label><div class="owner-form-grid"><label class="owner-field"><span>Quiet from (Eastern)</span><input type="time" name="quietFrom" value="{{ prefs.quietFrom }}" required></label><label class="owner-field"><span>Until</span><input type="time" name="quietTo" value="{{ prefs.quietTo }}" required></label></div><button class="button" type="submit">Save alert choices</button></form></details>
<p class="owner-muted">Alerts you have read are cleared after 90 days.</p>
<script defer src="/build/admin-live.js"></script><script defer src="/build/admin-notifications.js"></script>
{% endblock %}
