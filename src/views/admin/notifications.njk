{% extends "layouts/admin.njk" %}
{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">Your studio updates</p><h1>Notifications.</h1><p>Appointments, payments and delivery updates in one place.</p></div><span class="owner-badge">{{ unread }} unread</span></header>
<section class="owner-panel"><h2>Alerts on this device</h2><p>Enable push alerts to hear about new bookings while the owner portal is closed. Each phone, tablet or computer must enable alerts separately.</p><p class="owner-muted" data-push-help>On iPhone or iPad, add this portal to your Home Screen first, then open it there. On Android, enable alerts in your browser.</p>{% if pushAvailable %}<div class="owner-actions"><label class="owner-push-control"><span>Push notifications on this device</span><input type="checkbox" role="switch" aria-label="Push notifications on this device" data-push-switch data-vapid-key="{{ vapidKey }}"><span class="owner-push-track" aria-hidden="true"></span></label><button type="button" class="button outline" data-test-push>Send test alert</button></div>{% else %}<p class="owner-muted">Push alerts are awaiting server configuration.</p>{% endif %}<p role="status" data-push-status></p></section>
<div class="owner-panel"><div class="owner-actions"><h2>Recent updates</h2><form method="post" action="/admin/notifications/read" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit" class="button outline compact">Mark all as read</button></form></div><div class="owner-notifications" role="region" aria-label="Recent notifications" tabindex="0">{% for item in items %}<article class="owner-notification {% if not item.readAt %}unread{% endif %}"><p class="owner-muted">{{ item.createdAt | et }}</p><h3><a href="{{ item.url or '/admin/notifications' }}">{{ item.title }}</a></h3><p>{{ item.body }}</p>{% if not item.readAt %}<form method="post" action="/admin/notifications/read" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="id" value="{{ item.id }}"><button type="submit" class="button outline compact">Mark as read</button></form>{% endif %}</article>{% else %}<p>Your studio updates will appear here.</p>{% endfor %}</div></div>
{% endblock %}
