{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">A clear record</p><h1>Studio <em>history.</em></h1><p>Sign-ins and booking changes, recorded with who made them and when.</p></div></header><section class="owner-panel">{% for row in rows %}<article class="owner-audit-entry"><div class="owner-section-heading"><h2>{{ row.entry.action | replace('_',' ') | title }}</h2><span class="owner-muted">{{ row.entry.createdAt | et }}</span></div><p>{{ row.name }} · {{ row.entry.entity | replace('_',' ') | title }} #{{ row.entry.entityId }} {% if row.entry.entity == 'booking' %}<a href="/admin/bookings/{{ row.entry.entityId }}">Open appointment ↗</a>{% endif %}</p>{% if row.changes.length %}<details><summary>View changes</summary><dl class="owner-facts">{% for change in row.changes %}<div><dt>{{ change.label }}</dt><dd><span class="owner-muted">{{ change.before }}</span><br>→ {{ change.after }}</dd></div>{% endfor %}</dl></details>{% endif %}</article>{% else %}<p class="owner-muted">No activity recorded.</p>{% endfor %}<nav class="owner-pagination" aria-label="History pages">{% if page > 1 %}<a href="?page={{ page - 1 }}">← Previous</a>{% endif %}<span>Page {{ page }}</span>{% if hasNext %}<a href="?page={{ page + 1 }}">Next →</a>{% endif %}</nav></section>{% endblock %}
