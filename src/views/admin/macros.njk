{% macro appointmentTable(rows, label="Appointments") %}<div class="owner-table-wrap" tabindex="0" role="region" aria-label="{{ label }} table"><table class="owner-table"><caption class="sr-only">{{ label }}</caption><thead><tr><th>Appointment</th><th>Client & style</th><th>Status</th><th>Balance</th><th><span class="sr-only">Open appointment</span></th></tr></thead><tbody>{% for row in rows %}<tr><td><strong>{{ row.booking.startAt | et('ccc, LLL d') }}</strong><span>{{ row.booking.startAt | et('h:mm a') }} ET</span></td><td><strong>{{ row.client.name }}</strong><span>{{ row.booking.ref }}</span></td><td><span class="owner-badge status-{{ row.booking.status }}">{{ row.booking.status | replace('_',' ') }}</span></td><td><strong>{{ row.booking.balanceCents | money }}</strong><span>{{ row.booking.paymentStatus | replace('_',' ') }}</span></td><td><a class="owner-text-link" href="/admin/bookings/{{ row.booking.id }}">View<span class="sr-only"> {{ row.booking.ref }}</span> ↗</a></td></tr>{% else %}<tr><td colspan="5" class="owner-empty">No appointments to show.</td></tr>{% endfor %}</tbody></table></div>{% endmacro %}
