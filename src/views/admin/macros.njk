{% macro appointmentTable(rows, label="Appointments") %}<div class="owner-table-wrap" tabindex="0" role="region" aria-label="{{ label }} table"><table class="owner-table"><caption class="sr-only">{{ label }}</caption><thead><tr><th>Appointment</th><th>Client</th><th>Style &amp; option</th><th>Payment source</th><th>Status</th><th>Balance</th><th><span class="sr-only">Open appointment</span></th></tr></thead><tbody>{% for row in rows %}<tr><td><strong>{{ row.booking.startAt | et('ccc, LLL d') }}</strong><span>{{ row.booking.startAt | et('h:mm a') }} ET</span></td><td><strong>{{ row.client.name }}</strong></td><td><strong>{{ row.styleName }}</strong><span>{{ row.styleOption }}</span></td><td><strong>{{ row.paymentSource }}</strong></td><td><span class="owner-badge status-{{ row.booking.status }}">{% if row.booking.status == 'pending_payment' %}Pending{% else %}{{ row.booking.status | replace('_',' ') }}{% endif %}</span>{% if row.paymentReview %}<span>{% if row.booking.status == 'confirmed' %}Balance payment awaiting review{% else %}Awaiting payment approval{% endif %}</span>{% elif row.booking.status == 'pending_payment' %}<span>Awaiting payment</span>{% endif %}</td><td><strong>{{ row.booking.balanceCents | money }}</strong><span>{{ row.booking.paymentStatus | replace('_',' ') }}</span></td><td><a class="owner-text-link" href="/admin/bookings/{{ row.booking.id }}">View<span class="sr-only"> {{ row.booking.ref }}</span> ↗</a></td></tr>{% else %}<tr><td colspan="7" class="owner-empty">No appointments to show.</td></tr>{% endfor %}</tbody></table></div>{% endmacro %}