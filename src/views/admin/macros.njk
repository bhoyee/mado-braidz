{% macro appointmentTable(rows, label="Appointments") %}<div class="owner-table-wrap owner-table-cards" tabindex="0" role="region" aria-label="{{ label }} table"><table class="owner-table" role="table"><caption class="sr-only">{{ label }}</caption><thead role="rowgroup"><tr role="row"><th role="columnheader">Appointment</th><th role="columnheader">Client</th><th role="columnheader">Style &amp; option</th><th role="columnheader">Payment source</th><th role="columnheader">Status</th><th role="columnheader">Balance</th><th role="columnheader"><span class="sr-only">Open appointment</span></th></tr></thead><tbody role="rowgroup">{% for row in rows %}<tr role="row" data-search="{{ [row.client.name, row.client.phoneE164, row.client.email, row.styleName, row.styleOption, row.paymentSource, row.booking.ref, row.booking.status, row.booking.startAt | et('cccc LLLL d h:mm a')] | join(' ') | lower }}"><td role="cell" data-label="Appointment"><strong>{{ row.booking.startAt | et('ccc, LLL d') }}</strong><span>{{ row.booking.startAt | et('h:mm a') }} – {{ row.booking.endAt | et('h:mm a') }} ET</span></td><td role="cell" data-label="Client"><strong>{{ row.client.name }}</strong>{% if row.client.phoneE164 %}<a class="owner-phone" href="tel:{{ row.client.phoneE164 }}">{{ row.client.phoneE164 | phone }}</a>{% endif %}</td><td role="cell" data-label="Style"><strong>{{ row.styleName }}</strong><span>{{ row.styleOption }}</span></td><td role="cell" data-label="Payment source"><strong>{{ row.paymentSource }}</strong></td><td role="cell" data-label="Status"><span class="owner-badge status-{{ row.booking.status }}">{% if row.booking.status == 'pending_payment' %}Pending{% else %}{{ row.booking.status | replace('_',' ') }}{% endif %}</span>{% if row.paymentReview %}<span class="pay-wait">{% if row.booking.status == 'confirmed' %}Balance payment awaiting review{% else %}Awaiting payment approval{% endif %}</span>{% elif row.booking.status == 'pending_payment' %}<span class="pay-due">Awaiting payment</span>{% endif %}</td><td role="cell" data-label="Balance">{% set open = row.booking.status in ['pending_payment','confirmed','completed'] %}{% if open %}<strong class="{% if row.booking.balanceCents > 0 %}pay-due{% else %}pay-good{% endif %}">{{ row.booking.balanceCents | money }}</strong><span>of {{ row.booking.subtotalCents | money }}</span><span class="{% if row.paymentReview %}pay-wait{% elif row.booking.paymentStatus in ['deposit_paid','paid_in_full'] %}pay-good{% elif row.booking.paymentStatus == 'unpaid' %}pay-due{% endif %}">{% if row.paymentReview %}awaiting verification{% else %}{{ row.booking.paymentStatus | replace('_',' ') }}{% endif %}</span>{% else %}<strong>—</strong><span>{% if row.booking.paidCents > 0 %}{{ row.booking.paidCents | money }} paid{% else %}nothing due{% endif %}</span>{% endif %}</td><td role="cell" class="owner-row-action"><a class="owner-view-link{% if row.paymentReview %} owner-view-review{% endif %}" href="/admin/bookings/{{ row.booking.id }}{% if row.paymentReview %}#payment-review{% endif %}">{% if row.paymentReview %}Review{% else %}View{% endif %}<span class="sr-only"> {{ row.booking.ref }}</span> <span class="owner-view-arrow" aria-hidden="true">→</span></a></td></tr>{% else %}<tr><td colspan="7" class="owner-empty">No appointments to show.</td></tr>{% endfor %}</tbody></table></div><button type="button" class="owner-scroll-hint" data-scroll-hint hidden>Scroll for more <span aria-hidden="true">↓</span></button>{% endmacro %}