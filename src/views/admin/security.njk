{% extends "layouts/admin.njk" %}
{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">Keeping it safe</p><h1>Settings.</h1><p>Your password and who can sign in.</p></div></header>
{% set settingsTab = 'security' %}{% include "admin/manage/settings-tabs.njk" %}
<div class="owner-columns"><section class="owner-panel" aria-labelledby="owner-password-heading"><h2 id="owner-password-heading">Change your password</h2><p class="owner-muted">At least 12 characters. Changing it signs you out on every device.</p><form action="/admin/security" method="post" class="owner-form" data-owner-form data-password-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="action" value="password"><p class="owner-error" role="alert" data-owner-form-error hidden></p><label>Current password<input name="password" type="password" autocomplete="current-password" required maxlength="128"></label><label>New password<input name="newPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="128" data-new-password aria-describedby="password-hint"></label><p id="password-hint" class="owner-muted" role="status" data-password-hint>Four or more random words work well.</p><label>New password again<input type="password" autocomplete="new-password" required maxlength="128" data-password-again></label><label class="owner-check"><input type="checkbox" data-password-show><span>Show passwords</span></label>{% if enabled %}<label>Authenticator code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label>{% endif %}<button class="button" type="submit">Update password</button></form></section>
<div><section class="owner-panel"><h2>Who can sign in</h2><ul class="away-list">{% for person in owners %}<li><div><strong>{{ person.name }}{% if person.id == admin.id %} (you){% endif %}</strong><span class="owner-muted">{{ person.email }}</span><span class="owner-muted">{% if person.lastLoginAt %}Last signed in {{ person.lastLoginAt | et }} ET{% else %}Has not signed in yet{% endif %}</span></div></li>{% else %}<li class="owner-muted">{{ admin.email }}</li>{% endfor %}</ul><p class="owner-muted">Ask your website support to add or remove an owner.</p></section>
<section class="owner-panel"><h2>Signed in somewhere else?</h2><p class="owner-muted">Lost a phone, or used a shared computer? This signs you out everywhere, including here.</p><form action="/admin/security/sign-out" method="post" data-owner-form data-confirm="Sign out on every device?" data-confirm-detail="You will need your password to sign in again." data-confirm-label="Sign out everywhere"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="button outline" type="submit">Sign out everywhere</button></form></section></div></div><script defer src="/build/admin-settings.js"></script>
{% endblock %}
