{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Owner access</p><h1>Keep your studio <em>secure.</em></h1><p>Security changes sign you out on every device.</p></div></header><div class="owner-columns"><section class="owner-panel"><h2>Change password</h2><form action="/admin/security" method="post" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="action" value="password"><label>Current password<input name="password" type="password" autocomplete="current-password" required maxlength="128"></label><label>New password<input name="newPassword" type="password" autocomplete="new-password" required minlength="12" maxlength="128"></label>{% if enabled %}<label>Authenticator code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label>{% endif %}<button class="button">Update password</button></form></section><section class="owner-panel"><h2>Two-factor authentication</h2><p class="owner-muted">{% if enabled %}Enabled. A six-digit authenticator code is required at sign-in.{% else %}Optional extra protection using an authenticator app. Add a new account with this setup key, then enter its code to enable.{% endif %}</p>{% if not enabled %}<p class="owner-secret">{{ secret }}</p><p class="owner-muted">Account: {{ admin.email }}<br>Type: time-based, 6 digits, 30 seconds.</p>{% endif %}<form action="/admin/security" method="post" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="action" value="{% if enabled %}disable{% else %}enable{% endif %}"><label>Current password<input name="password" type="password" autocomplete="current-password" required maxlength="128"></label><label>Authenticator code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label><button class="button {% if enabled %}outline{% endif %}">{% if enabled %}Disable{% else %}Enable{% endif %} two-factor</button></form></section></div>{% endblock %}
