{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Zelle & Cash App</p><h1>Appointments.</h1><p>Verify receipt in your payment account before approving a transfer.</p></div></header>{% set appointmentTab = "reviews" %}{% include "admin/appointment-tabs.njk" %}{% for row in rows %}<article class="owner-panel"><div class="owner-section-heading"><h2>{{ row.method | payMethod }} · {{ row.amountCents | money }}</h2><a href="/admin/bookings/{{ row.booking.id }}">{{ row.booking.ref }} ↗</a></div><p>{{ row.booking.startAt | et }} · {{ row.paymentType | title }} · {{ row.booking.status | replace('_',' ') }}</p><a class="owner-text-link" href="/admin/payment-reviews/{{ row.id }}/image" target="_blank" rel="noopener">View private payment proof ↗</a><form action="/admin/payment-reviews/{{ row.id }}" method="post" class="owner-form" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><label>Review note<textarea name="note" maxlength="1000" rows="2"></textarea></label><div class="owner-actions"><button class="button" name="decision" value="approve">Approve verified receipt</button><button class="button outline" name="decision" value="reject">Reject proof</button></div></form></article>{% else %}<section class="owner-panel"><h2>All caught up.</h2><p class="owner-muted">No payments awaiting review.</p></section>{% endfor %}{% endblock %}
