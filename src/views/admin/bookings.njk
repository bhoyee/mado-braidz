{% extends "layouts/admin.njk" %}{% from "admin/macros.njk" import appointmentTable %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Your appointment book</p><h1>Appointments.</h1><p>Find a client, check a balance, make a change.</p><p class="owner-live" data-live-status>Live</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header>{% include "admin/appointment-tabs.njk" %}
<nav class="appointment-views" aria-label="Appointment views" data-live="views">{% for item in views %}<a href="/admin/bookings?view={{ item.key }}" {% if view == item.key %}aria-current="page"{% endif %}>{{ item.label }}{% if item.count !== undefined %} <span class="appointment-view-count{% if item.key == 'review' and item.count %} is-waiting{% endif %}">{{ item.count }}</span>{% endif %}</a>{% endfor %}</nav>
<form method="get" class="owner-filters appointment-filters" data-appointment-filters>{% if filters.view %}<input type="hidden" name="view" value="{{ filters.view }}">{% endif %}{% if filters.order %}<input type="hidden" name="order" value="{{ filters.order }}">{% endif %}{% if filters.upcoming %}<input type="hidden" name="upcoming" value="{{ filters.upcoming }}">{% endif %}{% if filters.live %}<input type="hidden" name="live" value="{{ filters.live }}">{% endif %}<label class="owner-search">Search<input type="search" autocomplete="off" name="search" value="{{ filters.search }}" placeholder="Name, phone, email or reference" maxlength="120"></label><details class="appointment-more" data-appointment-more open><summary>Filters</summary><div><label>From<input type="date" name="from" value="{{ filters.from }}"></label><label>To<input type="date" name="to" value="{{ filters.to }}"></label><label>Appointment status<select name="status"><option value="">All statuses</option>{% for state in ['pending_payment','confirmed','completed','cancelled','no_show','expired','payment_conflict'] %}<option value="{{ state }}" {% if filters.status == state %}selected{% endif %}>{{ state | replace('_',' ') | title }}</option>{% endfor %}</select></label><label>Payment<select name="paymentStatus"><option value="">All payments</option>{% for state in ['unpaid','deposit_paid','paid_in_full','refunded','partially_refunded'] %}<option value="{{ state }}" {% if filters.paymentStatus == state %}selected{% endif %}>{{ state | replace('_',' ') | title }}</option>{% endfor %}</select></label></div></details><button class="button" type="submit">Find appointments</button><a class="appointment-clear" data-appointment-clear href="/admin/bookings" {% if not (filters.search or filters.from or filters.to or filters.status or filters.paymentStatus) %}hidden{% endif %}>Clear search and filters</a></form>
<p class="owner-muted" data-appointment-search-status role="status" aria-live="polite"></p><section class="owner-panel" data-appointment-results data-live="appointments"><div class="owner-section-heading"><h2>{{ viewLabel }}</h2><a href="/admin/bookings/export?{{ exportQuery }}">Export CSV ↓</a></div>{{ appointmentTable(rows) }}{% if not rows.length and view != 'all' %}<p class="owner-muted appointment-search-all"><a class="owner-text-link" href="/admin/bookings?view=all{% if filters.search %}&amp;search={{ filters.search | urlencode }}{% endif %}">Look in all appointments →</a></p>{% endif %}<nav class="owner-pagination" aria-label="Appointment pages">{% if page > 1 %}<a href="{{ previous }}">← Previous</a>{% endif %}{% if total %}<span>{{ firstRow }}–{{ lastRow }} of {{ total }}</span>{% endif %}{% if hasNext %}<a href="{{ next }}">Next →</a>{% endif %}</nav></section><script defer src="/build/admin-live.js"></script>{% endblock %}
