{% extends "layouts/admin.njk" %}{% from "admin/macros.njk" import appointmentTable %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">Your appointment book</p><h1>Appointments.</h1><p>Find a client, check a balance, make a change.</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header>{% include "admin/appointment-tabs.njk" %}
<form method="get" class="owner-filters" data-appointment-filters>{% if filters.order %}<input type="hidden" name="order" value="{{ filters.order }}">{% endif %}{% if filters.upcoming %}<input type="hidden" name="upcoming" value="{{ filters.upcoming }}">{% endif %}{% if filters.live %}<input type="hidden" name="live" value="{{ filters.live }}">{% endif %}<label class="owner-search">Search<input type="search" autocomplete="off" name="search" value="{{ filters.search }}" placeholder="Name, phone, email or reference" maxlength="120"></label><label>From<input type="date" name="from" value="{{ filters.from }}"></label><label>To<input type="date" name="to" value="{{ filters.to }}"></label><label>Appointment status<select name="status"><option value="">All statuses</option>{% for state in ['pending_payment','confirmed','completed','cancelled','no_show','expired','payment_conflict'] %}<option value="{{ state }}" {% if filters.status == state %}selected{% endif %}>{{ state | replace('_',' ') | title }}</option>{% endfor %}</select></label><label>Payment<select name="paymentStatus"><option value="">All payments</option>{% for state in ['unpaid','deposit_paid','paid_in_full','refunded','partially_refunded'] %}<option value="{{ state }}" {% if filters.paymentStatus == state %}selected{% endif %}>{{ state | replace('_',' ') | title }}</option>{% endfor %}</select></label><button class="button" type="submit">Find appointments</button><a href="/admin/bookings">Clear</a></form>
<p class="owner-muted" data-appointment-search-status role="status" aria-live="polite"></p><section class="owner-panel" data-appointment-results><div class="owner-section-heading"><h2>Appointments</h2><a href="/admin/bookings/export?{{ exportQuery }}">Export CSV ↓</a></div>{{ appointmentTable(rows) }}<nav class="owner-pagination" aria-label="Appointment pages">{% if page > 1 %}<a href="{{ previous }}">← Previous</a>{% endif %}<span>Page {{ page }}</span>{% if hasNext %}<a href="{{ next }}">Next →</a>{% endif %}</nav></section>{% endblock %}
