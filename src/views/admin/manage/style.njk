{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,check,area,upload %}{% from "admin/manage/photo-controls.njk" import replacePhoto %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your collection</p><h1>{{ item.name or 'A new style.' }}</h1><p>{% if lastEdit %}Last changed by {{ lastEdit.name }} · {{ lastEdit.at | et }}{% else %}Descriptions, prices and photos, all in one place.{% endif %}</p></div><a class="button outline" href="/admin/styles">All styles</a></header>{% include "admin/manage/style-tabs.njk" %}<form class="owner-panel" action="/admin/styles/save" method="post" data-owner-form>{{ csrf(csrfToken) }}<input type="hidden" name="id" value="{{ item.id }}"><h2>Style details</h2><div class="owner-form-grid">{{ field('name','Style name',item.name,'text',true) }}<label class="owner-field"><span>Category</span><select name="categoryId" required>{% for category in categories %}<option value="{{ category.id }}" {% if category.id==item.categoryId %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></label><label class="owner-field"><span>Appointment duration (hours)</span><input name="durationHours" type="number" min="0.5" max="15" step="any" value="{{ item.durationMin / 60 }}" required><small>For example, 4 = 4 hours; 4.5 = 4 hours 30 minutes.</small></label>{{ field('fromPrice','Consultation “from” price (USD)',item.fromPriceCents / 100 if item.fromPriceCents != null else '') }}</div>{{ area('shortDesc','Short introduction',item.shortDesc) }}{{ area('longDesc','Full description (Markdown supported)',item.longDesc,6) }}<div class="manage-checks">{{ check('active','Published on the website',item.active) }}{{ check('featured','Feature on the home page',item.featured) }}{{ check('priceOnConsultation','Price agreed at consultation (deposit only)',item.priceOnConsultation) }}</div><details class="manage-details"><summary>Search preview</summary>{{ field('seoTitle','Search title',item.seoTitle) }}{{ area('seoDescription','Search description',item.seoDescription) }}</details><p class="owner-muted">Page addresses are created automatically and stay the same when you rename a style. Turn off “Published” to archive a style; its booking history stays intact.</p><button class="button" type="submit">Save style</button></form>
{% if item.id %}<section class="owner-panel"><p class="eyebrow">The price menu</p><h2>Sizes & lengths</h2><p>Prices below apply to new bookings. Turn off “Available to book” to remove an option without deleting its history.</p>{% for variant in itemVariants %}<details class="manage-details"><summary>{{ variant.label or (variant.size | replace('_',' ')) }} · {{ variant.length | replace('_',' ') or 'Standard length' }} <strong>{{ variant.priceCents | money }}</strong>{% if not variant.active %} · Archived{% endif %}</summary>{{ variantForm(variant,item.id,csrfToken) }}</details>{% endfor %}<details class="manage-details" {% if not itemVariants.length %}open{% endif %}><summary>Add a price option</summary>{{ variantForm({},item.id,csrfToken,true) }}</details></section>{{ upload(styles,csrfToken,item.id) }}<section class="owner-panel" id="style-photos"><h2>Style photos</h2><div class="manage-photos">{% for photo in media %}{% if photo.styleId==item.id and photo.kind=='style' %}<article class="manage-style-photo" id="photo-{{ photo.id }}"><img src="{{ photo.path }}" alt="{{ photo.alt }}" width="240" height="300" loading="lazy"><p>{{ photo.alt }}</p>{{ replacePhoto(photo,csrfToken,"style") }}</article>{% endif %}{% endfor %}</div><a class="owner-text-link" href="/admin/gallery">Edit captions and photo order →</a></section>{% endif %}{% endblock %}
{% macro variantForm(v,styleId,token,isNew=false) %}<form action="/admin/styles/{{ styleId }}/variants" method="post" data-owner-form>{{ csrf(token) }}<input type="hidden" name="id" value="{{ v.id }}"><div class="owner-form-grid"><label class="owner-field"><span>Braid size</span><select name="size">{% for value,label in [['','Standard'],['medium','Medium'],['semi_medium','Semi-medium'],['small','Small']] %}<option value="{{ value }}" {% if v.size==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label class="owner-field"><span>Length</span><select name="length">{% for value,label in [['','Standard'],['shoulder','Shoulder'],['mid_back','Mid back'],['waist','Waist'],['top_butt','Top butt'],['butt','Butt'],['under_butt','Under butt']] %}<option value="{{ value }}" {% if v.length==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{{ field('price','Price (USD)',v.priceCents / 100 if v.priceCents != null else '', 'text',true) }}<label class="owner-field"><span>Duration override (hours, optional)</span><input name="durationHours" type="number" min="0.5" max="15" step="any" value="{{ v.durationMin / 60 if v.durationMin != null else '' }}"><small>Leave blank to use the style?s duration.</small></label>{{ field('label','Optional menu label',v.label) }}</div>{{ check('active','Available to book',isNew or v.active) }}<button class="button" type="submit">Save price option</button></form>{% endmacro %}
