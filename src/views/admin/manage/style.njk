{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,check,area %}{% macro durationSelect(name, durations, value, blank='') %}<select {% if name %}name="{{ name }}"{% else %}data-cell-duration{% endif %}>{% if blank %}<option value="">{{ blank }}</option>{% endif %}{% for option in durations %}<option value="{{ option.value }}" {% if option.value == value %}selected{% endif %}>{{ option.label }}</option>{% endfor %}</select>{% endmacro %}
{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your collection</p><h1>{{ item.name or 'A new style.' }}</h1><p>{% if lastEdit %}Last changed by {{ lastEdit.name }} · {{ lastEdit.at | et }} ET{% else %}Details, prices and a photo, saved together.{% endif %}</p></div>{% if item.id %}<div class="owner-actions style-head-actions"><form method="post" action="/admin/styles/{{ item.id }}/duplicate" data-owner-form data-confirm="Duplicate {{ item.name }}?" data-confirm-detail="The details and prices are copied. The copy stays hidden until you publish it." data-confirm-label="Duplicate style">{{ csrf(csrfToken) }}<button class="button outline" type="submit">Duplicate</button></form>{% if item.active %}<a class="button outline" href="/styles/{{ item.slug }}" target="_blank" rel="noopener">View on website ↗</a>{% endif %}</div>{% endif %}</header>
{% if item.id %}<nav class="appointment-views style-sections" aria-label="Style sections">{% for key,label in [['details','Details'],['prices','Prices'],['photos','Photos'],['search','Search preview']] %}<button type="button" data-section="{{ key }}" aria-pressed="{{ 'true' if key == 'details' else 'false' }}">{{ label }}{% if key == 'photos' %} <span class="appointment-view-count">{{ photos.length }}</span>{% endif %}</button>{% endfor %}</nav>{% endif %}
<form class="style-form" action="/admin/styles/save" method="post" data-owner-form data-style-form {% if not item.id %}enctype="multipart/form-data"{% endif %}>{{ csrf(csrfToken) }}<input type="hidden" name="id" value="{{ item.id }}"><input type="hidden" name="prices" data-prices>
<section class="owner-panel" id="style-details" data-panel="details"><h2>Style details</h2><div class="owner-form-grid">{{ field('name','Style name',item.name,'text',true) }}<label class="owner-field"><span>Category</span><select name="categoryId" required>{% for category in categories %}<option value="{{ category.id }}" {% if category.id==item.categoryId %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></label><label class="owner-field"><span>Appointment time</span>{{ durationSelect('durationMin', durations, item.durationMin) }}</label></div>
<div class="owner-field"><label for="short-desc">Short introduction</label><textarea id="short-desc" name="shortDesc" rows="3" maxlength="1000" data-short>{{ item.shortDesc }}</textarea><small>One or two sentences at the top of the style page.</small></div><div class="owner-field"><label for="long-desc">Full description</label><textarea id="long-desc" name="longDesc" rows="6" maxlength="20000" data-long>{{ item.longDesc }}</textarea><small>Leave an empty line between paragraphs. Start a line with a dash for a list.</small></div><p class="style-suggest"><button type="button" class="button outline" data-suggest>Suggest text for empty boxes</button><span class="owner-muted">Read it and change anything before saving.</span></p>
<div class="style-choices"><label class="style-choice"><input type="checkbox" role="switch" name="active" {% if item.active %}checked{% endif %}><span><strong>Published on the website</strong><span>Clients can see and book it. Switch off to hide it; booking history stays.</span></span></label><label class="style-choice"><input type="checkbox" role="switch" name="featured" {% if item.featured %}checked{% endif %}><span><strong>Feature on the home page</strong><span>Adds a published style to Signature styles.</span></span></label></div></section>
<section class="owner-panel" id="style-prices" data-panel="prices"><div class="owner-section-heading"><h2>Prices</h2></div><p class="owner-muted">Prices apply to new bookings. Existing appointments keep theirs.</p><fieldset class="price-mode"><legend class="sr-only">How is this style priced?</legend><label class="payment-choice"><input type="radio" name="priceOnConsultation" value="false" data-consult {% if not item.priceOnConsultation %}checked{% endif %}><span><strong>Set prices</strong><span>Clients choose a size and length and see the price.</span></span></label><label class="payment-choice"><input type="radio" name="priceOnConsultation" value="true" data-consult {% if item.priceOnConsultation %}checked{% endif %}><span><strong>Price on consultation</strong><span>Clients pay the deposit and you agree the final price.</span></span></label></fieldset>
<div data-consult-fields {% if not item.priceOnConsultation %}hidden{% endif %}><label class="owner-field style-from"><span>“From” price shown to clients (USD, optional)</span><input name="fromPrice" inputmode="decimal" maxlength="9" value="{{ (item.fromPriceCents / 100) if item.fromPriceCents != null else '' }}"></label></div>
<div data-grid-fields {% if item.priceOnConsultation %}hidden{% endif %}><div class="price-pick"><fieldset><legend>Sizes you offer</legend><div>{% for size in sizeNames %}<label class="pick"><input type="checkbox" data-size="{{ size.value }}" {% if size.value in usedSizes %}checked{% endif %}><span>{{ size.label }}</span></label>{% endfor %}</div></fieldset><fieldset><legend>Lengths you offer</legend><div>{% for length in lengthNames %}<label class="pick"><input type="checkbox" data-length="{{ length.value }}" {% if length.value in usedLengths %}checked{% endif %}><span>{{ length.label }}</span></label>{% endfor %}</div></fieldset></div>
<div class="price-wrap"><table class="price-grid" data-price-grid><caption class="sr-only">Price for each size and length in US dollars</caption><thead><tr><th scope="col">Length</th>{% for size in sizeNames %}<th scope="col" data-col="{{ size.value }}">{{ size.label }}</th>{% endfor %}</tr></thead><tbody>{% for row in grid %}<tr data-row="{{ row.value }}"><th scope="row">{{ row.label }}</th>{% for cell in row.cells %}{% set v = cell.variant %}<td data-col="{{ cell.size.value }}" data-label="{{ cell.size.label }}" data-cell data-id="{{ v.id if v else '' }}" data-price="{{ (v.priceCents / 100).toFixed(2) if v else '' }}"><div class="price-cell"><span aria-hidden="true">$</span><input inputmode="decimal" maxlength="9" data-cell-price aria-label="{{ cell.size.label }}, {{ row.label }} price" value="{{ (v.priceCents / 100) if v else '' }}" placeholder="—" autocomplete="off"><label class="price-on"><input type="checkbox" data-cell-active {% if v and v.active %}checked{% endif %}><span class="sr-only">Offer {{ cell.size.label }}, {{ row.label }}</span></label></div><span class="price-was" data-cell-was></span><div class="price-more" data-cell-more {% if not ownTimes %}hidden{% endif %}><label><span class="sr-only">{{ cell.size.label }}, {{ row.label }} time</span>{{ durationSelect('', durations, v.durationMin if v else null, 'Usual time') }}</label><label><span class="sr-only">{{ cell.size.label }}, {{ row.label }} label</span><input data-cell-label maxlength="255" placeholder="Label (optional)" value="{{ v.label if v else '' }}"></label></div></td>{% endfor %}</tr>{% endfor %}</tbody></table></div><p class="owner-muted">Leave a box empty if you don’t offer it. Untick a price to stop offering it without losing it.</p><label class="owner-check"><input type="checkbox" data-own-times {% if ownTimes %}checked{% endif %}><span>Some options take a different time or need their own label</span></label>
<div class="price-bulk"><strong>Change all prices</strong><label><span class="sr-only">Raise or lower</span><select data-bulk-sign><option value="1">Raise by</option><option value="-1">Lower by</option></select></label><label><span class="sr-only">Amount</span><input inputmode="decimal" maxlength="7" data-bulk-amount placeholder="10"></label><label><span class="sr-only">Dollars or percent</span><select data-bulk-unit><option value="$">dollars</option><option value="%">percent</option></select></label><button type="button" class="button outline" data-bulk-apply>Preview</button><button type="button" class="owner-text-link" data-bulk-undo hidden>Undo</button><p class="owner-muted" role="status" data-bulk-status>Percent changes round to the nearest dollar. Nothing changes until you save.</p></div></div>
{% if history and history.length %}<details class="history-more price-history"><summary>Price change history</summary><ul class="history-list">{% for change in history %}<li class="history-item"><strong>{{ change.option }}: {% if change.from === null %}added at {{ change.to | money }}{% elif change.from != change.to %}{{ change.from | money }} → {{ change.to | money }}{% endif %}{% if change.switched %} {{ change.switched }}{% endif %}</strong><span class="owner-muted">{{ change.at | et }} ET · {{ change.name }}</span></li>{% endfor %}</ul></details>{% endif %}</section>
{% if not item.id %}<section class="owner-panel" data-panel="photo"><h2>Cover photo</h2><p class="owner-muted">Optional now; you can add more after saving. JPEG, PNG, WebP or AVIF, up to 8 MB.</p><div class="photo-first"><img data-photo-preview alt="Selected photo preview" hidden><div><label class="owner-field"><span>Photo</span><input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif" data-photo-input></label><label class="owner-field"><span>Describe the photo (optional)</span><input name="photoAlt" maxlength="500"></label></div></div></section>{% endif %}
<section class="owner-panel" id="menu-search" data-panel="search"><h2>Search preview</h2><p class="owner-muted">How this style may look on Google. Leave both empty to use the style name and introduction.</p><div class="google-preview" aria-hidden="true"><span>madoafricanbraidz.com › styles › {{ item.slug or 'new-style' }}</span><strong data-preview-title></strong><p data-preview-desc></p></div><div class="owner-field"><label for="seo-title">Search title</label><input id="seo-title" name="seoTitle" maxlength="255" value="{{ item.seoTitle }}" data-count="60"><small data-count-for="seo-title"></small></div><div class="owner-field"><label for="seo-desc">Search description</label><textarea id="seo-desc" name="seoDescription" rows="3" maxlength="500" data-count="160">{{ item.seoDescription }}</textarea><small data-count-for="seo-desc"></small></div><p class="owner-muted">The web address is created automatically and stays the same when you rename a style.</p></section>
<div class="style-save" data-save-bar><p role="status" data-dirty-status>{% if item.id %}All changes saved{% else %}Not saved yet{% endif %}</p><button class="button" type="submit">{% if item.id %}Save changes{% else %}Create style{% endif %}</button></div></form>
{% if item.id %}<section class="owner-panel" data-panel="details"><h2>Delete this style</h2><p class="owner-muted">Only for a style nobody has booked, such as a copy you no longer need. To hide a style from clients, switch off Published instead.</p><form method="post" action="/admin/styles/{{ item.id }}/delete" data-owner-form data-confirm="Delete {{ item.name }}?" data-confirm-detail="Its details and prices are deleted for good and cannot be restored. Its photos stay in your library, hidden. A style that has been booked cannot be deleted." data-confirm-label="Delete style">{{ csrf(csrfToken) }}<button type="submit" class="button owner-danger-button">Delete style</button></form></section>{% endif %}
{% if item.id %}<section class="owner-panel" id="style-photos" data-panel="photos"><div class="owner-section-heading"><h2>Photos</h2><button type="button" class="button" data-owner-modal-open="photo-add">Add photo</button></div><p class="owner-muted">The first photo is the cover. Drag to reorder, or use the arrows. Changes here save straight away.</p>{% if photos.length %}<ul class="style-photos" data-photo-order data-photo-url="/admin/styles/{{ item.id }}/photos">{% for photo in photos %}<li id="photo-{{ photo.id }}" data-photo="{{ photo.id }}" draggable="true"><div class="style-photo-image"><img src="{{ photo.thumb }}" class="{{ photo.focusClass }}" alt="{{ photo.alt }}" width="240" height="300" loading="lazy" draggable="false">{% if photo.hidden %}<span class="owner-badge">Hidden</span>{% elif photo.cover %}<span class="owner-badge status-confirmed">Cover</span>{% endif %}{% if photo.variants.size %}<span class="owner-badge">{{ [photo.variants.size] | optionLabel }} size</span>{% endif %}</div><p>{{ photo.alt }}</p><div class="style-photo-tools"><button type="button" data-photo-shift="-1" aria-label="Move {{ photo.alt }} earlier" {% if loop.first %}disabled{% endif %}>←</button><button type="button" data-photo-shift="1" aria-label="Move {{ photo.alt }} later" {% if loop.last %}disabled{% endif %}>→</button>{% if not loop.first %}<button type="button" data-photo-cover>Make cover<span class="sr-only">: {{ photo.alt }}</span></button>{% endif %}<button type="button" data-photo-edit data-id="{{ photo.id }}" data-alt="{{ photo.alt }}" data-sort="{{ photo.sort }}" data-work="{{ 'yes' if photo.inWork else '' }}" data-src="{{ photo.thumb }}">Edit<span class="sr-only"> {{ photo.alt }}</span></button></div></li>{% endfor %}</ul>{% else %}<p class="owner-empty">No photos yet. Add one to complete the style page.</p>{% endif %}</section>
<dialog id="photo-add" class="owner-dialog owner-extra-dialog" aria-labelledby="photo-add-title"><header class="owner-extra-heading"><h2 id="photo-add-title">Add a photo</h2><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close">&times;</button></header><p class="owner-muted">JPEG, PNG, WebP or AVIF, up to 8 MB. Photos are resized automatically.</p><form action="/admin/gallery/upload" method="post" enctype="multipart/form-data" data-owner-form>{{ csrf(csrfToken) }}<input type="hidden" name="styleId" value="{{ item.id }}"><input type="hidden" name="placementFields" value="1"><input type="hidden" name="showOnStyle" value="on"><input type="hidden" name="sort" value="9999"><input type="hidden" name="returnTo" value="style"><p class="owner-error" role="alert" data-owner-form-error hidden></p><img class="photo-preview" data-photo-preview alt="Selected photo preview" hidden><label class="owner-field"><span>Photo</span><input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif" required data-photo-input></label><label class="owner-field"><span>Describe the photo for visitors</span><input name="alt" required minlength="3" maxlength="500" value="{{ item.name }} hairstyle"></label><label class="owner-check"><input type="checkbox" name="showInWork"><span>Also show in Our Work</span></label><div class="owner-actions owner-extra-actions"><button type="button" class="button outline" data-owner-modal-close>Cancel</button><button class="button" type="submit">Upload photo</button></div></form></dialog>
<dialog id="photo-edit" class="owner-dialog owner-extra-dialog" aria-labelledby="photo-edit-title"><header class="owner-extra-heading"><h2 id="photo-edit-title">Edit photo</h2><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close">&times;</button></header><img class="photo-preview" data-edit-image alt=""><form method="post" data-owner-form data-edit-form>{{ csrf(csrfToken) }}<input type="hidden" name="sort"><input type="hidden" name="styleId" value="{{ item.id }}"><input type="hidden" name="placementFields" value="1"><input type="hidden" name="showOnStyle" value="on"><input type="hidden" name="returnTo" value="style"><input type="hidden" name="returnStyle" value="{{ item.id }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><label class="owner-field"><span>Description for visitors</span><input name="alt" required minlength="3" maxlength="500"></label><label class="owner-check"><input type="checkbox" name="showInWork"><span>Also show in Our Work</span></label><button class="button" type="submit">Save description</button></form><form class="photo-swap" method="post" enctype="multipart/form-data" data-owner-form data-replace-form>{{ csrf(csrfToken) }}<input type="hidden" name="returnTo" value="style"><p class="owner-error" role="alert" data-owner-form-error hidden></p><label class="owner-field"><span>Replace with another image</span><input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif" required data-photo-input data-preview-into="edit"></label><button class="button outline" type="submit">Replace photo</button></form><form class="photo-swap" method="post" data-owner-form data-remove-form data-confirm="Remove this photo?" data-confirm-detail="Only this photo is removed. The style, prices and booking history stay saved." data-confirm-label="Remove photo">{{ csrf(csrfToken) }}<input type="hidden" name="returnTo" value="style"><input type="hidden" name="returnStyle" value="{{ item.id }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><button class="button outline appointment-cancel" type="submit">Remove photo</button></form></dialog>{% endif %}<script defer src="/build/admin-styles.js"></script>{% endblock %}
