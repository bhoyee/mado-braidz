{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Getting paid</p><h1>Settings.</h1><p>Deposits and the ways clients can pay.</p></div></header>{% set settingsTab = "payments" %}{% include "admin/manage/settings-tabs.njk" %}
<form class="settings-form" action="/admin/settings/payments" method="post" data-owner-form data-settings-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><section class="owner-panel"><h2>Deposit</h2><div class="owner-form-grid"><label class="owner-field"><span>Booking deposit (USD)</span><input name="deposit" inputmode="decimal" value="{{ (settings.booking.depositCents / 100).toFixed(2) if settings.booking.depositCents % 100 else settings.booking.depositCents / 100 }}" required maxlength="9" data-deposit></label><label class="owner-field"><span>Hold the chair while a client pays by card</span><select name="holdMinutes">{% for minutes in holdChoices %}<option value="{{ minutes }}" {% if minutes == settings.booking.holdMinutes %}selected{% endif %}>{{ minutes }} minutes</option>{% endfor %}</select></label></div><p class="client-preview"><strong>Clients will read:</strong> <span data-deposit-preview></span></p><p class="owner-muted">Applies to new bookings. Existing appointments keep their agreed amounts.</p></section>
<section class="owner-panel"><h2>Paying the deposit</h2><p class="owner-muted">Switching one off affects new bookings only. Anyone who already booked can still finish.</p><div class="style-choices"><div class="style-choice"><span><strong>Card</strong><span>Always on. Confirms the booking by itself.</span></span></div>{{ toggle('depositZelle','Zelle','You approve each payment.',settings.depositOptions.zelle != false) }}{{ toggle('depositCashapp','Cash App','You approve each payment.',settings.depositOptions.cashapp != false) }}</div></section>
<section class="owner-panel"><h2>Paying a balance</h2><div class="style-choices">{{ toggle('balanceOnline','Card online','',settings.balanceOptions.online != false) }}{{ toggle('balanceCash','Cash at the studio','',settings.balanceOptions.cash != false) }}{{ toggle('balanceZelle','Zelle','',settings.balanceOptions.zelle != false) }}{{ toggle('balanceCashapp','Cash App','',settings.balanceOptions.cashapp != false) }}{{ toggle('balanceTerminal','Card at the studio','',settings.balanceOptions.terminal != false) }}</div></section>
<section class="owner-panel"><h2>Where the money goes</h2><dl class="owner-facts"><div><dt>Name</dt><dd>{{ recipients.name }}</dd></div><div><dt>Zelle</dt><dd>{{ recipients.zelle or 'Not set up' }}</dd></div><div><dt>Cash App</dt><dd>{{ recipients.cashapp or 'Not set up' }}</dd></div><div><dt>Cards</dt><dd>Stripe, {{ stripeMode }} mode</dd></div></dl><p class="owner-muted">Check these are right. For safety they can only be changed by your website support, so nobody who signs in here can redirect your money.</p></section>{{ saveBar('Save payments') }}</form><script defer src="/build/admin-settings.js"></script>{% endblock %}
