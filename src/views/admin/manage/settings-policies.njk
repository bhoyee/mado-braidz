{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your rules</p><h1>Settings.</h1><p>Used on the Policies page, in booking and in emails.</p></div></header>{% set settingsTab = "policies" %}{% include "admin/manage/settings-tabs.njk" %}
<form class="settings-form" action="/admin/settings/policies" method="post" data-owner-form data-settings-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><section class="owner-panel"><h2>Changes and refunds</h2><div class="owner-form-grid"><label class="owner-field"><span>Notice needed to reschedule (hours)</span><input name="rescheduleHours" type="number" min="0" max="168" value="{{ settings.policy.rescheduleHours }}" required data-policy></label><label class="owner-field"><span>Free reschedules</span><input name="freeReschedules" type="number" min="0" max="10" value="{{ settings.policy.freeReschedules }}" required data-policy></label></div><p class="owner-muted">These two are wording only. Clients call to reschedule, and you decide.</p><div class="style-choices">{{ toggle('depositRefundable','Deposit may be refunded','When off, clients are told it is non-refundable.',settings.policy.depositRefundable) }}</div><div class="client-preview"><strong>Clients will read:</strong><ul data-policy-preview data-deposit-cents="{{ settings.booking.depositCents }}"></ul></div></section>
<section class="owner-panel"><h2>Your own policy text</h2>{{ area('policyText','Added at the end of the Policies page',settings.policy.text,8) }}<p class="owner-muted">Leave an empty line between paragraphs. <a class="owner-text-link" href="/policies" target="_blank" rel="noopener">See the Policies page ↗</a></p></section>{{ saveBar('Save policies') }}</form><script defer src="/build/admin-settings.js"></script>{% endblock %}
