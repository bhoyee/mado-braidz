{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Keep every link working</p><h1>Page redirects.</h1><p>Send visitors from an old page address to its replacement. Style address changes create redirects automatically.</p></div></header><form class="owner-panel" action="/admin/redirects" method="post" data-owner-form>{{ csrf(csrfToken) }}<h2>Add a permanent redirect</h2><div class="owner-form-grid">{{ field('source','Old path (for example /old-braids)','','text',true) }}{{ field('target','New path (for example /styles/knotless-braids)','','text',true) }}</div><button class="button" type="submit">Save redirect</button></form><section class="owner-panel"><h2>Current redirects</h2>{% for item in redirects %}<div class="manage-list-row"><p><strong>{{ item.source }}</strong> → {{ item.target }}</p><form method="post" action="/admin/redirects/{{ item.id }}/remove" data-owner-form data-confirm="Remove this redirect?">{{ csrf(csrfToken) }}<button class="button outline" type="submit">Remove</button></form></div>{% else %}<p class="owner-muted">No redirects yet.</p>{% endfor %}</section>{% endblock %}
