{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,area %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Client profile</p><h1>{{ client.name }}</h1><p>{{ client.email }} · {{ client.phoneE164 }}</p></div></header>{% set spent=0 %}{% for visit in visits %}{% set spent=spent+visit.paidCents %}{% endfor %}<section class="owner-panel"><div class="manage-client-facts"><div><span>Recorded payments</span><strong>{{ spent | money }}</strong></div><div><span>Appointments</span><strong>{{ visits.length }}</strong></div><div><span>Marketing</span><strong>{% if client.marketingConsent and not client.unsubscribedAt %}Opted in{% else %}Not subscribed{% endif %}</strong></div></div><p class="owner-muted">Marketing consent comes from the client. Private notes do not change their consent.</p></section><form class="owner-panel" method="post" action="/admin/clients/{{ client.id }}" data-owner-form>{{ csrf(csrfToken) }}<h2>Private notes</h2>{{ area('notes','Preferences and notes for the studio',client.notes,5) }}<button class="button" type="submit">Save notes</button></form><section class="owner-panel"><h2>Visit history</h2>{% for visit in visits %}<a class="manage-list-row" href="/admin/bookings/{{ visit.id }}"><div><strong>{{ visit.startAt | et }}</strong><p>{{ visit.ref }} · {{ visit.priceSnapshot.styleName or 'Appointment' }} · {{ visit.status | replace('_',' ') }}</p></div><strong>{{ visit.paidCents | money }} paid</strong></a>{% else %}<p>No visits yet.</p>{% endfor %}<h2>Return-visit emails</h2><p class="owner-muted">Email delivery is not enabled yet. Current scheduled messages are shown below.</p>{% for job in winbacks %}<p>{{ job.type }} · {{ job.status }} · {{ job.runAt | et }}</p>{% else %}<p class="owner-muted">No return-visit messages scheduled.</p>{% endfor %}</section>{% endblock %}
