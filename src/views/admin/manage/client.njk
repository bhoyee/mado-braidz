{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf %}{% block content %}{% set first = name.split(' ')[0] %}<header class="owner-page-head client-head"><div><p class="eyebrow">Client profile</p><h1>{{ name }}</h1>{% if removed %}<p>Personal details were removed. Visits and payments are kept for your records.</p>{% else %}<p>{{ phone | phone }} · {{ email }}</p><div class="client-tags">{% if repeat %}<span class="photo-tag is-cover">Repeat client</span>{% endif %}{% if isNew %}<span class="photo-tag">New this month</span>{% endif %}{% if lapsed %}<span class="photo-tag is-warn">Not seen in 90 days</span>{% endif %}{% if noShows %}<span class="photo-tag is-warn">{{ noShows }} no-show{% if noShows > 1 %}s{% endif %}</span>{% endif %}{% for tag in tags %}<span class="photo-tag">{{ tag }}</span>{% endfor %}</div>{% endif %}</div>{% if not removed %}<div class="owner-actions"><button type="button" class="button outline" data-owner-modal-open="client-edit">Edit details</button><a class="button" href="/admin/bookings/new?client={{ id }}">Book again</a></div>{% endif %}</header>
{% if not removed %}<div class="appointment-quick" role="group" aria-label="Contact {{ name }}">{% if phone %}<a class="button outline" href="tel:{{ phone }}">Call</a><a class="button outline" href="https://wa.me/{{ phone | replace('+','') }}?text={{ ('Hi ' + first + ', this is Mado African Braids.') | urlencode }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}<a class="button outline" href="mailto:{{ email }}">Email</a></div>{% endif %}
{% for other in matches %}<section class="owner-panel client-match"><div><h2>Is this the same person?</h2><p><strong>{{ other.name }}</strong> · {{ other.email }} shares a phone number. {{ other.visitCount }} visit{% if other.visitCount != 1 %}s{% endif %}. <a class="owner-text-link" href="/admin/clients/{{ other.id }}">Open →</a></p></div><div class="owner-actions"><form method="post" action="/admin/clients/{{ id }}/join" data-owner-form data-confirm="Join {{ name }} and {{ other.name }}?" data-confirm-detail="Their visits, notes and totals show together. You can undo this." data-confirm-label="Join clients">{{ csrf(csrfToken) }}<input type="hidden" name="other" value="{{ other.id }}"><button class="button" type="submit">Join as one client</button></form><form method="post" action="/admin/clients/{{ id }}/apart" data-owner-form>{{ csrf(csrfToken) }}<input type="hidden" name="other" value="{{ other.id }}"><button class="button outline" type="submit">Keep apart</button></form></div></section>{% endfor %}
<div class="overview-metrics client-cards"><div class="overview-metric"><span class="overview-metric-label">Visits</span><strong>{{ visitCount }}</strong><span class="overview-metric-foot">{{ completed }} completed</span></div><div class="overview-metric"><span class="overview-metric-label">Total paid</span><strong>{{ spentCents | money }}</strong><span class="overview-metric-foot">After recorded refunds</span></div><div class="overview-metric{% if balanceCents > 0 %} overview-metric-balance{% endif %}"><span class="overview-metric-label">Balance</span><strong>{{ balanceCents | money }}</strong><span class="overview-metric-foot">{% if balanceCents > 0 %}To collect{% else %}Nothing owed{% endif %}</span></div><div class="overview-metric"><span class="overview-metric-label">Favourite style</span><strong class="client-style">{{ favourite or '—' }}</strong><span class="overview-metric-foot">{% if firstVisit %}Since {{ firstVisit | et('LLL yyyy') }}{% else %}No visits yet{% endif %}</span></div></div>
<div class="owner-columns"><div>{% if nextVisit %}<section class="owner-panel client-next"><p class="eyebrow">Next visit</p><h2>{{ nextVisit.startAt | et('cccc, LLLL d') }}</h2><p>{{ nextVisit.startAt | et('h:mm a') }} – {{ nextVisit.endAt | et('h:mm a') }} ET · {{ nextVisit.styleName }}{% if nextVisit.option != 'Standard service' %} · {{ nextVisit.option }}{% endif %}</p><a class="owner-view-link" href="/admin/bookings/{{ nextVisit.id }}">Open appointment <span class="owner-view-arrow" aria-hidden="true">→</span></a></section>{% endif %}
<section class="owner-panel"><h2>Visit history</h2><div class="client-scroll is-visits" tabindex="0" role="region" aria-label="Visit history"><ul class="client-visits">{% for visit in visits %}<li><a class="client-visit" href="/admin/bookings/{{ visit.id }}"><span><strong>{{ visit.startAt | et('LLL d, yyyy') }}</strong><span>{{ visit.startAt | et('h:mm a') }} ET</span></span><span><strong>{{ visit.styleName }}</strong><span>{% if visit.option != 'Standard service' %}{{ visit.option }}{% else %}{{ visit.ref }}{% endif %}</span></span><span class="owner-badge status-{{ visit.status }}">{{ 'Pending' if visit.status == 'pending_payment' else visit.status | replace('_',' ') }}</span><span class="client-visit-paid"><strong>{{ visit.paidCents | money }}</strong><span>{% if visit.status in ['confirmed','completed'] and visit.balanceCents > 0 %}<span class="pay-due">{{ visit.balanceCents | money }} due</span>{% else %}paid{% endif %}</span></span><span class="owner-view-arrow" aria-hidden="true">→</span></a></li>{% else %}<li class="owner-empty">No visits yet.</li>{% endfor %}</ul></div><button type="button" class="owner-scroll-hint" data-scroll-hint hidden>Scroll for more <span aria-hidden="true">↓</span></button></section>
<section class="owner-panel"><h2>Emails sent</h2><div class="client-scroll" tabindex="0" role="region" aria-label="Emails sent"><ul class="history-list">{% for item in emails %}<li class="history-item history-email"><strong>{{ item.template | emailName }}</strong><span class="owner-muted">{{ item.createdAt | et }} ET · {{ item.status | title }}</span></li>{% else %}<li class="owner-muted">No emails sent yet.</li>{% endfor %}</ul></div><button type="button" class="owner-scroll-hint" data-scroll-hint hidden>Scroll for more <span aria-hidden="true">↓</span></button></section>
<section class="owner-panel"><h2>Changes</h2><div class="client-scroll" tabindex="0" role="region" aria-label="Changes"><ul class="history-list">{% for item in history %}<li class="history-item"><strong>{{ changeNames[item.action] or 'Updated' }}</strong><span class="owner-muted">{{ item.createdAt | et }} ET · {{ item.by }}</span>{% if item.action == 'edit' %}{% for key,label in [['name','Name'],['email','Email'],['phone','Phone']] %}{% if item.before[key] != item.after[key] %}<span class="history-change">{{ label }}: {{ item.before[key] }} → {{ item.after[key] }}</span>{% endif %}{% endfor %}{% endif %}</li>{% else %}<li class="owner-muted">No changes yet.</li>{% endfor %}</ul></div><button type="button" class="owner-scroll-hint" data-scroll-hint hidden>Scroll for more <span aria-hidden="true">↓</span></button></section></div>
<div>{% if not removed %}<section class="owner-panel"><h2>Notes &amp; preferences</h2><form method="post" action="/admin/clients/{{ id }}/notes" class="owner-form" data-owner-form data-client-notes>{{ csrf(csrfToken) }}<input type="hidden" name="tags" data-tags-field value="{{ tags | dump | escape }}"><fieldset class="client-tag-pick"><legend>Tags</legend><div>{% for tag in tagChoices %}<label class="pick"><input type="checkbox" data-tag value="{{ tag }}" {% if tag in tags %}checked{% endif %}><span>{{ tag }}</span></label>{% endfor %}</div></fieldset><label>Add your own tag<input maxlength="30" data-tag-new placeholder="Press Enter to add"></label><label>Private notes, only for the studio<textarea name="notes" rows="5" maxlength="5000" data-live-guard>{{ notes }}</textarea></label><p class="owner-muted">Shown on all of this client’s appointments.</p><button class="button" type="submit">Save notes</button></form></section>
<section class="owner-panel"><h2>Contact</h2><dl class="owner-facts"><div><dt>Phone</dt><dd>{{ phone | phone }}</dd></div><div><dt>Email</dt><dd>{{ email }}</dd></div>{% if otherEmails.length %}<div><dt>Also used</dt><dd>{{ otherEmails | join(', ') }}</dd></div>{% endif %}{% if otherPhones.length %}<div><dt>Other phone</dt><dd>{% for number in otherPhones %}{{ number | phone }}{% if not loop.last %}, {% endif %}{% endfor %}</dd></div>{% endif %}<div><dt>First seen</dt><dd>{{ since | et('LLL d, yyyy') }}</dd></div></dl></section>
<section class="owner-panel"><h2>Salon news</h2><p>{% if news %}<span class="photo-tag is-cover">Opted in</span>{% elif unsubscribed %}<span class="photo-tag">Unsubscribed</span>{% else %}<span class="photo-tag">Not opted in</span>{% endif %}</p><p class="owner-muted">Only the client can opt in, when booking. Appointment emails are always sent.</p>{% if winbacks.length %}<p class="owner-muted">{{ winbacks.length }} “come back” message{% if winbacks.length != 1 %}s{% endif %} waiting.</p>{% endif %}{% if news %}<form method="post" action="/admin/clients/{{ id }}/stop-news" data-owner-form data-confirm="Stop salon news for {{ name }}?" data-confirm-detail="They can opt in again when they book." data-confirm-label="Stop news">{{ csrf(csrfToken) }}<button class="button outline" type="submit">Stop salon news</button></form>{% endif %}</section>
{% if joined.length %}<section class="owner-panel"><h2>Joined records</h2>{% for pair in joined %}<div class="owner-list-line"><p>{{ pair.names | join(' and ') }}</p><form method="post" action="/admin/clients/{{ id }}/unjoin" data-owner-form>{{ csrf(csrfToken) }}<input type="hidden" name="pair" value="{{ pair.pair }}"><button class="button outline" type="submit">Undo join</button></form></div>{% endfor %}</section>{% endif %}
<section class="owner-panel client-remove"><h2>Remove personal details</h2><p class="owner-muted">For a privacy request. Name, contact details, notes and private photos go for good. Dates and amounts stay for your records.</p><button type="button" class="button outline appointment-cancel" data-owner-modal-open="client-remove">Remove personal details</button></section>{% endif %}</div></div>
{% if not removed %}<dialog id="client-edit" class="owner-dialog action-dialog" aria-labelledby="client-edit-title"><header class="owner-extra-heading"><h2 id="client-edit-title">Edit details</h2><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close">&times;</button></header><p class="owner-muted">Used for all of this client’s visits, including reminders for upcoming ones.</p><form method="post" action="/admin/clients/{{ id }}/details" class="owner-form" data-owner-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><label>Full name<input name="name" value="{{ name }}" required minlength="2" maxlength="120" autocomplete="off"></label><label>Email<input type="email" name="email" value="{{ email }}" required maxlength="255" autocomplete="off"></label><label>US phone number<input type="tel" name="phone" value="{{ phone }}" required maxlength="32" autocomplete="off"></label>{% if nextVisit %}<p class="appointment-blocked">There is a visit on {{ nextVisit.startAt | et('LLL d') }}. Check the email and phone carefully.</p>{% endif %}<div class="owner-actions"><button class="button" type="submit">Save details</button><button type="button" class="button outline" data-owner-modal-close>Cancel</button></div></form></dialog>
<dialog id="client-remove" class="owner-dialog action-dialog" aria-labelledby="client-remove-title"><header class="owner-extra-heading"><h2 id="client-remove-title">Remove {{ first }}’s details?</h2><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close">&times;</button></header><p><strong>This cannot be undone.</strong> {{ visits.length }} booking{% if visits.length != 1 %}s{% endif %} will show “Removed client”. Stripe, your email inbox and WhatsApp keep their own copies.</p><form method="post" action="/admin/clients/{{ id }}/remove" class="owner-form" data-owner-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><label>Type REMOVE to confirm<input name="confirm" required pattern="REMOVE" autocomplete="off" autocapitalize="characters"></label><div class="owner-actions"><button class="button owner-danger-button" type="submit">Remove personal details</button><button type="button" class="button outline" data-owner-modal-close>Go back</button></div></form></dialog>{% endif %}<script defer src="/build/admin-clients.js"></script>{% endblock %}
