{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">The collection</p><h1>Styles & prices.</h1><p>Keep your menu current. Existing appointments keep their agreed prices.</p></div><a class="button" href="/admin/styles/new">Add a style</a></header>{% include "admin/manage/style-tabs.njk" %}<div class="manage-style-grid">{% for item in styles %}<article class="owner-panel manage-style"><p class="eyebrow">{% for category in categories %}{% if category.id==item.categoryId %}{{ category.name }}{% endif %}{% endfor %}</p><h2><a href="/admin/styles/{{ item.id }}">{{ item.name }}</a></h2><p>{{ item.durationMin }} minutes · {% if item.active %}Published{% else %}Archived{% endif %}{% if item.featured %} · Featured{% endif %}</p><p class="owner-muted">{% if item.priceOnConsultation %}Price on consultation{% else %}{% set count=0 %}{% for variant in variants %}{% if variant.styleId==item.id and variant.active %}{% set count=count+1 %}{% endif %}{% endfor %}{{ count }} active size / length options{% endif %}</p><a class="owner-text-link" href="/admin/styles/{{ item.id }}">Edit style, prices & photos →</a></article>{% endfor %}</div>{% endblock %}
