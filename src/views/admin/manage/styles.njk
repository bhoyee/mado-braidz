{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">The collection</p><h1>Styles & prices.</h1><p>Keep your menu current. Existing appointments keep their agreed prices.</p></div><div class="owner-actions"><button type="button" class="button outline" data-owner-modal-open="categories-dialog">Categories</button><a class="button" href="/admin/styles/new">Add a style</a></div></header>{% include "admin/manage/style-tabs.njk" %}
<div class="style-tools" data-style-tools><label class="menu-search"><span class="sr-only">Search styles</span><input type="search" placeholder="Search by name or category" autocomplete="off" maxlength="60" data-style-search></label><div class="appointment-views" role="group" aria-label="Show styles">{% for key,label in [['all','All'],['published','Published'],['hidden','Hidden'],['featured','Featured'],['attention','Needs attention']] %}<button type="button" data-style-view="{{ key }}" aria-pressed="{{ 'true' if key == 'all' else 'false' }}">{{ label }} <span class="appointment-view-count" data-style-count="{{ key }}"></span></button>{% endfor %}</div><button type="button" class="button outline" data-order-start>Change order</button></div>
<div class="style-order-bar" data-order-bar hidden><p>Drag a style, or use the arrows. This is the order on the website and in booking.</p><div class="owner-actions"><button type="button" class="button outline" data-order-cancel>Cancel</button><button type="button" class="button" data-order-save>Save order</button></div></div><p class="owner-muted" role="status" data-style-status></p>
<ul class="style-list" data-order-list data-order-url="/admin/styles/reorder">{% for item in styles %}<li class="style-row" data-order-id="{{ item.id }}" data-text="{{ [item.name, item.category] | join(' ') | lower }}" data-published="{{ 'yes' if item.active else 'no' }}" data-featured="{{ 'yes' if item.featured else 'no' }}" data-attention="{{ 'yes' if item.issues.length else 'no' }}"><span class="order-arrows" hidden><button type="button" data-order-move="-1" aria-label="Move {{ item.name }} up">↑</button><button type="button" data-order-move="1" aria-label="Move {{ item.name }} down">↓</button></span><a class="style-thumb" href="/admin/styles/{{ item.id }}" tabindex="-1" aria-hidden="true">{% if item.photo %}<img src="{{ item.photo.path }}" alt="" width="72" height="90" loading="lazy" draggable="false">{% else %}<span>No photo</span>{% endif %}</a><div class="style-main"><h2><a href="/admin/styles/{{ item.id }}">{{ item.name }}</a></h2><p class="owner-muted">{{ item.category }} · {{ item.duration }}</p>{% if item.issues.length %}<p class="style-issues">{{ item.issues | join(' · ') }}</p>{% endif %}</div><div class="menu-price">{% if item.priceOnConsultation %}<strong>{% if item.fromPriceCents %}From {{ item.fromPriceCents | money }}{% else %}Consultation{% endif %}</strong><span class="owner-muted menu-consult">Price on consultation</span>{% elif item.low !== null %}<strong>{{ item.low | money }}{% if item.high != item.low %} – {{ item.high | money }}{% endif %}</strong><span class="owner-muted">{{ item.optionCount }} price{% if item.optionCount != 1 %}s{% endif %}</span>{% else %}<strong class="pay-due">No price</strong>{% endif %}</div><div class="style-switches"><label class="mini-switch"><input type="checkbox" role="switch" data-flag="active" data-flag-url="/admin/styles/{{ item.id }}/flags" {% if item.active %}checked{% endif %}><span>Published<span class="sr-only">: {{ item.name }}</span></span></label><label class="mini-switch"><input type="checkbox" role="switch" data-flag="featured" data-flag-url="/admin/styles/{{ item.id }}/flags" {% if item.featured %}checked{% endif %}><span>Featured<span class="sr-only">: {{ item.name }}</span></span></label></div><div class="style-links"><a class="owner-view-link" href="/admin/styles/{{ item.id }}">Edit<span class="sr-only"> {{ item.name }}</span> <span class="owner-view-arrow" aria-hidden="true">→</span></a><a class="owner-text-link" data-public-link href="/styles/{{ item.slug }}" target="_blank" rel="noopener" {% if not item.active %}hidden{% endif %}>View on website<span class="sr-only">: {{ item.name }}</span> ↗</a><form method="post" action="/admin/styles/{{ item.id }}/duplicate" data-owner-form data-confirm="Duplicate {{ item.name }}?" data-confirm-detail="The details and prices are copied. The copy stays hidden until you publish it." data-confirm-label="Duplicate style">{{ csrf(csrfToken) }}<button type="submit" class="owner-text-link">Duplicate<span class="sr-only"> {{ item.name }}</span></button></form></div></li>{% endfor %}</ul><nav class="style-pages" data-style-pages aria-label="Style pages" hidden><button type="button" data-page-step="-1">← Previous</button><span class="style-page-numbers" data-page-numbers></span><span class="owner-muted" data-page-range role="status"></span><button type="button" data-page-step="1">Next →</button></nav><p class="owner-empty" data-style-empty hidden>No styles match. Try another word or tab.</p>
<dialog id="categories-dialog" class="owner-dialog owner-extra-dialog" aria-labelledby="categories-title"><header class="owner-extra-heading"><div><p class="eyebrow">Organise the menu</p><h2 id="categories-title">Categories</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close categories">&times;</button></header><p class="owner-muted">Clients use these to filter styles. Web addresses stay the same when you rename one.</p><ul class="category-list">{% for category in categories %}<li><form method="post" action="/admin/styles/categories" data-owner-form class="category-form">{{ csrf(csrfToken) }}<input type="hidden" name="id" value="{{ category.id }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><label><span class="sr-only">Category name</span><input name="name" value="{{ category.name }}" maxlength="40" required></label><span class="owner-muted">{{ category.count }} style{% if category.count != 1 %}s{% endif %}</span><button class="button outline" type="submit">Rename<span class="sr-only"> {{ category.name }}</span></button></form>{% if not category.count %}<form method="post" action="/admin/styles/categories/{{ category.id }}/remove" data-owner-form>{{ csrf(csrfToken) }}<button class="owner-text-link" type="submit">Remove {{ category.name }}</button></form>{% endif %}</li>{% endfor %}</ul><form method="post" action="/admin/styles/categories" data-owner-form class="category-form category-new">{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><label>New category<input name="name" maxlength="40" required></label><button class="button" type="submit">Add category</button></form></dialog><script defer src="/build/admin-styles.js"></script>{% endblock %}
