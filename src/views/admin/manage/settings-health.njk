{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Is everything working?</p><h1>Settings.</h1><p>What the website can check for itself, just now.</p></div></header>{% set settingsTab = "health" %}{% include "admin/manage/settings-tabs.njk" %}
<section class="owner-panel"><ul class="health-list">{% for item in checks %}<li class="health-{{ item.state }}"><span class="photo-tag {% if item.state == 'good' %}is-cover{% elif item.state == 'bad' %}is-warn{% endif %}">{{ {good:'Working',bad:'Needs attention',info:'For information'}[item.state] }}</span><div><strong>{{ item.name }}</strong><p class="owner-muted">{{ item.text }}</p></div></li>{% endfor %}</ul><p class="owner-muted">Backups run on the hosting and cannot be checked from here. Ask your website support if you are unsure.</p></section><script defer src="/build/admin-settings.js"></script>{% endblock %}
