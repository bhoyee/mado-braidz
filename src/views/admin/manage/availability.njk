{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,check %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your working week</p><h1>Availability.</h1><p>All times are Eastern. Three chairs, with starts every 30 minutes.</p></div></header><form class="owner-panel" action="/admin/availability" method="post" data-owner-form>{{ csrf(csrfToken) }}<h2>Weekly opening hours</h2><p class="owner-muted">Changes affect future availability. Existing appointments are kept, even if they fall outside new hours.</p>{% for day in ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'] %}<div class="manage-hours"><strong>{{ day | capitalize }}</strong>{{ field(day+'Open','Opens',settings.hours.weekly[day].open,'time',true) }}{{ field(day+'Close','Closes',settings.hours.weekly[day].close,'time',true) }}{{ check(day+'Closed','Closed',settings.hours.weekly[day].closed) }}</div>{% endfor %}<h2>Booking rules</h2><div class="owner-form-grid">{{ field('bufferMinutes','Buffer between appointments (minutes)',settings.booking.bufferMinutes,'number',true) }}{{ field('minNoticeHours','Minimum advance notice (hours)',settings.booking.minNoticeHours,'number',true) }}{{ field('maxAdvanceDays','Book up to this many days ahead',settings.booking.maxAdvanceDays,'number',true) }}</div><button class="button" type="submit">Save availability</button></form><form class="owner-panel" action="/admin/availability/blocks" method="post" data-owner-form>{{ csrf(csrfToken) }}<h2>Reserve time away</h2><p>Blocks close all three chairs. Existing appointments must be moved first.</p><div class="owner-form-grid">{{ field('date','Date','','date',true) }}{{ field('start','From','','time',true) }}{{ field('end','Until','','time',true) }}{{ field('reason','Reason (private)') }}<label class="owner-field"><span>Repeat</span><select name="repeat"><option value="once">Just this date</option><option value="weekly">Every week on this day</option></select></label>{{ field('until','Repeat through (weekly only)','','date') }}</div><button class="button" type="submit">Block this time</button></form><section class="owner-panel"><h2>Upcoming blocked times</h2>{% for block in blocks %}<form method="post" action="/admin/availability/blocks/{{ block.id }}/remove" data-owner-form data-confirm="Remove this blocked time?" class="manage-list-row">{{ csrf(csrfToken) }}<div><strong>{{ block.startAt | et }}</strong><p>Until {{ block.endAt | et('h:mm a') }} · {{ block.reason or 'Time away' }}{% if block.repeatRule %} · Weekly{% endif %}</p>{% if block.repeatRule %}{{ check('series','Remove the entire repeating series') }}{% endif %}</div><button class="button outline" type="submit">Remove</button></form>{% else %}<p class="owner-muted">No upcoming blocked times.</p>{% endfor %}</section>{% endblock %}
