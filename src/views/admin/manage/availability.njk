{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your working week</p><h1>Settings.</h1><p>All times are Eastern. Three chairs, with starts every 30 minutes.</p></div></header>{% set settingsTab = "hours" %}{% include "admin/manage/settings-tabs.njk" %}
<form class="settings-form" action="/admin/availability" method="post" data-owner-form data-settings-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><section class="owner-panel"><div class="owner-section-heading"><h2>Weekly opening hours</h2><button type="button" class="button outline" data-copy-hours>Copy Monday to every day</button></div><p class="owner-muted">Existing appointments stay booked. You are warned if any fall outside the new hours.</p>{% for day in ['monday','tuesday','wednesday','thursday','friday','saturday','sunday'] %}<div class="hours-row" data-hours-row="{{ day }}"><strong>{{ day | capitalize }}</strong><label class="mini-switch"><input type="checkbox" role="switch" data-open-switch {% if not settings.hours.weekly[day].closed %}checked{% endif %}><span>Open<span class="sr-only"> on {{ day | capitalize }}</span></span></label><input type="hidden" name="{{ day }}Closed" value="{{ 'true' if settings.hours.weekly[day].closed else 'false' }}" data-closed><label class="owner-field" data-hours-times><span>Opens</span><input type="time" name="{{ day }}Open" value="{{ settings.hours.weekly[day].open or '09:00' }}" step="1800" required></label><label class="owner-field" data-hours-times><span>Closes</span><input type="time" name="{{ day }}Close" value="{{ settings.hours.weekly[day].close or '18:00' }}" step="1800" required></label><span class="owner-muted" data-hours-closed hidden>Closed all day</span></div>{% endfor %}</section>
<section class="owner-panel"><h2>Booking rules</h2><div class="owner-form-grid"><label class="owner-field"><span>Gap between appointments (minutes)</span><input name="bufferMinutes" type="number" min="0" max="180" value="{{ settings.booking.bufferMinutes }}" required></label><label class="owner-field"><span>Shortest notice for online booking (hours)</span><input name="minNoticeHours" type="number" min="0" max="168" value="{{ settings.booking.minNoticeHours }}" required></label><label class="owner-field"><span>How far ahead clients can book (days)</span><input name="maxAdvanceDays" type="number" min="1" max="365" value="{{ settings.booking.maxAdvanceDays }}" required></label></div></section>{{ saveBar('Save opening hours') }}</form><script defer src="/build/admin-settings.js"></script>{% endblock %}
