{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Away from the studio</p><h1>Settings.</h1><p>Holidays, short days and time off.</p></div></header>{% set settingsTab = "timeoff" %}{% include "admin/manage/settings-tabs.njk" %}
<section class="owner-panel"><h2>Special days</h2><p class="owner-muted">One date that differs from your normal week, such as a holiday or an early finish. Clients see it on the website.</p><form class="settings-inline" action="/admin/time-off/special" method="post" data-owner-form data-special-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><div class="owner-form-grid"><label class="owner-field"><span>Date</span><input name="date" type="date" min="{{ today }}" required></label><label class="owner-field"><span>Name clients see (optional)</span><input name="note" maxlength="60" placeholder="Thanksgiving"></label></div><label class="owner-check"><input type="checkbox" name="closed" checked data-special-closed><span>Closed all day</span></label><div class="owner-form-grid" data-special-times hidden><label class="owner-field"><span>Opens</span><input name="open" type="time" step="1800" value="09:00"></label><label class="owner-field"><span>Closes</span><input name="close" type="time" step="1800" value="14:00"></label></div><button class="button" type="submit">Save special day</button></form><ul class="away-list">{% for day in specialDays %}<li><div><strong>{{ day.label }}</strong><span class="owner-muted">{{ day.text }}{% if day.note %} · {{ day.note }}{% endif %}</span></div><form method="post" action="/admin/time-off/special/remove" data-owner-form data-confirm="Remove this special day?" data-confirm-detail="Your normal hours apply again on {{ day.label }}." data-confirm-label="Remove">{{ csrf(csrfToken) }}<input type="hidden" name="date" value="{{ day.date }}"><button class="button outline" type="submit">Remove<span class="sr-only"> {{ day.label }}</span></button></form></li>{% else %}<li class="owner-muted">No special days coming up.</li>{% endfor %}</ul></section>
<section class="owner-panel"><h2>Block time off</h2><p class="owner-muted">Closes all three chairs. The reason stays private. Move any appointments in that time first.</p><form class="settings-inline" action="/admin/availability/blocks" method="post" data-owner-form data-block-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><div class="owner-form-grid"><label class="owner-field"><span>First day</span><input name="date" type="date" min="{{ today }}" required></label><label class="owner-field" data-block-last><span>Last day (optional)</span><input name="endDate" type="date" min="{{ today }}"></label></div><label class="owner-check"><input type="checkbox" name="allDay" checked data-all-day><span>All day</span></label><div class="owner-form-grid" data-block-times hidden><label class="owner-field"><span>From</span><input name="start" type="time"></label><label class="owner-field"><span>Until</span><input name="end" type="time"></label></div><div class="owner-form-grid"><label class="owner-field"><span>Reason (private)</span><input name="reason" maxlength="500"></label><label class="owner-field"><span>Repeat</span><select name="repeat" data-block-repeat><option value="once">Does not repeat</option><option value="weekly">Every week on this day</option></select></label><label class="owner-field" data-block-until hidden><span>Repeat until</span><input name="until" type="date" min="{{ today }}"></label></div><button class="button" type="submit">Block this time</button></form><h3>Blocked times coming up</h3><ul class="away-list">{% for block in blockGroups %}<li><div><strong>{{ block.label }}</strong><span class="owner-muted">{{ block.detail }}{% if block.reason %} · {{ block.reason }}{% endif %}</span></div><form method="post" action="/admin/availability/blocks/{{ block.id }}/remove" data-owner-form data-confirm="Remove this blocked time?" data-confirm-detail="{{ block.label }} opens for booking again." data-confirm-label="Remove">{{ csrf(csrfToken) }}<input type="hidden" name="returnTo" value="time-off">{% if block.weekly %}<label class="owner-check"><input type="checkbox" name="series"><span>All weeks</span></label>{% elif block.range %}<input type="hidden" name="series" value="true">{% endif %}<button class="button outline" type="submit">Remove<span class="sr-only"> {{ block.label }}</span></button></form></li>{% else %}<li class="owner-muted">Nothing blocked.</li>{% endfor %}</ul></section>
<script defer src="/build/admin-settings.js"></script>{% endblock %}
