{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your people</p><h1>Clients.</h1><p>Visits, preferences and private notes.</p></div></header><form method="get" class="owner-panel manage-search"><label class="owner-field"><span>Find a client by name, email or phone</span><input name="search" value="{{ search }}" maxlength="120" type="search"></label><button class="button" type="submit">Search</button></form><section class="owner-panel"><div class="owner-table-wrap" tabindex="0" role="region" aria-label="Clients"><table class="owner-table"><thead><tr><th>Name</th><th>Email / phone</th><th>Marketing</th><th>Profile</th></tr></thead><tbody>{% for client in rows %}<tr><td><strong>{{ client.name }}</strong></td><td>{{ client.email }}<span>{{ client.phoneE164 }}</span></td><td>{% if client.marketingConsent and not client.unsubscribedAt %}Opted in{% else %}Not subscribed{% endif %}</td><td><a href="/admin/clients/{{ client.id }}">View <span class="sr-only">{{ client.name }}</span> →</a></td></tr>{% else %}<tr><td colspan="4">No clients found.</td></tr>{% endfor %}</tbody></table></div><div class="owner-actions">{% if page>1 %}<a href="?page={{ page-1 }}&search={{ search | urlencode }}">Previous</a>{% endif %}{% if hasNext %}<a href="?page={{ page+1 }}&search={{ search | urlencode }}">Next</a>{% endif %}</div></section>{% endblock %}
