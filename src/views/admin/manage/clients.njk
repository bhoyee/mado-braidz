{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your people</p><h1>Clients.</h1><p>One entry per person, with every visit together.</p><p class="owner-live" data-live-status>Live</p></div><a class="button" href="/admin/bookings/new">New appointment</a></header>
<div class="overview-metrics client-cards" data-live="client-cards">{% for view,label,value,foot in [['all','Total clients',cards.total,'People who have booked'],['repeat','Repeat clients',cards.repeat,cards.repeatPercent ~ '% of all clients'],['new','New this month',cards.fresh,'First booking this month'],['lapsed','Not seen in 90 days',cards.lapsed,'Nothing booked ahead']] %}<a class="overview-metric{% if view == 'repeat' %} client-card-repeat{% endif %}" href="/admin/clients?view={{ view }}"><span class="overview-metric-label">{{ label }}</span><strong>{{ value }}</strong><span class="overview-metric-foot">{{ foot }} <span aria-hidden="true">↗</span></span></a>{% endfor %}</div>
<form method="get" class="style-tools" data-client-filters><input type="hidden" name="view" value="{{ filter.view }}"><label class="menu-search"><span class="sr-only">Search clients</span><input type="search" name="search" value="{{ filter.search }}" placeholder="Search name, phone, email or tag" autocomplete="off" maxlength="80"></label><label class="library-style-pick"><span class="sr-only">Sort clients</span><select name="sort">{% for key,label in sorts %}<option value="{{ key }}" {% if filter.sort == key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><button class="button" type="submit" data-client-submit>Search</button></form>
<nav class="appointment-views" aria-label="Client groups" data-live="client-views">{% for key,label in views %}<a href="/admin/clients?view={{ key }}" {% if filter.view == key %}aria-current="page"{% endif %}>{{ label }} <span class="appointment-view-count{% if key == 'match' and counts[key] %} is-waiting{% endif %}">{{ counts[key] }}</span></a>{% endfor %}</nav>
<p class="owner-muted" role="status" data-client-status></p><section class="owner-panel" data-client-results data-live="clients"><div class="owner-section-heading"><h2>{{ viewLabel }}</h2><a href="/admin/clients/export?{{ exportQuery }}">Export CSV ↓</a></div>{% if filter.view == 'match' %}<p class="owner-muted">These people share a phone number but have different names and emails. Open one to join them or keep them apart.</p>{% elif filter.view == 'unbooked' %}<p class="owner-muted">They started a booking but never confirmed one.</p>{% endif %}<ul class="client-list">{% for p in rows %}<li class="client-row"><a class="client-row-link" href="/admin/clients/{{ p.id }}"><span class="client-avatar" aria-hidden="true">{{ p.name | first | upper }}</span><span class="client-who"><strong>{{ p.name }}</strong><span>{{ p.phone | phone }}</span><span class="client-email">{{ p.email }}</span></span><span class="client-tags">{% if p.repeat %}<span class="photo-tag is-cover">Repeat</span>{% endif %}{% if p.isNew %}<span class="photo-tag">New</span>{% endif %}{% if p.noShows %}<span class="photo-tag is-warn">{{ p.noShows }} no-show{% if p.noShows > 1 %}s{% endif %}</span>{% endif %}{% if p.possible.length %}<span class="photo-tag is-warn">Possible match</span>{% endif %}{% for tag in p.tags %}<span class="photo-tag">{{ tag }}</span>{% endfor %}</span><span class="client-fact"><span>Visits</span><strong>{{ p.visitCount }}</strong></span><span class="client-fact"><span>{% if p.nextVisit %}Next visit{% else %}Last visit{% endif %}</span><strong>{% if p.nextVisit %}{{ p.nextVisit.startAt | et('LLL d, yyyy') }}{% elif p.lastVisit %}{{ p.lastVisit | et('LLL d, yyyy') }}{% else %}—{% endif %}</strong></span><span class="client-fact"><span>Paid</span><strong>{{ p.spentCents | money }}</strong></span><span class="client-fact"><span>Balance</span><strong class="{% if p.balanceCents > 0 %}pay-due{% else %}pay-good{% endif %}">{{ p.balanceCents | money }}</strong></span><span class="owner-view-link" aria-hidden="true">View <span class="owner-view-arrow">→</span></span></a></li>{% else %}<li class="owner-empty">No clients here.{% if filter.search and filter.view != 'all' %} <a class="owner-text-link" href="/admin/clients?view=all&amp;search={{ filter.search | urlencode }}">Look in all clients →</a>{% endif %}</li>{% endfor %}</ul><nav class="owner-pagination" aria-label="Client pages">{% if page > 1 %}<a href="{{ previous }}">← Previous</a>{% endif %}{% if total %}<span>{{ first + 1 }}–{{ first + rows.length }} of {{ total }}</span>{% endif %}{% if hasNext %}<a href="{{ next }}">Next →</a>{% endif %}</nav></section><script defer src="/build/admin-live.js"></script><script defer src="/build/admin-clients.js"></script>{% endblock %}
