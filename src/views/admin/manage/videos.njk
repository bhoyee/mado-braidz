{% from "admin/manage/macros.njk" import csrf,field,check,area %}
<section id="library-videos" aria-label="Video library" hidden>
<p class="owner-muted">Short clips from the studio. Hide a video to take it off the website; publish it again whenever you’re ready.</p>
<div class="library-grid">
{% for video in videos %}
<article class="library-card" data-video-id="{{ video.id }}" data-video-title="{{ video.title }}" data-video-description="{{ video.description }}" data-video-enabled="{{ video.enabled }}" data-video-work="{{ video.showInWork }}">
<div class="library-video-preview"><video controls playsinline preload="none" poster="{{ video.poster }}" aria-label="{{ video.description }}"><source src="{{ video.src }}" type="video/mp4"></video><span class="library-video-status {% if not video.enabled %}is-hidden{% endif %}">{% if video.enabled %}Published{% else %}Hidden{% endif %}</span></div>
<div class="library-card-body"><h2>{{ video.title }}</h2><p>{{ video.locations | join(' · ') or 'Not placed on a page' }}{% if video.durationSec %} · {{ video.durationSec | round }} sec{% endif %}</p><div class="library-video-actions"><button class="button outline" type="button" data-manage-video>Manage video<span class="sr-only">: {{ video.title }}</span></button><form method="post" action="/admin/gallery/videos/{{ video.id }}" data-owner-form>{{ csrf(csrfToken) }}<input type="hidden" name="title" value="{{ video.title }}"><input type="hidden" name="description" value="{{ video.description }}"><input type="hidden" name="showInWork" value="{{ video.showInWork }}"><input type="hidden" name="enabled" value="{{ not video.enabled }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><button class="button {% if video.enabled %}outline{% endif %}" type="submit">{% if video.enabled %}Hide video{% else %}Publish video{% endif %}<span class="sr-only">: {{ video.title }}</span></button></form></div></div></article>
{% endfor %}
</div></section>

<dialog id="library-video-upload" class="owner-dialog owner-extra-dialog library-dialog" aria-labelledby="video-upload-title"><header class="owner-extra-heading"><div><p class="eyebrow">The studio in motion</p><h2 id="video-upload-title">Add a short video</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close video upload">&times;</button></header><p class="owner-muted">MP4 (H.264) · up to 60 seconds, 30 MB and 1080p.</p>
<form method="post" action="/admin/gallery/videos/upload" enctype="multipart/form-data" data-owner-form data-video-upload-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><label class="library-file"><span>Choose video</span><input type="file" name="video" accept="video/mp4,.mp4" required></label><video class="library-upload-preview" data-video-preview controls playsinline preload="metadata" aria-label="Selected video preview" hidden></video>{{ field('title','Video title','','text',true) }}{{ area('description','Video description') }}<label class="owner-field"><span>Cover image</span><input type="file" name="poster" accept="image/jpeg,image/png,image/webp,image/avif" required></label><p class="owner-muted">A cover is picked from the video automatically. You can choose a different image.</p>{{ check('enabled','Publish on the website',true) }}<input type="hidden" name="showInWork" value="true"><div class="owner-actions owner-extra-actions"><button class="button outline" type="button" data-owner-modal-close>Cancel</button><button class="button" type="submit">Upload video</button></div></form></dialog>

<dialog id="library-video-edit" class="owner-dialog owner-extra-dialog library-dialog" aria-labelledby="video-edit-title"><header class="owner-extra-heading"><div><p class="eyebrow">Video details</p><h2 id="video-edit-title">Manage video</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close video details">&times;</button></header><form method="post" data-owner-form data-video-edit-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p>{{ field('title','Video title','','text',true) }}{{ area('description','Video description') }}{{ check('enabled','Published on the website',true) }}{{ check('showInWork','Include in Our Work',true) }}<p class="owner-muted">Turn off Published to take this video down everywhere it appears. It stays saved in your library.</p><div class="owner-actions owner-extra-actions"><button class="button outline" type="button" data-owner-modal-close>Cancel</button><button class="button" type="submit">Save video</button></div></form></dialog>
