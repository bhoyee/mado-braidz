{% from "admin/manage/macros.njk" import csrf,field,check,area %}
<section id="library-videos" aria-label="Video library" hidden>
<p class="owner-muted">Short clips from the studio. Hide a video to take it off the website; publish it again whenever you’re ready.</p>
<ul class="photo-grid">
{% for video in videos %}
<li id="video-{{ video.id }}" class="photo-card{% if not video.enabled %} is-dim{% endif %}" data-video-id="{{ video.id }}" data-video-title="{{ video.title }}" data-video-description="{{ video.description }}" data-video-src="{{ video.src }}" data-video-poster="{{ video.poster }}" data-video-builtin="{{ 'yes' if video.builtin }}"><button type="button" class="photo-open" data-manage-video><img src="{{ video.poster }}" alt="" width="320" height="400" loading="lazy" draggable="false"><span class="video-play" aria-hidden="true">▶</span><span class="sr-only">Manage video: {{ video.title }}</span></button><div class="photo-info"><strong>{{ video.title }}</strong><p>{% for place in video.locations %}<span class="photo-tag">{{ place }}</span>{% else %}<span class="photo-tag">Not on a page</span>{% endfor %}{% if video.durationSec %}<span class="photo-tag">{{ video.durationSec | round }} sec</span>{% endif %}</p><label class="mini-switch"><input type="checkbox" role="switch" data-video-flag="enabled" {% if video.enabled %}checked{% endif %}><span>Published<span class="sr-only">: {{ video.title }}</span></span></label><label class="mini-switch"><input type="checkbox" role="switch" data-video-flag="showInWork" {% if video.showInWork %}checked{% endif %}><span>Our Work<span class="sr-only">: {{ video.title }}</span></span></label></div></li>
{% endfor %}
</ul></section>

<dialog id="library-video-upload" class="owner-dialog owner-extra-dialog library-dialog" aria-labelledby="video-upload-title"><header class="owner-extra-heading"><div><p class="eyebrow">The studio in motion</p><h2 id="video-upload-title">Add a short video</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close video upload">&times;</button></header><p class="owner-muted">MP4 (H.264) · up to 60 seconds, 30 MB and 1080p.</p>
<form method="post" action="/admin/gallery/videos/upload" enctype="multipart/form-data" data-owner-form data-video-upload-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><label class="library-file"><span>Choose video</span><input type="file" name="video" accept="video/mp4,.mp4" required></label><video class="library-upload-preview" data-video-preview controls playsinline preload="metadata" aria-label="Selected video preview" hidden></video>{{ field('title','Video title','','text',true) }}{{ area('description','Video description') }}<label class="owner-field"><span>Cover image</span><input type="file" name="poster" accept="image/jpeg,image/png,image/webp,image/avif" required></label><p class="owner-muted">A cover is picked from the video automatically. You can choose a different image.</p>{{ check('enabled','Publish on the website',true) }}<input type="hidden" name="showInWork" value="true"><div class="owner-actions owner-extra-actions"><button class="button outline" type="button" data-owner-modal-close>Cancel</button><button class="button" type="submit">Upload video</button></div></form></dialog>

<dialog id="library-video-edit" class="owner-dialog owner-extra-dialog library-dialog" aria-labelledby="video-edit-title"><header class="owner-extra-heading"><div><p class="eyebrow">Video details</p><h2 id="video-edit-title">Manage video</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close video details">&times;</button></header><video class="library-upload-preview" data-edit-video controls playsinline preload="metadata" aria-label="Video"></video><div class="add-tools"><button type="button" data-use-frame>Use this moment as the cover</button><label class="button outline photo-swap-pick">Choose a cover image<input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-cover-file></label></div><p class="owner-muted" role="status" data-cover-status>Pause the video where it looks best, then use that moment.</p><form method="post" data-owner-form data-video-edit-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p>{{ field('title','Video title','','text',true) }}{{ area('description','Video description') }}<input type="hidden" name="enabled"><input type="hidden" name="showInWork"><div class="owner-actions owner-extra-actions"><button class="button outline" type="button" data-owner-modal-close>Cancel</button><button class="button" type="submit">Save video</button></div></form><form class="photo-swap" method="post" data-owner-form data-video-remove data-confirm="Remove this video?" data-confirm-detail="It leaves the website and your library. This cannot be undone." data-confirm-label="Remove video">{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><button class="button outline appointment-cancel" type="submit">Remove video</button></form><p class="owner-muted" data-video-fixed hidden>This video is part of the website. Switch off Published to hide it.</p></dialog>
