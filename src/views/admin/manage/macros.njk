{% macro csrf(token) %}<input type="hidden" name="_csrf" value="{{ token }}">{% endmacro %}
{% macro field(name,label,value='',type='text',required=false) %}<label class="owner-field"><span>{{ label }}</span><input name="{{ name }}" type="{{ type }}" value="{{ value }}" {% if required %}required{% endif %} {% if type=='number' %}min="0" step="1"{% endif %} {% if type=='text' %}maxlength="1000"{% endif %}></label>{% endmacro %}
{% macro check(name,label,value=false) %}<label class="owner-check"><input type="checkbox" name="{{ name }}" {% if value %}checked{% endif %}><span>{{ label }}</span></label>{% endmacro %}
{% macro area(name,label,value='',rows=3) %}<label class="owner-field"><span>{{ label }}</span><textarea name="{{ name }}" rows="{{ rows }}" maxlength="20000">{{ value }}</textarea></label>{% endmacro %}
{% macro styleSelect(styles,value) %}<label class="owner-field"><span>Style</span><select name="styleId"><option value="">No style tag</option>{% for style in styles %}<option value="{{ style.id }}" {% if style.id==value %}selected{% endif %}>{{ style.name }}{% if not style.active %} (archived){% endif %}</option>{% endfor %}</select></label>{% endmacro %}
{% macro upload(styles,token,styleId='') %}<form action="/admin/gallery/upload" method="post" enctype="multipart/form-data" data-owner-form class="owner-panel manage-upload">{{ csrf(token) }}<h2>Add a photo</h2><p class="owner-muted">JPEG, PNG, WebP or AVIF · up to 8 MB. Photos are resized automatically.</p><label class="owner-field"><span>Photo</span><input type="file" name="photo" accept="image/jpeg,image/png,image/webp,image/avif" required></label>{{ field('alt','Describe the photo for visitors', '', 'text',true) }}<div class="owner-form-grid">{{ styleSelect(styles,styleId) }}<fieldset class="owner-field"><legend>Show in</legend><input type="hidden" name="placementFields" value="1"><label class="owner-check"><input type="checkbox" name="showOnStyle" {% if styleId %}checked{% endif %}>Style page</label><label class="owner-check"><input type="checkbox" name="showInWork" {% if not styleId %}checked{% endif %}>Our Work</label><small>Select one or both.</small></fieldset></div><input type="hidden" name="sort" value="0"><button class="button" type="submit">Upload photo</button></form>{% endmacro %}
