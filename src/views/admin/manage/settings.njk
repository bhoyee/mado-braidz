{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Your business</p><h1>Settings.</h1><p>Shown on the website, in emails and on Google.</p></div></header>{% set settingsTab = "studio" %}{% include "admin/manage/settings-tabs.njk" %}
<form class="settings-form" action="/admin/settings/business" method="post" data-owner-form data-settings-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><section class="owner-panel"><h2>Business details</h2><div class="owner-form-grid"><label class="owner-field"><span>Business name</span><input name="name" value="{{ settings.business.name }}" required maxlength="120"><small>Spelled “Mado African Braids” everywhere except the web address.</small></label><label class="owner-field"><span>Phone</span><input name="phone" type="tel" value="{{ settings.business.phone | phone }}" required maxlength="32" autocomplete="off"><small>A US number, such as (443) 743-4979.</small></label>{{ field('street','Street address',settings.business.street,'text',true) }}{{ field('city','City',settings.business.city,'text',true) }}{{ field('region','State',settings.business.region,'text',true) }}{{ field('postalCode','ZIP code',settings.business.postalCode,'text',true) }}</div><p class="owner-muted">All times are Eastern and prices are in US dollars.</p></section>
<section class="owner-panel"><h2>Social links</h2><p class="owner-muted">Leave one empty to hide its icon.</p><div class="owner-form-grid">{% for key,label in [['instagram','Instagram'],['tiktok','TikTok'],['facebook','Facebook'],['google','Google reviews']] %}<label class="owner-field"><span>{{ label }}</span><input name="{{ key }}" type="url" value="{{ settings.business.social[key] }}" placeholder="https://" maxlength="500" data-link><small><a class="owner-text-link" data-link-open target="_blank" rel="noopener" href="{{ settings.business.social[key] or '/admin/settings' }}" {% if not settings.business.social[key] %}hidden{% endif %}>Open to check ↗</a></small></label>{% endfor %}</div></section>{{ saveBar('Save business') }}</form><script defer src="/build/admin-settings.js"></script>{% endblock %}
