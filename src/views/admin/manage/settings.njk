{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,check,area %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Studio details</p><h1>Settings.</h1><p>One source for the information your clients see.</p></div><span class="owner-badge">Stripe · {{ stripeMode }} mode</span></header><form action="/admin/settings" method="post" data-owner-form>{{ csrf(csrfToken) }}<section class="owner-panel"><h2>Business information</h2><div class="owner-form-grid">{{ field('name','Business name',settings.business.name,'text',true) }}{{ field('phone','US phone (+1 and 10 digits)',settings.business.phone,'tel',true) }}{{ field('street','Street address',settings.business.street) }}{{ field('city','City',settings.business.city) }}{{ field('region','State',settings.business.region) }}{{ field('postalCode','ZIP code',settings.business.postalCode) }}</div><p class="owner-muted">Timezone: America/New_York · Currency: USD. Edit opening hours in Availability.</p></section><section class="owner-panel"><h2>Social links</h2><div class="owner-form-grid">{% for key,label in [['instagram','Instagram'],['tiktok','TikTok'],['facebook','Facebook'],['google','Google reviews']] %}{{ field(key,label,settings.business.social[key],'url') }}{% endfor %}</div></section><section class="owner-panel"><h2>Deposit & appointment policy</h2><div class="owner-form-grid">{{ field('deposit','Booking deposit (USD)',settings.booking.depositCents / 100,'text',true) }}{{ field('holdMinutes','Card checkout hold (minutes)',settings.booking.holdMinutes,'number',true) }}{{ field('rescheduleHours','Reschedule notice (hours)',settings.policy.rescheduleHours,'number',true) }}{{ field('freeReschedules','Free reschedules',settings.policy.freeReschedules,'number',true) }}</div>{{ check('depositRefundable','Deposit may be refunded under the studio policy',settings.policy.depositRefundable) }}{{ area('policyText','Additional policy text',settings.policy.text,5) }}<p class="owner-muted">Updated prices and deposit amounts apply to new bookings. Existing appointments keep their agreed totals.</p></section><section class="owner-panel"><h2>Ways to pay a remaining balance</h2><p>These options apply to balance payments. Initial deposit methods stay available.</p>{{ check("balanceOnline","Online card payment",settings.balanceOptions.online != false) }}{{ check("balanceCash","Cash at the studio",settings.balanceOptions.cash != false) }}{{ check("balanceZelle","Zelle transfer",settings.balanceOptions.zelle != false) }}{{ check("balanceCashapp","Cash App transfer",settings.balanceOptions.cashapp != false) }}{{ check("balanceTerminal","Card at the studio",settings.balanceOptions.terminal != false) }}<p class="owner-muted">Transfer destinations and Stripe keys stay in the server environment.</p></section><section class="owner-panel"><h2>Email preferences</h2><p class="owner-muted">Choose when appointment reminders and opted-in return-visit messages are sent. Delivery also requires a verified provider in the server configuration.</p>{{ field('reminderHours','First reminder (hours before)',settings.emails.reminderHours or 48,'number',true) }}{{ check('morningReminder','Send a morning-of reminder',settings.emails.morningReminder) }}{{ check('winback','Enable return-visit messages for opted-in clients',settings.emails.winback) }}{{ area('adminAlertEmails','Owner alert email addresses (comma separated)',settings.emails.adminAlertEmails | join(', ')) }}</section><div class="owner-panel manage-save-bar"><p>Save your studio details and policies.</p><button class="button" type="submit">Save settings</button></div></form>{% endblock %}
