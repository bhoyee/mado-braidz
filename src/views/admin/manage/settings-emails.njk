{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% macro toggle(name,title,text,on) %}<label class="style-choice"><input type="checkbox" role="switch" name="{{ name }}" {% if on %}checked{% endif %}><span><strong>{{ title }}</strong>{% if text %}<span>{{ text }}</span>{% endif %}</span></label>{% endmacro %}{% macro saveBar(label) %}<div class="style-save" data-save-bar><p role="status" data-dirty-status>All changes saved</p><button class="button" type="submit">{{ label }}</button></div>{% endmacro %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Staying in touch</p><h1>Settings.</h1><p>Reminders for clients and alerts for you.</p></div></header>{% set settingsTab = "emails" %}{% include "admin/manage/settings-tabs.njk" %}
<form class="settings-form" action="/admin/settings/emails" method="post" data-owner-form data-settings-form>{{ csrf(csrfToken) }}<p class="owner-error" role="alert" data-owner-form-error hidden></p><section class="owner-panel"><h2>Reminders to clients</h2><div class="owner-form-grid"><label class="owner-field"><span>First reminder</span><select name="reminderHours">{% for value,label in reminderChoices %}<option value="{{ value }}" {% if value == (settings.emails.reminderHours or 48) %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label></div><div class="style-choices">{{ toggle('morningReminder','Reminder on the morning of the visit','',settings.emails.morningReminder) }}{{ toggle('winback','“Come back” messages','Sent 30, 60 and 90 days after a visit, only to clients who opted in.',settings.emails.winback) }}</div></section>
<section class="owner-panel"><h2>Alerts to you</h2><p class="owner-muted">Each address gets an email for new bookings, payments to review and the daily agenda.</p><input type="hidden" name="adminAlertEmails" value="{{ settings.emails.adminAlertEmails | join(', ') }}" data-emails-field><ul class="email-list" data-emails></ul><div class="email-add"><label class="owner-field"><span>Add an email address</span><input type="email" maxlength="255" autocomplete="off" data-email-new></label><button type="button" class="button outline" data-email-add>Add</button></div><p class="owner-muted">If the list is empty, the address saved by your website support is used.</p></section>{{ saveBar('Save emails') }}</form><script defer src="/build/admin-settings.js"></script>{% endblock %}
