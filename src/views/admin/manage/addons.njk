{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,area %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Finish the look</p><h1>Extras.</h1><p>Prices and added time apply to new bookings.</p></div><button type="button" class="button" data-extra-open aria-haspopup="dialog" aria-controls="extra-dialog">Add extra</button></header>{% set styleTab = "extras" %}{% include "admin/manage/style-tabs.njk" %}
{% if addons.length > 1 %}<div class="style-tools"><button type="button" class="button outline" data-order-start>Change order</button></div><div class="style-order-bar" data-order-bar hidden><p>Drag an extra, or use the arrows. Clients see this order when booking.</p><div class="owner-actions"><button type="button" class="button outline" data-order-cancel>Cancel</button><button type="button" class="button" data-order-save>Save order</button></div></div>{% endif %}
<ul class="style-list" data-order-list data-order-url="/admin/addons/reorder">{% for item in addons %}<li id="extra-{{ item.id }}" class="style-row extra-row" data-order-id="{{ item.id }}"><span class="order-arrows" hidden><button type="button" data-order-move="-1" aria-label="Move {{ item.name }} up">↑</button><button type="button" data-order-move="1" aria-label="Move {{ item.name }} down">↓</button></span><div class="style-main"><h2>{{ item.name }}</h2><p class="owner-muted">{{ item.description or 'No description' }}</p></div><div class="menu-price"><strong>{{ item.priceCents | money }}</strong><span class="owner-muted">{{ item.time }}</span></div><div class="extra-styles"><strong>{% if item.appliesToAll %}All styles{% else %}{{ item.styleNames.length }} style{% if item.styleNames.length != 1 %}s{% endif %}{% endif %}</strong>{% if not item.appliesToAll %}<span class="owner-muted">{{ item.styleNames | join(', ') }}</span>{% endif %}</div><div class="style-switches"><label class="mini-switch"><input type="checkbox" role="switch" data-flag="active" data-flag-url="/admin/addons/{{ item.id }}/active" {% if item.active %}checked{% endif %}><span>Available<span class="sr-only">: {{ item.name }}</span></span></label></div><div class="style-links"><button type="button" class="owner-view-link" data-extra-open data-extra="{{ {id:item.id,name:item.name,price:item.priceCents/100,durationMin:item.durationMin,description:item.description or '',active:item.active,appliesToAll:item.appliesToAll,styleIds:item.styleIds} | dump | escape }}">Edit<span class="sr-only"> {{ item.name }}</span> <span class="owner-view-arrow" aria-hidden="true">→</span></button></div></li>{% else %}<li class="owner-empty">No extras yet.</li>{% endfor %}</ul>
<dialog id="extra-dialog" class="owner-dialog owner-extra-dialog extra-dialog" aria-labelledby="extra-title" aria-describedby="extra-description"><header class="owner-extra-heading"><div><p class="eyebrow">Finish the look</p><h2 id="extra-title" data-extra-title>Add an extra</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close extra">&times;</button></header><p id="extra-description" class="owner-muted">Existing appointments keep the price they were booked at.</p><form action="/admin/addons" method="post" data-owner-form data-extra-form>{{ csrf(csrfToken) }}<input type="hidden" name="id"><p class="owner-error" role="alert" data-owner-form-error hidden></p>{{ field('name','Name','','text',true) }}<div class="owner-form-grid"><label class="owner-field"><span>Price (USD)</span><input name="price" inputmode="decimal" maxlength="9" required></label><label class="owner-field"><span>Added time</span><select name="durationMin">{% for option in minutes %}<option value="{{ option.value }}">{{ option.label }}</option>{% endfor %}</select></label></div>{{ area('description','Description (optional)','',2) }}<label class="owner-check"><input type="checkbox" name="active" checked><span>Available to book</span></label><fieldset class="extra-where"><legend>Which styles?</legend><label class="owner-check"><input type="radio" name="appliesToAll" value="true" checked data-extra-all><span>All styles</span></label><label class="owner-check"><input type="radio" name="appliesToAll" value="false" data-extra-all><span>Only these styles</span></label><div class="extra-style-list" data-extra-styles hidden>{% for style in styles %}<label class="owner-check"><input type="checkbox" name="styleIds" value="{{ style.id }}"><span>{{ style.name }}</span></label>{% endfor %}</div></fieldset><div class="owner-actions owner-extra-actions"><button class="button outline" type="button" data-owner-modal-close>Cancel</button><button class="button" type="submit">Save extra</button></div></form></dialog><script defer src="/build/admin-styles.js"></script>{% endblock %}
