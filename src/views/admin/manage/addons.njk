{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,check,area %}{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">Finish the look</p><h1>Extras.</h1><p>Prices and added time apply to new bookings.</p></div><button type="button" class="button" data-owner-modal-open="add-extra-dialog" aria-haspopup="dialog" aria-controls="add-extra-dialog">Add extra</button></header>
{% for item in addons %}<details class="owner-panel manage-details"><summary>{{ item.name }} <strong>{{ item.priceCents | money }}</strong>{% if not item.active %} · Archived{% endif %}</summary>{{ addonForm(item,styles,csrfToken) }}</details>{% endfor %}
<dialog id="add-extra-dialog" class="owner-dialog owner-extra-dialog" aria-labelledby="add-extra-title" aria-describedby="add-extra-description"><header class="owner-extra-heading"><div><p class="eyebrow">Finish the look</p><h2 id="add-extra-title">Add an extra</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close add extra">&times;</button></header><p id="add-extra-description" class="owner-muted">Set the price, added time and styles this extra is available for.</p>{{ addonForm({active:true,appliesToAll:true,durationMin:0,styleIds:[]},styles,csrfToken,true) }}</dialog>
{% endblock %}
{% macro addonForm(item,styles,token,isNew=false) %}<form action="/admin/addons" method="post" data-owner-form>{{ csrf(token) }}<input type="hidden" name="id" value="{{ item.id }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><div class="owner-form-grid">{{ field('name','Name',item.name,'text',true) }}{{ field('slug','Internal name (lowercase words with hyphens)',item.slug,'text',true) }}{{ field('price','Price (USD)',item.priceCents / 100 if item.priceCents != null else '', 'text',true) }}{{ field('durationMin','Extra time (minutes)',item.durationMin,'number',true) }}</div>{{ area('description','Description',item.description) }}{{ check('active','Available to book',item.active) }}{{ check('appliesToAll','Available for every style',item.appliesToAll) }}<details class="manage-details"><summary>Limit to selected styles</summary><p class="owner-muted">Only used when “Available for every style” is off.</p><div class="manage-checks">{% for style in styles %}<label class="owner-check"><input type="checkbox" name="styleIds" value="{{ style.id }}" {% if style.id in item.styleIds %}checked{% endif %}>{{ style.name }}</label>{% endfor %}</div></details><div class="owner-actions owner-extra-actions">{% if isNew %}<button class="button outline" type="button" data-owner-modal-close>Cancel</button>{% endif %}<button class="button" type="submit">Save extra</button></div></form>{% endmacro %}
