{% extends "layouts/admin.njk" %}{% from "admin/manage/macros.njk" import csrf,field,check,area %}{% block content %}<header class="owner-page-head"><div><p class="eyebrow">Finish the look</p><h1>Extras.</h1><p>Prices and added time apply to new bookings.</p></div></header>{% for item in addons %}<details class="owner-panel manage-details"><summary>{{ item.name }} <strong>{{ item.priceCents | money }}</strong>{% if not item.active %} · Archived{% endif %}</summary>{{ addonForm(item,styles,csrfToken) }}</details>{% endfor %}<section class="owner-panel"><h2>Add an extra</h2>{{ addonForm({active:true,appliesToAll:true,durationMin:0,styleIds:[]},styles,csrfToken) }}</section>{% endblock %}
{% macro addonForm(item,styles,token) %}<form action="/admin/addons" method="post" data-owner-form>{{ csrf(token) }}<input type="hidden" name="id" value="{{ item.id }}"><div class="owner-form-grid">{{ field('name','Name',item.name,'text',true) }}{{ field('slug','Internal name (lowercase words with hyphens)',item.slug,'text',true) }}{{ field('price','Price (USD)',item.priceCents / 100 if item.priceCents != null else '', 'text',true) }}{{ field('durationMin','Extra time (minutes)',item.durationMin,'number',true) }}{{ field('sort','Display order',item.sort or 0,'number') }}</div>{{ area('description','Description',item.description) }}{{ check('active','Available to book',item.active) }}{{ check('appliesToAll','Available for every style',item.appliesToAll) }}<details class="manage-details"><summary>Limit to selected styles</summary><p class="owner-muted">Only used when “Available for every style” is off.</p><div class="manage-checks">{% for style in styles %}<label class="owner-check"><input type="checkbox" name="styleIds" value="{{ style.id }}" {% if style.id in item.styleIds %}checked{% endif %}>{{ style.name }}</label>{% endfor %}</div></details><button class="button" type="submit">Save extra</button></form>{% endmacro %}
