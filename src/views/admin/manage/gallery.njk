{% extends "layouts/admin.njk" %}
{% from "admin/manage/macros.njk" import csrf,field %}
{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">The studio portfolio</p><h1>Photos & Our Work.</h1><p>Every photo and film, and where clients see it.</p></div><div class="owner-actions"><a class="button outline" href="/our-work" target="_blank" rel="noopener">View Our Work ↗</a><button class="button outline" type="button" data-video-upload>Add video</button><button class="button" type="button" data-photos-add>Add photos</button></div></header>
<div class="library-undo" data-undo hidden><p data-undo-text></p><button type="button" class="button outline" data-undo-button>Undo</button></div>
<div class="library-media-tabs" role="group" aria-label="Library type"><button type="button" data-library-panel="photos" aria-pressed="true">Photos <span>{{ photos.length }}</span></button><button type="button" data-library-panel="work" aria-pressed="false">Our Work order <span>{{ work.length }}</span></button><button type="button" data-library-panel="videos" aria-pressed="false">Videos <span>{{ videos.length }}</span></button></div>
<section class="library" id="library-photos" aria-label="Photo library">
{% if stylesWithoutPhotos.length %}<details class="library-missing"><summary><span class="library-missing-count">{{ stylesWithoutPhotos.length }}</span><span><strong>Styles waiting for a photo</strong><small>Add an image to complete their style pages.</small></span></summary><div class="library-missing-list">{% for style in stylesWithoutPhotos %}<div data-missing-style="{{ style.id }}"><span>{{ style.name }}{% if not style.active %}<small>Hidden style</small>{% endif %}</span><button class="button outline" type="button" data-add-style-photo="{{ style.id }}">Add photo<span class="sr-only"> for {{ style.name }}</span></button></div>{% endfor %}</div></details>{% endif %}
{% if referenceStyles.length %}<details class="library-missing"><summary><span class="library-missing-count">{{ referenceStyles.length }}</span><span><strong>Styles using a reference photo</strong><small>Add a photo of your own work when you have one, then make it the cover.</small></span></summary><div class="library-missing-list">{% for style in referenceStyles %}<div><span>{{ style.name }}</span><button class="button outline" type="button" data-add-style-photo="{{ style.id }}">Add photo<span class="sr-only"> for {{ style.name }}</span></button></div>{% endfor %}</div></details>{% endif %}
<div class="style-tools"><label class="menu-search"><span class="sr-only">Search photos</span><input type="search" placeholder="Search a style or description" autocomplete="off" maxlength="80" data-library-search></label><label class="library-style-pick"><span class="sr-only">Filter by style</span><select data-library-style><option value="">Every style</option>{% for style in styles %}<option value="{{ style.id }}">{{ style.name }}</option>{% endfor %}<option value="untagged">No style chosen</option></select></label><button type="button" class="button outline" data-select-start>Select several</button></div>
<div class="appointment-views" role="group" aria-label="Show photos">{% for key,label in [['all','All'],['style','Style pages'],['work','Our Work'],['hidden','Hidden'],['attention','Needs attention'],['removed','Removed']] %}<button type="button" data-photo-view="{{ key }}" aria-pressed="{{ 'true' if key == 'all' else 'false' }}">{{ label }} <span class="appointment-view-count" data-photo-count="{{ key }}"></span></button>{% endfor %}</div>
<p class="owner-muted" role="status" data-library-results></p><p class="owner-muted" data-removed-help hidden>Removed photos are deleted for good after 7 days.</p>
<ul class="photo-grid" data-photo-list>{% for photo in photos.concat(removed) %}<li id="photo-{{ photo.id }}" class="photo-card{% if photo.hidden or photo.removed %} is-dim{% endif %}" data-photo-id="{{ photo.id }}" data-text="{{ [photo.styleName, photo.alt] | join(' ') | lower }}" data-style="{{ photo.styleId or '' }}" data-on-style="{{ 'yes' if photo.onStyle }}" data-in-work="{{ 'yes' if photo.inWork }}" data-hidden="{{ 'yes' if photo.hidden }}" data-removed="{{ 'yes' if photo.removed }}" data-attention="{{ 'yes' if photo.issues.length and not photo.removed }}" data-alt="{{ photo.alt }}" data-full="{{ photo.path }}" data-focus="{{ photo.focus.x }},{{ photo.focus.y }}" data-style-name="{{ photo.style.name if photo.style else '' }}" data-style-link="{{ '/styles/' + photo.style.slug if photo.style and photo.style.active and photo.onStyle else '' }}">{% if not photo.removed %}<label class="photo-pick" hidden><input type="checkbox" data-pick value="{{ photo.id }}"><span class="sr-only">Select {{ photo.styleName }}: {{ photo.alt }}</span></label>{% endif %}<button type="button" class="photo-open" {% if photo.removed %}disabled{% else %}data-photo-edit{% endif %}><img src="{{ photo.thumb }}" class="{{ photo.focusClass }}" alt="" width="320" height="400" loading="lazy" decoding="async" draggable="false"><span class="sr-only">Manage {{ photo.styleName }}: {{ photo.alt }}</span></button><div class="photo-info"><strong>{{ photo.styleName }}</strong><p>{% if photo.removed %}<span class="photo-tag">Removed</span>{% elif photo.hidden %}<span class="photo-tag">Hidden</span>{% endif %}{% if photo.cover %}<span class="photo-tag is-cover">Cover</span>{% elif photo.onStyle %}<span class="photo-tag">Style page</span>{% endif %}{% if photo.reference %}<span class="photo-tag is-warn">Reference</span>{% endif %}{% if not photo.styleId %}<span class="photo-tag is-warn">No style</span>{% endif %}</p>{% if photo.removed %}<button type="button" class="button outline" data-restore="{{ photo.id }}">Restore<span class="sr-only"> {{ photo.alt }}</span></button>{% else %}<label class="mini-switch"><input type="checkbox" role="switch" data-work-switch value="{{ photo.id }}" {% if photo.inWork %}checked{% endif %}><span>Our Work<span class="sr-only">: {{ photo.alt }}</span></span></label>{% endif %}</div></li>{% endfor %}</ul>
<p class="owner-empty" data-library-empty hidden>No photos here. Try another tab, style or word.</p>
<nav class="style-pages" data-photo-pages aria-label="Photo pages" hidden><button type="button" data-page-step="-1">← Previous</button><span class="style-page-numbers" data-page-numbers></span><span class="owner-muted" data-page-range role="status"></span><button type="button" data-page-step="1">Next →</button></nav>
<div class="select-bar" data-select-bar role="region" aria-label="Selected photos" hidden><p data-select-count role="status">0 selected</p><div class="owner-actions"><button type="button" class="button outline" data-select-page>Select all shown</button><button type="button" class="button" data-bulk="work-on">Show on Our Work</button><button type="button" class="button outline" data-bulk="work-off">Hide from Our Work</button><label><span class="sr-only">Move to style</span><select data-bulk-style><option value="">Set style…</option>{% for style in styles %}<option value="{{ style.id }}">{{ style.name }}</option>{% endfor %}</select></label><button type="button" class="button outline appointment-cancel" data-bulk="remove">Remove</button><button type="button" class="button outline" data-select-done>Done</button></div></div>
</section>
<section id="library-work" aria-label="Our Work order" hidden><div class="style-tools"><p class="owner-muted work-help">Photos and films as clients see them. Drag to arrange, or use the arrows. New items appear first until you place them.</p><button type="button" class="button" data-work-save disabled>Save order</button></div><ol class="work-order" data-work-list>{% for item in work %}<li data-work-key="{{ item.key }}" draggable="true"><span class="work-order-image"><img src="{{ item.image }}" class="{{ item.focusClass }}" alt="" width="200" height="250" loading="lazy" draggable="false">{% if item.film %}<span class="photo-tag">Film</span>{% endif %}</span><strong>{{ item.title }}</strong><span class="style-photo-tools"><button type="button" data-work-move="-1" aria-label="Move {{ item.title }} earlier">←</button><button type="button" data-work-move="1" aria-label="Move {{ item.title }} later">→</button></span></li>{% endfor %}</ol>{% if not work.length %}<p class="owner-empty">Nothing is on Our Work yet.</p>{% endif %}</section>
<dialog id="photos-add" class="owner-dialog owner-extra-dialog photos-add" aria-labelledby="photos-add-title"><header class="owner-extra-heading"><div><p class="eyebrow">Grow your portfolio</p><h2 id="photos-add-title">Add photos</h2></div><button type="button" class="owner-extra-close" data-add-close aria-label="Close upload">&times;</button></header><label class="drop-zone" data-drop><strong>Choose photos or drop them here</strong><span>Several at once. Large phone photos are made smaller before uploading.</span><input type="file" accept="image/jpeg,image/png,image/webp,image/avif" multiple data-add-files></label><label class="owner-field add-all" data-add-all hidden><span>Style for all of them</span><select data-add-style><option value="">Choose for each photo</option>{% for style in styles %}<option value="{{ style.id }}">{{ style.name }}</option>{% endfor %}</select></label><ul class="add-list" data-add-list></ul><p class="owner-error" role="alert" data-add-error hidden></p><div class="owner-actions owner-extra-actions"><button type="button" class="button outline" data-add-close>Cancel</button><button type="button" class="button" data-add-upload disabled>Upload photos</button></div></dialog>
<template data-add-row><li class="add-row"><div class="add-preview"><canvas data-canvas></canvas><div class="add-tools"><button type="button" data-rotate aria-label="Rotate photo">⟳</button><label><span class="sr-only">Crop</span><select data-crop><option value="">Full photo</option><option value="0.8">Portrait 4:5</option><option value="1">Square</option></select></label></div></div><div class="add-fields"><label class="owner-field"><span>Style</span><select data-field="style"><option value="">No style</option>{% for style in styles %}<option value="{{ style.id }}">{{ style.name }}</option>{% endfor %}</select></label><label class="owner-field"><span>Description</span><input data-field="alt" maxlength="500" placeholder="What the photo shows"></label><div class="add-where"><label class="owner-check"><input type="checkbox" data-field="onStyle"><span>Style page</span></label><label class="owner-check"><input type="checkbox" data-field="inWork" checked><span>Our Work</span></label></div><progress max="100" value="0" data-progress hidden></progress><p class="add-status" role="status" data-status></p></div><button type="button" class="owner-extra-close" data-drop-row aria-label="Leave this photo out">&times;</button></li></template>
<dialog id="photo-window" class="owner-dialog owner-extra-dialog photo-window" aria-labelledby="photo-window-title"><header class="owner-extra-heading"><div><p class="eyebrow" data-window-position></p><h2 id="photo-window-title" data-window-title>Photo</h2></div><button type="button" class="owner-extra-close" data-owner-modal-close aria-label="Close photo details">&times;</button></header><div class="photo-window-body"><div><div class="focus-box" data-focus-box><canvas data-window-canvas></canvas><span class="focus-dot" data-focus-dot aria-hidden="true"></span></div><p class="owner-muted">Click the part that must stay visible when the photo is cropped on the website.</p><div class="add-tools"><button type="button" data-window-rotate>Rotate</button><label><span class="sr-only">Crop</span><select data-window-crop><option value="">Full photo</option><option value="0.8">Portrait 4:5</option><option value="1">Square</option></select></label><label class="button outline photo-swap-pick">Replace image<input type="file" accept="image/jpeg,image/png,image/webp,image/avif" data-window-file></label></div><p class="owner-muted" role="status" data-window-image-status></p></div><form data-window-form><p class="owner-error" role="alert" data-window-error hidden></p><label class="owner-field"><span>Description for visitors</span><textarea name="alt" rows="3" minlength="3" maxlength="500" required></textarea></label><p><button type="button" class="owner-text-link" data-window-suggest>Suggest from the style name</button></p><label class="owner-field"><span>Style</span><select name="styleId"><option value="">No style</option>{% for style in styles %}<option value="{{ style.id }}">{{ style.name }}</option>{% endfor %}</select></label><fieldset class="extra-where"><legend>Where clients see it</legend><label class="owner-check"><input type="checkbox" name="showOnStyle"><span>Style page</span></label><label class="owner-check"><input type="checkbox" name="showInWork"><span>Our Work</span></label><p class="owner-muted">Untick both to hide the photo and keep it here.</p></fieldset><p class="photo-links" data-window-links></p><div class="owner-actions"><button class="button" type="submit">Save photo</button><button type="button" class="button outline appointment-cancel" data-window-remove>Remove photo</button></div></form></div><div class="photo-window-nav"><button type="button" class="button outline" data-window-step="-1">← Previous</button><button type="button" class="button outline" data-window-step="1">Next →</button></div></dialog>
{% include "admin/manage/videos.njk" %}
<script defer src="/build/admin-gallery.js"></script><script defer src="/build/admin-videos.js"></script>
{% endblock %}
