<section class="owner-panel proof-review" id="payment-review" aria-labelledby="proof-heading">
<div><h2 id="proof-heading">Verify {{ pendingProof.amountCents | money }} by {{ pendingProof.method | payMethod }}</h2>
<p>The client sent this screenshot {{ pendingProof.createdAt | et }} ET. Check that the money reached your account before approving.{% if booking.status == 'pending_payment' and booking.holdExpiresAt %} The chair is held until {{ booking.holdExpiresAt | et }} ET.{% endif %}</p>
<form action="/admin/payment-reviews/{{ pendingProof.id }}" method="post" class="owner-form" data-owner-form data-confirm="Have you checked that {{ pendingProof.amountCents | money }} arrived in your {{ pendingProof.method | payMethod }} account?"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="from" value="booking"><input type="hidden" name="decision" value="approve"><button class="button" type="submit">Approve payment{% if pendingProof.paymentType != 'balance' %} &amp; confirm booking{% endif %}</button></form>
<details><summary>Payment not received?</summary><form action="/admin/payment-reviews/{{ pendingProof.id }}" method="post" class="owner-form" data-owner-form data-confirm="{% if pendingProof.paymentType == 'balance' %}Reject this payment? The appointment stays confirmed.{% else %}Reject this payment? The appointment will be cancelled and the chair released. Contact the client first.{% endif %}"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="from" value="booking"><input type="hidden" name="decision" value="reject"><label>Reason<textarea name="note" maxlength="1000" rows="2"></textarea></label><button class="button outline" type="submit">Reject payment</button></form></details></div>
<a class="proof-image" href="/admin/payment-reviews/{{ pendingProof.id }}/image" target="_blank" rel="noopener"><img src="/admin/payment-reviews/{{ pendingProof.id }}/image" alt="Payment screenshot from {{ client.name }}"><span>Open full size ↗</span></a>
</section>
