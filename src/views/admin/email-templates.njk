{% extends "layouts/admin.njk" %}
{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">Your words, our layout</p><h1>Email templates.</h1><p>Edit the subject and introduction. Appointment details and prices are filled in automatically.</p></div><span class="owner-badge">{{ provider }} · {% if emailEnabled %}delivery enabled{% else %}delivery disabled{% endif %}</span></header>
<section class="owner-panel"><h2>Check your email delivery</h2><p>Send a test to your owner email. Check your inbox and spam folder before enabling client messages.</p><form action="/admin/email-test" method="post" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="button" type="submit" {% if not emailEnabled %}disabled{% endif %}>Send a test to myself</button></form></section>
{% for item in templates %}<details class="owner-panel"><summary>{{ item.subject }} <span class="owner-muted">({{ item.key }})</span></summary><form action="/admin/email-templates" method="post" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="template" value="{{ item.key }}"><label for="subject-{{ loop.index }}">Subject</label><input id="subject-{{ loop.index }}" name="subject" value="{{ item.subject }}" maxlength="160" required><label for="intro-{{ loop.index }}">Introduction</label><textarea id="intro-{{ loop.index }}" name="intro" rows="4" maxlength="1000" required>{{ item.intro }}</textarea><button class="button compact" type="submit">Save wording</button></form></details>{% endfor %}
{% endblock %}
