{% extends "layouts/admin.njk" %}
{% block content %}
<header class="owner-page-head"><div><p class="eyebrow">Your words, our layout</p><h1>Settings.</h1><p>Edit the subject and opening words. Appointment details and prices are filled in automatically.</p></div></header>{% set settingsTab = "wording" %}{% include "admin/manage/settings-tabs.njk" %}
<section class="owner-panel"><div class="owner-section-heading"><h2>Check your email</h2></div><p class="owner-muted">{% if emailEnabled %}Email is switched on. Send yourself a test, then look in your inbox and spam folder.{% else %}Email is switched off on this site, so nothing is sent.{% endif %}</p><form action="/admin/email-test" method="post" data-owner-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button class="button outline" type="submit" {% if not emailEnabled %}disabled{% endif %}>Send a test to myself</button></form></section>
{% for group in groups %}<section class="owner-panel"><h2>{{ group.name }}</h2>{% for item in group.items %}<details class="wording-item"><summary><span><strong>{{ item.key | emailName }}</strong><span class="owner-muted">{{ item.subject }}</span></span>{% if item.changed %}<span class="photo-tag">Your wording</span>{% endif %}</summary><form action="/admin/email-templates" method="post" data-owner-form data-settings-form><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="template" value="{{ item.key }}"><p class="owner-error" role="alert" data-owner-form-error hidden></p><label class="owner-field"><span>Subject</span><input name="subject" value="{{ item.subject }}" maxlength="160" required></label><label class="owner-field"><span>Opening words</span><textarea name="intro" rows="4" maxlength="1000" required>{{ item.intro }}</textarea></label><div class="owner-actions"><button class="button" type="submit">Save wording</button><button class="button outline" type="submit" formaction="/admin/email-templates/preview" formtarget="_blank" data-native-submit>Preview ↗</button></div></form>{% if item.changed %}<form action="/admin/email-templates/reset" method="post" data-owner-form data-confirm="Go back to the original wording?" data-confirm-detail="Your subject and opening words for this email are replaced." data-confirm-label="Use the original"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="template" value="{{ item.key }}"><button class="owner-text-link" type="submit">Back to the original</button></form>{% endif %}</details>{% endfor %}</section>{% endfor %}<script defer src="/build/admin-settings.js"></script>
{% endblock %}
