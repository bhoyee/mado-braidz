{% extends "layouts/admin.njk" %}{% block content %}
<header class="owner-heading"><div><p class="eyebrow">Studio finances</p><h1>{{ title }}.</h1><p>{{ range }}{% if mode == 'receipts' %} · America/New_York{% endif %}</p><p class="owner-live" data-live-status>Live</p></div></header>
<section class="owner-panel" data-live="financial"><div class="owner-section-heading"><div><p class="eyebrow">{% if mode == 'receipts' %}Net received · after refunds{% else %}Total balance to collect{% endif %}</p><h2>{{ total | money }}</h2></div>{% if mode == 'receipts' %}<nav aria-label="Payment period"><a href="/admin/payments?period=week" {% if period == 'week' %}aria-current="page"{% endif %}>This week</a> · <a href="/admin/payments?period=month" {% if period == 'month' %}aria-current="page"{% endif %}>This month</a></nav>{% endif %}</div>
<div class="owner-table-wrap owner-table-cards" tabindex="0" role="region" aria-label="{{ title }} table"><table class="owner-table" role="table"><caption class="sr-only">{{ title }}</caption><thead role="rowgroup"><tr role="row"><th role="columnheader">Client</th><th role="columnheader">Appointment</th>{% if mode == 'receipts' %}<th role="columnheader">Received</th><th role="columnheader">Method / type</th><th role="columnheader">Amount</th>{% else %}<th role="columnheader">Total</th><th role="columnheader">Paid</th><th role="columnheader">Balance due</th>{% endif %}<th role="columnheader"><span class="sr-only">Open booking</span></th></tr></thead><tbody role="rowgroup">{% for row in rows %}<tr role="row"><td role="cell" data-label="Client"><strong>{{ row.client.name }}</strong><span><a href="mailto:{{ row.client.email }}">{{ row.client.email }}</a></span><span><a href="tel:{{ row.client.phoneE164 }}">{{ row.client.phoneE164 }}</a></span></td><td role="cell" data-label="Appointment"><strong>{{ row.booking.ref }}</strong><span>{{ row.booking.startAt | et }}</span></td>{% if mode == 'receipts' %}<td role="cell" data-label="Received">{{ row.payment.createdAt | et }}</td><td role="cell" data-label="Method"><strong>{{ row.payment.method | payMethod }}</strong><span>{{ row.payment.type | title }}</span></td><td role="cell" data-label="Amount"><strong class="{% if row.payment.type == 'refund' %}pay-due{% else %}pay-good{% endif %}">{% if row.payment.type == 'refund' %}−{% endif %}{{ row.payment.amountCents | money }}</strong></td>{% else %}<td role="cell" data-label="Total">{{ row.booking.subtotalCents | money }}</td><td role="cell" data-label="Paid">{{ row.booking.paidCents | money }}</td><td role="cell" data-label="Balance due"><strong class="pay-due">{{ row.booking.balanceCents | money }}</strong></td>{% endif %}<td role="cell" class="owner-row-action"><a class="owner-view-link" href="/admin/bookings/{{ row.booking.id }}">View<span class="sr-only"> {{ row.booking.ref }}</span> <span class="owner-view-arrow" aria-hidden="true">→</span></a></td></tr>{% else %}<tr><td colspan="6" class="owner-empty">{% if mode == 'receipts' %}No payments recorded in this period.{% else %}No outstanding balances.{% endif %}</td></tr>{% endfor %}</tbody></table></div>
<nav class="owner-pagination" aria-label="Financial report pages">{% if page > 1 %}<a href="{{ previous }}">Previous</a>{% endif %}<span>Page {{ page }}</span>{% if hasNext %}<a href="{{ next }}">Next</a>{% endif %}</nav></section><script defer src="/build/admin-live.js"></script>{% endblock %}
