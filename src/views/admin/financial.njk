{% extends "layouts/admin.njk" %}{% block content %}
<header class="owner-heading"><div><p class="eyebrow">Studio finances</p><h1>{{ title }}.</h1><p>{{ range }}{% if mode == 'receipts' %} · America/New_York{% endif %}</p></div><a class="button outline" href="/admin">Back to overview</a></header>
<section class="owner-panel"><div class="owner-section-heading"><div><p class="eyebrow">{% if mode == 'receipts' %}Net received · after refunds{% else %}Total balance to collect{% endif %}</p><h2>{{ total | money }}</h2></div>{% if mode == 'receipts' %}<nav aria-label="Payment period"><a href="/admin/payments?period=week" {% if period == 'week' %}aria-current="page"{% endif %}>This week</a> · <a href="/admin/payments?period=month" {% if period == 'month' %}aria-current="page"{% endif %}>This month</a></nav>{% endif %}</div>
<div class="owner-table-wrap" tabindex="0" role="region" aria-label="{{ title }} table"><table class="owner-table"><caption class="sr-only">{{ title }}</caption><thead><tr><th>Client</th><th>Appointment</th>{% if mode == 'receipts' %}<th>Received</th><th>Method / type</th><th>Amount</th>{% else %}<th>Total</th><th>Paid</th><th>Balance due</th>{% endif %}<th><span class="sr-only">Open booking</span></th></tr></thead><tbody>{% for row in rows %}<tr><td><strong>{{ row.client.name }}</strong><span><a href="mailto:{{ row.client.email }}">{{ row.client.email }}</a></span><span><a href="tel:{{ row.client.phoneE164 }}">{{ row.client.phoneE164 }}</a></span></td><td><strong>{{ row.booking.ref }}</strong><span>{{ row.booking.startAt | et }}</span></td>{% if mode == 'receipts' %}<td>{{ row.payment.createdAt | et }}</td><td><strong>{{ row.payment.method | title }}</strong><span>{{ row.payment.type | title }}</span></td><td><strong>{% if row.payment.type == 'refund' %}−{% endif %}{{ row.payment.amountCents | money }}</strong></td>{% else %}<td>{{ row.booking.subtotalCents | money }}</td><td>{{ row.booking.paidCents | money }}</td><td><strong>{{ row.booking.balanceCents | money }}</strong></td>{% endif %}<td><a class="owner-text-link" href="/admin/bookings/{{ row.booking.id }}">View booking<span class="sr-only"> {{ row.booking.ref }}</span></a></td></tr>{% else %}<tr><td colspan="6" class="owner-empty">{% if mode == 'receipts' %}No payments recorded in this period.{% else %}No outstanding balances.{% endif %}</td></tr>{% endfor %}</tbody></table></div>
<nav class="owner-pagination" aria-label="Financial report pages">{% if page > 1 %}<a href="{{ previous }}">Previous</a>{% endif %}<span>Page {{ page }}</span>{% if hasNext %}<a href="{{ next }}">Next</a>{% endif %}</nav></section>{% endblock %}
