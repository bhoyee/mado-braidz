{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">{% if isNew %}A seat in your studio{% else %}{{ booking.ref }}{% endif %}</p><h1>{% if isNew %}Book a <em>client.</em>{% else %}Make it <em>work for them.</em>{% endif %}</h1><p>All times Eastern. Only times with a free chair are offered.</p></div></header>
<form method="post" action="{% if isNew %}/admin/bookings/new{% else %}/admin/bookings/{{ booking.id }}/edit{% endif %}" class="owner-editor" data-owner-form data-booking-editor {% if booking %}data-booking-id="{{ booking.id }}" data-duration="{{ price.durationMin }}" data-total="{{ price.subtotalCents }}" data-paid="{{ booking.paidCents }}" data-style-name="{{ price.styleName }}" data-start="{{ form.date }} {{ form.time }}"{% endif %}><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}">{% if booking %}<input type="hidden" name="expectedUpdatedAt" value="{{ booking.updatedAt.toISOString() }}">{% endif %}
<div class="editor-layout"><div class="editor-steps"><section class="owner-panel"><h2>Client details</h2><div class="owner-form">{% if isNew %}<div class="client-lookup" data-client-lookup><label>Find an existing client<input type="search" autocomplete="off" maxlength="80" placeholder="Name, phone or email" data-client-search data-lookup aria-controls="client-results" aria-describedby="client-status"></label><p id="client-status" class="owner-muted" role="status" data-client-status>Or enter a new client below.</p><div id="client-results" class="client-results" data-client-results hidden></div></div>{% endif %}<label>Full name<input name="name" value="{{ form.name }}" required minlength="2" maxlength="120" autocomplete="off"></label><div class="owner-fields"><label>Email<input type="email" name="email" value="{{ form.email }}" required maxlength="255" autocomplete="off"></label><label>US phone number<input type="tel" name="phone" value="{{ form.phone }}" required maxlength="32" autocomplete="off"></label></div><label>Client notes<textarea name="notes" rows="2" maxlength="2000">{{ form.notes }}</textarea></label></div></section>
<section class="owner-panel"><div class="owner-section-heading"><h2>The look</h2>{% if price %}<strong>{{ price.subtotalCents | money }}</strong>{% endif %}</div>{% if not isNew %}<p>{{ price.styleName }} · {{ [price.size, price.length] | optionLabel }}</p><p class="owner-muted">The original price is kept when you change only the date or client details.</p><label class="owner-check"><input type="checkbox" name="changeStyle" data-change-style>Change style or extras and recalculate the price</label>{% endif %}
<fieldset class="owner-form owner-style-fields" {% if not isNew %}disabled{% endif %} data-style-fields><legend class="sr-only">Style and extras</legend><div class="owner-fields"><label>Style<select name="styleId" data-owner-style required>{% for style in catalog.styles %}<option value="{{ style.id }}" data-duration="{{ style.durationMin }}" {% if booking.styleId == style.id %}selected{% endif %}>{{ style.name }}</option>{% endfor %}</select></label><label>Size & length<select name="styleVariantId" data-owner-variant><option value="">Consultation-priced style</option>{% for style in catalog.styles %}{% for variant in style.variants %}<option value="{{ variant.id }}" data-style="{{ style.id }}" data-price="{{ variant.priceCents }}" {% if booking.styleVariantId == variant.id %}selected{% endif %}>{{ [variant.size, variant.length] | optionLabel }} · {{ variant.priceCents | money }}</option>{% endfor %}{% endfor %}</select></label></div><div><p class="owner-field-label">Extras</p>{% for addon in catalog.addons %}<label class="owner-check"><input type="checkbox" name="addonIds" value="{{ addon.id }}" data-addon-all="{{ addon.appliesToAll }}" data-addon-styles="{{ (addon.styleIds or []) | join(',') }}" {% for selected in price.addons %}{% if selected.id == addon.id %}checked{% endif %}{% endfor %}>{{ addon.name }} · {{ addon.priceCents | money }}</label>{% endfor %}</div></fieldset>
{% if price.consultation %}<label class="owner-form">Agreed total, including extras (USD)<input type="number" min="0.01" step="0.01" data-money="quotedTotalCents" placeholder="Leave blank until agreed"><span class="owner-muted">Sets the final total on this appointment only.</span></label>{% endif %}</section>
<section class="owner-panel"><h2>Date &amp; time</h2><div class="owner-form"><div class="owner-fields"><label>Date<input name="date" type="date" value="{{ form.date }}" {% if today %}min="{{ today }}"{% endif %} required data-owner-date></label><label>Start time<input name="time" type="time" step="1800" value="{{ form.time }}" required data-owner-time></label></div><div class="slot-groups" data-owner-slots aria-live="polite"><p class="owner-muted">Choose a date to see free times.</p></div><p class="owner-muted">{{ catalog.settings.hours.summary }}. The whole visit must fit before closing.</p></div></section>
{% if isNew %}<section class="owner-panel"><fieldset class="editor-payments"><legend>How is the client paying?</legend><label class="editor-payment"><input type="radio" name="mode" value="link" data-payment-mode checked><span><strong>Email a deposit link</strong><span>Holds the chair for {{ catalog.settings.booking.holdMinutes }} minutes. The client is emailed a private link and the visit is confirmed when they pay.</span></span></label><label class="editor-payment"><input type="radio" name="mode" value="manual" data-payment-mode><span><strong>Payment already received</strong><span>Cash, Zelle, Cash App or card in person. Confirms now and emails the client a confirmation.</span></span></label><label class="editor-payment"><input type="radio" name="mode" value="override" data-payment-mode><span><strong>No payment yet</strong><span>Confirms now without a deposit and emails the client a confirmation. The full amount stays due.</span></span></label></fieldset><div class="owner-form payment-received" data-manual-fields hidden><div class="owner-fields"><label>Amount received (USD)<input type="number" inputmode="decimal" data-money="amountCents" min="0.01" step="0.01"></label><label>Method<select name="method"><option value="cash">Cash</option><option value="zelle">Zelle</option><option value="cashapp">Cash App</option><option value="card">Card taken in person</option><option value="other">Other</option></select></label></div><p class="owner-muted" data-manual-help></p></div></section>{% else %}<section class="owner-panel"><h2>Notes &amp; email</h2><div class="owner-form"><label>Private owner notes<textarea name="adminNotes" rows="3" maxlength="2000">{{ form.adminNotes }}</textarea></label><label class="owner-check"><input type="checkbox" name="notifyClient" data-notify checked>Email the client the new date and time</label><p class="owner-muted" data-notify-help>No date email is sent unless you change the date or time.</p></div></section>{% endif %}</div>
<div class="editor-aside"><section class="owner-panel editor-summary" aria-labelledby="summary-heading"><h2 id="summary-heading">{% if isNew %}Summary{% else %}Save the changes{% endif %}</h2><dl class="owner-facts" data-summary><div><dt>Client</dt><dd data-sum="client">—</dd></div><div><dt>Style</dt><dd data-sum="style">—</dd></div><div><dt>Extras</dt><dd data-sum="extras">—</dd></div><div><dt>When</dt><dd data-sum="when">—</dd></div><div><dt>Duration</dt><dd data-sum="duration">—</dd></div>{% if isNew %}<div><dt>Deposit</dt><dd data-sum="deposit">—</dd></div>{% else %}<div><dt>Paid</dt><dd>{{ booking.paidCents | money }}</dd></div>{% endif %}<div><dt>Balance</dt><dd data-sum="balance">—</dd></div></dl></section><div class="editor-bar"><p><span>Total</span><strong data-sum="total" aria-live="polite">—</strong></p><button class="button" type="submit">{% if isNew %}Create appointment{% else %}Save appointment{% endif %}</button></div></div></div></form>{% endblock %}
