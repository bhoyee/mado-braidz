{% extends "layouts/admin.njk" %}{% block content %}<header class="owner-heading"><div><p class="eyebrow">{% if isNew %}A seat in your studio{% else %}{{ booking.ref }}{% endif %}</p><h1>{% if isNew %}Book a <em>client.</em>{% else %}Make it <em>work for them.</em>{% endif %}</h1><p>Choose the date and time in Eastern time. Opening hours, duration and three-client capacity always apply.</p></div><a class="owner-text-link" href="{% if isNew %}/admin/bookings{% else %}/admin/bookings/{{ booking.id }}{% endif %}">← Back</a></header>
<form method="post" action="{% if isNew %}/admin/bookings/new{% else %}/admin/bookings/{{ booking.id }}/edit{% endif %}" class="owner-editor" data-owner-form data-booking-editor {% if booking %}data-booking-id="{{ booking.id }}" data-duration="{{ price.durationMin }}"{% endif %}><input type="hidden" name="_csrf" value="{{ csrfToken }}"><input type="hidden" name="requestKey" value="{{ requestKey }}">{% if booking %}<input type="hidden" name="expectedUpdatedAt" value="{{ booking.updatedAt.toISOString() }}">{% endif %}
<div class="owner-columns"><div><section class="owner-panel"><h2>Client details</h2><div class="owner-form"><label>Full name<input name="name" value="{{ form.name }}" required minlength="2" maxlength="120" autocomplete="name"></label><div class="owner-fields"><label>Email<input type="email" name="email" value="{{ form.email }}" required maxlength="255" autocomplete="email"></label><label>US phone number<input type="tel" name="phone" value="{{ form.phone }}" required maxlength="32" autocomplete="tel"></label></div><label>Client notes<textarea name="notes" rows="3" maxlength="2000">{{ form.notes }}</textarea></label></div></section>
<section class="owner-panel"><div class="owner-section-heading"><h2>The look</h2>{% if price %}<strong>{{ price.subtotalCents | money }}</strong>{% endif %}</div>{% if not isNew %}<p>{{ price.styleName }} · {{ price.size | replace('_',' ') | title }} · {{ price.length | replace('_',' ') | title }}</p><p class="owner-muted">Keep the original price when changing only the date or client details.</p><label class="owner-check"><input type="checkbox" name="changeStyle" data-change-style>Change style or extras and recalculate the price</label>{% endif %}
<fieldset class="owner-form owner-style-fields" {% if not isNew %}disabled{% endif %} data-style-fields><legend class="sr-only">Style and extras</legend><label>Style<select name="styleId" data-owner-style required>{% for style in catalog.styles %}<option value="{{ style.id }}" data-duration="{{ style.durationMin }}" {% if booking.styleId == style.id %}selected{% endif %}>{{ style.name }}</option>{% endfor %}</select></label><label>Size & length<select name="styleVariantId" data-owner-variant><option value="">Consultation-priced style</option>{% for style in catalog.styles %}{% for variant in style.variants %}<option value="{{ variant.id }}" data-style="{{ style.id }}" data-price="{{ variant.priceCents }}" {% if booking.styleVariantId == variant.id %}selected{% endif %}>{{ style.name }} · {{ variant.size | replace('_',' ') | title }} · {{ variant.length | replace('_',' ') | title }} — {{ variant.priceCents | money }}</option>{% endfor %}{% endfor %}</select></label><div><p class="owner-field-label">Extras</p>{% for addon in catalog.addons %}<label class="owner-check"><input type="checkbox" name="addonIds" value="{{ addon.id }}" {% for selected in price.addons %}{% if selected.id == addon.id %}checked{% endif %}{% endfor %}>{{ addon.name }} · {{ addon.priceCents | money }}</label>{% endfor %}</div><p class="owner-quote" data-price-preview aria-live="polite">Choose a style to see its price.</p></fieldset>
{% if price.consultation %}<label class="owner-form">Agreed total, including extras (USD)<input type="number" min="0.01" step="0.01" data-money="quotedTotalCents" placeholder="Leave blank until agreed"><span class="owner-muted">Sets the final total on this appointment only.</span></label>{% endif %}</section></div>
<div><section class="owner-panel"><h2>Date & time</h2><div class="owner-form"><div class="owner-fields"><label>Date<input name="date" type="date" value="{{ form.date }}" required data-owner-date></label><label>Start time <span class="owner-muted">Eastern</span><input name="time" type="time" step="1800" value="{{ form.time }}" required data-owner-time></label></div><button type="button" class="button outline" data-check-slots>Show available times</button><p class="owner-muted">Mon–Sat 6am–9pm · Sun 10am–6pm. Appointment and buffer must fit before closing.</p><div class="owner-slot-list" data-owner-slots aria-live="polite"></div></div></section>
<section class="owner-panel"><h2>{% if isNew %}Reserve the chair{% else %}Save the changes{% endif %}</h2><div class="owner-form">{% if isNew %}<label>Payment arrangement<select name="mode" data-payment-mode><option value="link">Send deposit payment link · temporary hold</option><option value="manual">Payment already received · confirm appointment</option><option value="override">Owner override · confirm without payment</option></select></label><div data-manual-fields hidden><label>Amount received (USD)<input type="number" data-money="amountCents" min="0.01" step="0.01"></label><label>Method<select name="method"><option value="cash">Cash</option><option value="zelle">Zelle</option><option value="cashapp">Cash App</option><option value="card">Card taken in person</option><option value="other">Other</option></select></label></div><p class="owner-muted">Payment links and confirmations are queued for email delivery in Milestone 7. You can copy the private visit link after saving.</p>{% else %}<label>Private owner notes<textarea name="adminNotes" rows="3" maxlength="2000">{{ form.adminNotes }}</textarea></label><label class="owner-check"><input type="checkbox" name="notifyClient" checked>Queue a date/time update for the client</label><p class="owner-muted">Client email delivery is added in Milestone 7.</p>{% endif %}<button class="button" type="submit">{% if isNew %}Create appointment{% else %}Save appointment{% endif %}</button></div></section></div></div></form>{% endblock %}
