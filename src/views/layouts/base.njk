<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1c0f26">
  <title>{{ (seo and seo.title) or title }}</title>
  <meta name="description" content="{{ (seo and seo.description) or description or 'Braids, twists and locs in Lanham, Maryland. Explore styles, lengths and clear prices.' }}">
  {% if isDesign or not seo %}<meta name="robots" content="noindex,nofollow">{% else %}<link rel="canonical" href="{{ seo.canonical }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ business.name }}">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="{{ seo.title or title }}">
  <meta property="og:description" content="{{ seo.description }}">
  <meta property="og:url" content="{{ seo.canonical }}">
  <meta property="og:image" content="{{ seo.image }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ seo.imageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ seo.title or title }}">
  <meta name="twitter:description" content="{{ seo.description }}">
  <meta name="twitter:image" content="{{ seo.image }}">
  {% for tag in seo.verification %}<meta name="{{ tag.name }}" content="{{ tag.content }}">
  {% endfor %}{% if seo.graph %}<script type="application/ld+json">{{ seo.graph | safe }}</script>{% endif %}{% endif %}
  <link rel="icon" href="/favicon.ico?v=7b36ba340846" sizes="16x16 32x32 48x48"><link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-mado-32.png?v=7b36ba340846"><link rel="icon" type="image/png" sizes="48x48" href="/img/favicon-mado-48.png?v=7b36ba340846"><link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon-mado.png?v=7b36ba340846">
  <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin>
  {% if currentPath == "/" %}<link rel="preload" href="{{ media('studio-knotless.webp') }}" as="image" fetchpriority="high">{% endif %}
  <link rel="stylesheet" href="/build/app.css">
  <script defer src="/build/site.js"></script>
</head>
<body class="{% if currentPath == '/' %}home-page{% endif %}">
<a href="#main" class="skip-link">Skip to content</a>

<header class="site-header">
  <div class="topbar">
    <div class="wrap topbar-inner">
      <a href="{{ directions }}" class="topbar-item topbar-location" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21s7-7.2 7-13A7 7 0 0 0 5 8c0 5.8 7 13 7 13Z"/><circle cx="12" cy="8" r="2.5"/></svg>
        <span>{{ business.street }}, {{ business.city }}, {{ business.region }} {{ business.postalCode }}</span>
      </a>
      <p class="topbar-item topbar-hours">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <span>{{ hours.daysLabel }} · {{ hours.timeLabel }}<br>{{ hours.sundayLabel }} <abbr title="Eastern time">ET</abbr></span>
      </p>
      <a class="topbar-item topbar-phone" href="tel:{{ business.phone }}">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m5 3 4 1 1 5-3 1c2 4 3 5 7 7l1-3 5 1 1 4c-1 5-8 2-12-2S1 4 5 3Z"/></svg>
        <span>{{ phoneDisplay }}</span>
      </a>
    </div>
  </div>
  <div class="wrap navbar">
    <a class="brand" href="/">
      <img src="/img/logo.webp" width="64" height="64" alt="" decoding="async">
      <span class="brand-text"><span class="brand-name">Mado</span><span class="brand-sub">African Braids</span></span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
      {% for url, name in [['/styles','Styles &amp; Prices'],['/our-work','Our Work'],['/about','Our Story'],['/contact','Visit Us']] %}
      <a href="{{ url }}" {% if currentPath == url or (url == '/styles' and currentPath and currentPath.indexOf('/styles') == 0) %}aria-current="page"{% endif %}>{{ name | safe }}</a>
      {% endfor %}
    </nav>
    <a class="button nav-book" href="/book">Book your chair</a>
    <details class="mobile-nav">
      <summary><span class="mobile-nav-label">Menu</span><span class="burger" aria-hidden="true"><i></i><i></i></span></summary>
      <nav aria-label="Mobile navigation">
        <a href="/styles"{% if currentPath and currentPath.indexOf('/styles') == 0 %} aria-current="page"{% endif %}>Styles &amp; Prices</a>
        <a href="/our-work"{% if currentPath == '/our-work' %} aria-current="page"{% endif %}>Our Work</a>
        <a href="/about"{% if currentPath == '/about' %} aria-current="page"{% endif %}>Our Story</a>
        <a href="/contact"{% if currentPath == '/contact' %} aria-current="page"{% endif %}>Visit Us</a>
        <a href="/policies"{% if currentPath == '/policies' %} aria-current="page"{% endif %}>Booking policies</a>
        <a href="tel:{{ business.phone }}" class="mobile-nav-phone">Call {{ phoneDisplay }}</a>
        <a href="/book" class="button">Book your chair</a>
      </nav>
    </details>
  </div>
</header>

<main id="main" tabindex="-1">{% block content %}{% endblock %}</main>


<footer class="site-footer">
  {% from "partials/footer-icons.njk" import socialIcon, payments %}
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand brand-light" href="/">
        <img src="/img/logo.webp" width="64" height="64" alt="" loading="lazy">
        <span class="brand-text"><span class="brand-name">Mado</span><span class="brand-sub">African Braids</span></span>
      </a>
      <p>Knotless braids, twists and locs, braided by hand in {{ business.city }}, Maryland.</p>
      {% if social.length %}
      <ul class="social-links" aria-label="Follow us">
        {% for item in social %}<li><a href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.name }} (opens in a new tab)">{{ socialIcon(item.key) }}</a></li>{% endfor %}
      </ul>
      {% endif %}
    </div>
    <div>
      <h2 class="footer-heading">Visit</h2>
      <address><strong>{{ business.name }}</strong><br>{{ business.street }}<br>{{ business.city }}, {{ business.region }} {{ business.postalCode }}</address>
      <p><a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></p>
      <p><a href="{{ directions }}" target="_blank" rel="noopener noreferrer">Get directions</a></p>
    </div>
    <div>
      <h2 class="footer-heading">Hours</h2>
      <p>{{ hours.daysLabel }} · {{ hours.timeLabel }}<br>{{ hours.sundayLabel }}<br>Eastern time</p>
    </div>
    <nav aria-label="Footer navigation">
      <h2 class="footer-heading">Explore</h2>
      {% for url,name in [['/styles','Styles'],['/our-work','Our Work'],['/about','Our Story'],['/contact','Visit'],['/pay','Make a payment'],['/policies','Policies'],['/privacy','Privacy'],['/terms','Terms']] %}<a href="{{ url }}">{{ name }}</a>{% endfor %}
    </nav>
  </div>
  <div class="wrap footer-payments">
    <p class="footer-heading">We accept</p>
    {{ payments() }}
  </div>
  <div class="wrap footer-bottom">
    <p>© {{ year }} {{ business.name }} · African hair braiding in {{ business.city }}, {{ business.region }}</p>
    <p>Powered by <a href="https://giddyhost.com" target="_blank" rel="noopener">GiddyHost</a></p>
  </div>
</footer>

{% if not isDesign %}
{% if currentPath != '/book' and currentPath != '/book/success' and not hideMobileBooking %}<div class="mobile-book">
  <a href="tel:{{ business.phone }}" class="mobile-book-call">Call</a>
  <a href="/book" class="button">Book your chair</a>
</div>
{% endif %}
{% endif %}
{% if whatsappUrl and not isDesign %}<a class="whatsapp-chat" href="{{ whatsappUrl }}" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp (opens in a new tab)"><svg width="27" height="27" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 11.5a9 9 0 0 1-13.3 7.9L3 21l1.5-4.8A9 9 0 1 1 21 11.5Z"/><path d="M8.2 7.2c-.8.3-1.1 1.2-.8 2.1 1 3.1 3.5 5.5 6.4 6.2.9.2 1.8-.3 2-1.2l-2.4-1.5-1.1 1c-1.5-.7-2.6-1.8-3.2-3.3l.9-1-1.3-2.3Z"/></svg><span>Chat with us<small> on WhatsApp</small></span></a>{% endif %}
</body>
</html>
