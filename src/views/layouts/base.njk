<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#15100e"><title>{{ title }}</title><meta name="description" content="{{ description or 'Braids, twists and locs in Lanham, Maryland. Explore styles, lengths and clear prices at Mado African Braidz.' }}">{% if isDesign %}<meta name="robots" content="noindex,nofollow">{% endif %}<link rel="icon" href="/img/braid-ring.svg" type="image/svg+xml"><link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>{% if currentPath == "/" %}<link rel="preload" href="/media/finished-look.webp" as="image" fetchpriority="high">{% endif %}<link rel="stylesheet" href="/build/app.css"><script defer src="/build/site.js"></script></head>
<body{% if currentPath == "/" %} class="home-page"{% endif %}><a href="#main" class="skip-link">Skip to content</a><header class="site-header"><div class="wrap header-inner"><a class="brand" href="/"><img class="salon-logo" src="/img/logo.webp" width="64" height="64" alt="" decoding="async"><span><span class="brand-name">Mado</span> <span class="brand-sub">African Braidz</span></span></a><nav aria-label="Main navigation" class="desktop-nav">{% for url,name in [['/styles','Styles'],['/prices','Prices'],['/gallery','Gallery'],['/about','About'],['/contact','Visit']] %}<a href="{{ url }}" {% if currentPath == url %}aria-current="page"{% endif %}>{{ name }}</a>{% endfor %}</nav><div class="header-actions"><a class="phone-link" href="tel:{{ business.phone }}">{{ phoneDisplay }}</a><a href="/book" class="button compact">Book your chair</a></div><details class="mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{% for url,name in [['/styles','Styles'],['/prices','Prices'],['/gallery','Gallery'],['/about','About'],['/contact','Visit'],['/policies','Policies']] %}<a href="{{ url }}">{{ name }}</a>{% endfor %}</nav></details></div></header>
<main id="main" tabindex="-1">{% block content %}{% endblock %}</main>
{% if not isDesign %}<section class="closing"><div class="wrap closing-grid"><div><p class="eyebrow">Your next appointment</p><h2>Make room for<br><em>a new look.</em></h2></div><div><p>Tell us what you’re thinking.<br>We’ll help you make it happen.</p><a class="button" href="/book">Let’s book your chair <span aria-hidden="true">↗</span></a><a class="closing-phone" href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></div></div></section>{% endif %}
<footer class="site-footer"><div class="wrap"><div class="footer-grid"><a class="brand" href="/"><img class="salon-logo" src="/img/logo.webp" width="72" height="72" alt="" loading="lazy"><span><span class="brand-name">Mado</span> <span class="brand-sub">African Braidz</span></span></a><address><strong>{{ business.name }}</strong><br>{{ business.street }}<br>{{ business.city }}, {{ business.region }} {{ business.postalCode }}<br><a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></address><nav aria-label="Footer navigation">{% for url,name in [['/styles','Styles'],['/prices','Prices'],['/gallery','Gallery'],['/contact','Visit'],['/policies','Policies'],['/privacy','Privacy'],['/terms','Terms']] %}<a href="{{ url }}">{{ name }}</a>{% endfor %}</nav></div><p class="copyright">© {{ year }} {{ business.name }} · African hair braiding in {{ business.city }}, {{ business.region }}</p></div></footer>{% if not isDesign %}<div class="mobile-book"><span>{{ business.city }}, {{ business.region }}<br>Your chair is waiting.</span><a href="/book" class="button compact">Book now <span aria-hidden="true">↗</span></a></div>{% endif %}</body></html>
