<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#15100e"><title>{{ title }}</title><meta name="description" content="{{ description or 'Braids, twists and locs in Lanham, Maryland. Explore styles, lengths and clear prices at Mado African Braidz.' }}">{% if isDesign %}<meta name="robots" content="noindex,nofollow">{% endif %}<link rel="icon" href="/img/braid-ring.svg" type="image/svg+xml"><link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin>{% if currentPath == "/" %}<link rel="preload" href="/media/finished-look.webp" as="image" fetchpriority="high">{% endif %}<link rel="stylesheet" href="/build/app.css"><script defer src="/build/site.js"></script></head>
<body{% if currentPath == "/" %} class="home-page"{% endif %}><a href="#main" class="skip-link">Skip to content</a>
<header class="site-header salon-header">
 <div class="salon-info"><div class="wrap salon-info-inner">
  <a href="{{ directions }}" class="salon-location" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 21s7-7.2 7-13A7 7 0 0 0 5 8c0 5.8 7 13 7 13Z"/><circle cx="12" cy="8" r="2.5"/></svg><span>{{ business.street }}<span class="salon-info-detail">{{ business.city }}, {{ business.region }} {{ business.postalCode }}</span></span></a>
  <div class="salon-hours"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l4 2"/></svg><span>{{ hours.daysLabel or "Open daily" }}<span class="salon-info-detail">{{ hours.timeLabel or "6:00 AM–6:00 PM" }} <span class="hours-zone">ET</span></span></span></div>
  <a class="salon-call" href="tel:{{ business.phone }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m5 3 4 1 1 5-3 1c2 4 3 5 7 7l1-3 5 1 1 4c-1 5-8 2-12-2S1 4 5 3Z"/></svg><span>Let’s talk about your hair<span class="salon-info-detail">{{ phoneDisplay }}</span></span></a>
 </div></div>
 <div class="wrap salon-main">
  <nav class="salon-nav salon-nav-left" aria-label="Main navigation"><a href="/styles" {% if currentPath=="/styles" %}aria-current="page"{% endif %}>Styles &amp; Prices</a><a href="/our-work" {% if currentPath=="/our-work" %}aria-current="page"{% endif %}>Our Work</a></nav>
  <a class="salon-brand" href="/" ><img src="/img/logo.webp" width="80" height="80" alt="" decoding="async"><span><span class="salon-brand-name">Mado</span> <span class="salon-brand-sub">AFRICAN BRAIDZ</span></span></a>
  <div class="salon-right"><nav class="salon-nav" aria-label="Studio navigation"><a href="/about">Our Story</a><a href="/contact">Visit Us</a></nav><a class="button salon-book" href="/book">Book your chair <span aria-hidden="true">↗</span></a></div>
  <details class="mobile-nav salon-mobile-nav"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation"><a href="/styles">Styles &amp; Prices</a><a href="/our-work">Our Work</a><a href="/about">Our Story</a><a href="/contact">Visit Us</a><a href="/book">Book your chair</a><a href="/policies">Booking policies</a></nav></details>
 </div>
</header>
<main id="main" tabindex="-1">{% block content %}{% endblock %}</main>
{% if not isDesign %}<section class="closing"><div class="wrap closing-grid"><div><p class="eyebrow">Your next appointment</p><h2>Make room for<br><em>a new look.</em></h2></div><div><p>Tell us what you’re thinking.<br>We’ll help you make it happen.</p><a class="button" href="/book">Let’s book your chair <span aria-hidden="true">↗</span></a><a class="closing-phone" href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></div></div></section>{% endif %}
<footer class="site-footer"><div class="wrap"><div class="footer-grid"><a class="brand" href="/"><img class="salon-logo" src="/img/logo.webp" width="72" height="72" alt="" loading="lazy"><span><span class="brand-name">Mado</span> <span class="brand-sub">African Braidz</span></span></a><address><strong>{{ business.name }}</strong><br>{{ business.street }}<br>{{ business.city }}, {{ business.region }} {{ business.postalCode }}<br><a href="tel:{{ business.phone }}">{{ phoneDisplay }}</a></address><nav aria-label="Footer navigation">{% for url,name in [['/styles','Styles'],['/our-work','Our Work'],['/contact','Visit'],['/policies','Policies'],['/privacy','Privacy'],['/terms','Terms']] %}<a href="{{ url }}">{{ name }}</a>{% endfor %}</nav></div><p class="copyright">© {{ year }} {{ business.name }} · African hair braiding in {{ business.city }}, {{ business.region }}</p></div></footer>{% if not isDesign %}<div class="mobile-book"><span>{{ business.city }}, {{ business.region }}<br>Your chair is waiting.</span><a href="/book" class="button compact">Book now <span aria-hidden="true">↗</span></a></div>{% endif %}</body></html>
