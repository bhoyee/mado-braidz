{% from "admin/menu-icons.njk" import adminIcon %}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#1c0f26"><meta name="csrf-token" content="{{ csrfToken }}"><meta name="csp-nonce" content="{{ cspNonce }}"><title>{{ title }}</title><link rel="icon" href="/favicon.ico?v=7b36ba340846" sizes="16x16 32x32 48x48"><link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-mado-32.png?v=7b36ba340846"><link rel="icon" type="image/png" sizes="48x48" href="/img/favicon-mado-48.png?v=7b36ba340846"><link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon-mado.png?v=7b36ba340846"><link rel="manifest" href="/admin/manifest.webmanifest"><link rel="stylesheet" href="/build/app.css"><script defer src="/build/admin.js"></script></head>
<body class="owner-app"><a class="skip-link" href="#main">Skip to content</a>
{% if admin %}<aside class="owner-sidebar"><a class="owner-brand" href="/admin"><img src="/img/logo.webp" alt="Mado African Braidz" width="52" height="52"><span>Mado <small>Owner studio</small></span></a><nav aria-label="Owner navigation">{% for url, label in [['/admin','Overview'],['/admin/calendar','Calendar'],['/admin/bookings','Appointments'],['/admin/payment-reviews','Payment reviews'],['/admin/styles','Styles & prices'],['/admin/addons','Extras'],['/admin/availability','Availability'],['/admin/gallery','Photos & Our Work'],['/admin/clients','Clients'],['/admin/settings','Settings'],['/admin/notifications','Notifications']] %}<a href="{{ url }}" {% if (url == '/admin' and currentPath == '/') or (url != '/admin' and currentPath and currentPath.indexOf(url.slice(6)) == 0) %}aria-current="page"{% endif %}>{{ adminIcon(url) }}<span>{{ label }}</span></a>{% endfor %}</nav><div class="owner-sidebar-end"><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="{{ csrfToken }}"><button type="submit">{{ adminIcon("logout") }}<span>Sign out</span></button></form></div></aside>{% endif %}
{% if admin %}<header class="owner-notifications-header"><div class="owner-notification-menu"><button type="button" class="owner-notification-bell" data-notification-bell aria-label="Notifications" aria-expanded="false" aria-controls="owner-notification-dropdown"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span class="owner-notification-count" data-notification-count hidden></span></button><section id="owner-notification-dropdown" class="owner-notification-dropdown" data-notification-dropdown aria-label="Recent notifications" hidden><div class="owner-notification-dropdown-head"><strong>Notifications</strong><span>Latest updates</span></div><div data-notification-preview class="owner-notification-preview-list">Loading notifications...</div><a class="owner-notification-view-all" href="/admin/notifications">View all notifications</a></section></div></header>{% endif %}
<main id="main" class="owner-main {% if not admin %}owner-signed-out{% endif %}"><div class="owner-alert" role="alert" hidden></div>{% block content %}{% endblock %}</main>
<dialog id="owner-dialog" class="owner-dialog"><form method="dialog"><h2>Move this appointment?</h2><p data-move-summary></p><label class="owner-check"><input type="checkbox" data-move-notify checked>Queue an update for the client</label><p class="owner-muted">The new time must fit opening hours and the studio’s three-client capacity.</p><div class="owner-actions"><button class="button" value="save">Save new time</button><button class="button outline" value="cancel">Keep original time</button></div></form></dialog>
<dialog id="owner-confirm-dialog" class="owner-dialog owner-confirm-dialog" aria-labelledby="owner-confirm-title" aria-describedby="owner-confirm-detail"><form method="dialog"><p class="eyebrow">Please confirm</p><h2 id="owner-confirm-title">Confirm action</h2><p id="owner-confirm-detail"></p><div class="owner-actions"><button type="submit" class="button outline" value="cancel" autofocus>Cancel</button><button type="submit" class="button owner-danger-button" value="confirm" data-confirm-submit>Continue</button></div></form></dialog>
</body></html>
